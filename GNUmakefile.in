## SHELL ##

SHELL=@SHELL@

## VERSIONS ##

LIBRARY_VERSION = 0
LIBRARY_REVISION = 0
PACKAGE_VERSION = @PACKAGE_VERSION@
PACKAGE_TARNAME = @PACKAGE_TARNAME@

## PROGRAMS ##

CC = @CC@
LIBTOOL = @LIBTOOL@
INSTALL = @INSTALL@
INSTALL_DATA = @INSTALL_DATA@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_SCRIPT = @INSTALL_SCRIPT@
MAKEINFO = makeinfo

## PATHS ##

top_builddir = .
prefix = @prefix@
exec_prefix = @exec_prefix@
libdir = @libdir@

datarootdir = @datarootdir@
schemedir = @datarootdir@/guile/site
bindir = @bindir@

docdir = @docdir@
infodir = @infodir@
htmldir = @htmldir@
dvidir = @dvidir@
pdfdir = @pdfdir@
psdir = @psdir@

vpath %.c src
vpath %.texi doc
vpath %.info doc

## FLAGS AND DEFINES ##

CFLAGS = @CFLAGS@ -Wall -Wextra
CPPFLAGS = -I. @CPPFLAGS@ @GUILE_CFLAGS@
LIBS = @LDFLAGS@ @GUILE_LDFLAGS@ -lncurses
LDFLAGS = \
	-version-info $(LIBRARY_VERSION):$(LIBRARY_REVISION) -rpath $(libdir)
	#-module -no-undefined \

LIBTOOL = @LIBTOOL@

## SOURCES ##

SRC = function.c special.c constant.c type.c raw.c

OBJ = $(patsubst %.c, %.lo, $(SRC))

MANIFEST = configure configure.ac GNUmakefile.in aclocal.m4 config.h.in \
	src/function.c src/function.h src/constant.c src/constant.h \
	src/special.c src/special.h src/type.c src/type.h \
	src/raw.c \
	src/raw.scm src/core.scm \
	wrap/func_def.awk wrap/func_init.awk wrap/func_head.awk \
	wrap/func_scm.awk wrap/function.txt \
	wrap/const_def.awk wrap/const_init.awk wrap/const_head.awk \
	wrap/const_scm.awk wrap/constant.txt \
	wrap/special.txt wrap/wrap.sh \
	build_aux/config.guess build_aux/config.sub build_aux/install-sh \
	build_aux/ltmain.sh

# 	doc/gucu.texi doc/texinfo.tex

## TARGETS ##
.SUFFIXES :
.PHONY : all install

all: libguile-gucu.la

libguile-gucu.la : $(OBJ)
	$(LIBTOOL) --mode=link $(CC) $(LDFLAGS) $(CFLAGS) -o $@ $^ $(LIBS)

%.lo : %.c
	$(LIBTOOL) --mode=compile $(CC) $(CPPFLAGS) $(CFLAGS) -c $< 

install : all
	$(LIBTOOL) --mode=install $(INSTALL_DATA) libguile-gucu.la $(libdir)/libguile-gucu.la
	mkdir -p $(schemedir)/gucu
	$(INSTALL_DATA) src/raw.scm $(schemedir)/gucu/raw.scm
	$(INSTALL_DATA) src/core.scm $(schemedir)/gucu/core.scm
	#-$(INSTALL_DATA) doc/gucu.info $(infodir)/gucu.info

install-html : html
	$(INSTALL_DATA) doc/gucu.html $(htmldir)/gucu.html

install-dvi : dvi
	$(INSTALL_DATA) doc/gucu.dvi $(dvidir)/gucu.dvi

install-pdf : pdf
	$(INSTALL_DATA) doc/gucu.pdf $(pdfdir)/gucu.pdf

install-ps : ps
	$(INSTALL_DATA) doc/gucu.ps $(psdir)/gucu.ps

uninstall:
	-$(LIBTOOL) --mode=uninstall rm $(libdir)/libguile-gucu.la
	-rm $(schemedir)/raw.scm
	-rm $(schemedir)/core.scm
	-rm $(infodir)/gucu.info
	-rm $(htmldir)/gucu.html
	-rm $(dvidir)/gucu.dvi
	-rm $(pdfdir)/gucu.pdf
	-rm $(psdir)/gucu.ps

install-strip:
	$(LIBTOOL) --mode=install $(INSTALL_DATA) -s libguile-gucu.la $(libdir)/libguile-gucu.la
	mkdir -p $(schemedir)/gucu
	$(INSTALL_DATA) src/raw.scm $(schemedir)/gucu/raw.scm
	$(INSTALL_DATA) doc/gucu.info $(infodir)/gucu.info

clean:
	$(LIBTOOL) --mode=clean rm libguile-gucu.la *.lo
	rm doc/*.dvi doc/*.pdf doc/*.ps doc/*.html doc/*.info

distclean :  clean
	rm TAGS GNUmakefile config.status config.log

mostlyclean : distclean

maintainer-clean : distclean
	rm configure wrap/*.[ch] wrap/*.scm
	rm src/function.[ch] src/constant.[ch]

TAGS:
	etags $(SRC) src/gucu.scm

info : gucu.info

gucu.info : gucu.texi
	$(MAKEINFO) --force $^ -o $(patsubst %.texi, %.info, $^)

html : gucu.html

gucu.html : gucu.texi
	$(MAKEINFO) --html --force $^ -o $(patsubst %.texi, %.html, $^)

dvi : gucu.dvi

gucu.dvi : gucu.texi
	texi2dvi gucu.texi -o $(patsubst %.texi, %.html, $^)

pdf: gucu.pdf
	texi2dvi gucu.texi --pdf -o $(patsubst %.texi, %.pdf, $^)

ps : dvi
	dvips gucu.texi -o $(patsubst %.texi, %.ps, $^)

dist:
	tar --create --verbose --file=$(PACKAGE_TARNAME)-$(PACKAGE_VERSION).tar --transform 's,^,$(PACKAGE_TARNAME)-$(PACKAGE_VERSION)/,' $(MANIFEST)
	gzip $(PACKAGE_TARNAME)-$(PACKAGE_VERSION).tar

check:

