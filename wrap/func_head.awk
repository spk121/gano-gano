#!awk -f
BEGIN {
  FS = "[\(\),;]";
  prefix = "gucu";

  print "// This file was autogenerated by func_head.awk";
}
{
  # First, split the return type and function name in $1 into component parts
  # the pointer form
  where = match($1, /([_a-zA-Z0-9]* \*)([_a-zA-Z0-9]*)/, arr);
  if (where == 0) 
    # the non-pointer form
    where = match($1, /([_a-zA-Z0-9]*) ([_a-zA-Z0-9]*)/, arr);


  return_type = arr[1];
  c_function_name = arr[2];
  n_args = NF-3;
  
  if(n_args == 1 && $(2) ~ "void")
    void_flag = 1;
  else
    void_flag = 0;

  printf "SCM %s_%s (", prefix, c_function_name;
  if (void_flag)
    printf "void";
  else {
    for(i=1; i<=n_args-1; i++) {
      printf "SCM arg%d, ", i;
    }
    printf "SCM arg%d", n_args;
  }
  printf ") API";
  printf ";\n"
}
END {
}

    
