(use-modules (ice-9 getopt-long)
             (ice-9 rdelim)
             (oop goops)
             (gano CBuffer))

(define *cbuf* #f)
(define *interactive* #f)

(define-method (describe-buf (buf <CBuffer>))
  (format #t "Position: Line ~a, Pos ~a ~%"
          (get-line-cur buf) (get-pd-cur buf)))

(define-method (write-buf (cbuf <CBuffer>))
  (let loop ((i 1) (lst (get-text cbuf)))
    (unless (null? lst)
      (format #t "~a  |~a| " i (car lst))
      (newline)
      (loop (1+ i) (cdr lst)))))

(define (main args)
  (let* ((option-spec '((prompt (single-char #\p) (value #t))
                        (verbose (single-char #\v) (value #f))))
         (options (getopt-long args option-spec))
         (argv (option-ref options '() '())))

    ;; If one of the remaining arguments is a sole hyphen,
    ;; some versions of ed make this scripted mode.

    ;; Determine if we're interactive.
    ;; isatty  | file-port?  |
    ;; yes     | yes         | interactive
    ;; no      | yes         | input is piped into
    ;; no      | no          | probably running under repl
    (set! *interactive* (or (and (isatty? (current-input-port))
                                 (file-port? (current-input-port)))
                            (and (not (isatty? (current-input-port)))
                                 (not (file-port? (current-input-port))))))

    (when *interactive*
      (format #t "Enter lines of text.  When done entering text,~%")
      (format #t "type <Ctrl-D> <Enter>.  The text you typed will be~%")
      (format #t "returned.~%"))

    (when (file-port? (current-input-port))
      (setvbuf (current-input-port) 'line))

    (sigaction SIGHUP signal-hup)
    (sigaction SIGQUIT SIG_IGN)
    (sigaction SIGINT signal-int)

    (let ((cbuf (make-empty-cbuffer))
          (prompt (option-ref options 'prompt ""))
          (verbose (option-ref options 'verbose #f)))
      (set! *cbuf* cbuf)
      (display prompt)
      (let loop ((line (read-line)))
        (if (not (eof-object? line))

            ;; Read and insert a line
            (begin
	      (append-line! cbuf line)
	      (when verbose
		(describe-buf cbuf))
	      (display prompt)
              (loop (read-line)))

            ;; Else, output and quit
            (begin
              (newline)
              (write-buf cbuf))))))
  0)

(define (handle-hup signo)
  (and=> *cbuf* write-buf)
  (primitive-_exit 2))

(define (signal-int signo)
  (handle-hup signo))

(define (signal-hup signo)
  (handle-hup signo))
