  (#x2B56 . #x2B59) (#x3248 . #x324F) (#xE000 . #xF8FF) (#xFFFD . #xFFFD)
  (#x1F100 . #x1F10A) (#x1F110 . #x1F12D) (#x1F130 . #x1F169)
  (#x1F170 . #x1F18D) (#x1F18F . #x1F190) (#x1F19B . #x1F1AC)
  (#xF0000 . #xFFFFD) (#x100000 . #x10FFFD)))

