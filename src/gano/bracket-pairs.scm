(define (bracket-partner char)
  "Return the matching bracket for CHAR.
   If CHAR is an opening bracket, return its closing bracket.
   If CHAR is a closing bracket, return its opening bracket.
   If CHAR is not a bracket, return #f."
  (assq-ref bracket-mapping char))
