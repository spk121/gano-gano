
;; -*- Mode: scheme; -*-
(define-module (XXpackageXX curses-wide)
  #:use-module (ice-9 optargs)
  #:use-module (gucu curses)
  #:export ( 
	    WEOF
	    add-wch
	    add-wchstr
	    addwstr
	    bkgrnd
	    bkgrndset
	    border-set
	    box-set
	    echo-wchar
	    erasewchar
	    getbkgrnd
	    get-wch
	    getn-wstr
	    hline-set
	    in-wch
	    in-wchnstr
	    ins-nwstr
	    ins-wch
	    ins-wstr
	    inwstr
	    killwchar
	    mvadd-wch
	    mvget-wch
	    mvgetn-wstr
	    mvin-wch
	    mvin-wchnstr
	    mvinnwstr
	    mvins-nwstr
	    mvins-wch
	    mvins-wstr
	    mvinwstr
	    mvwadd-wch
	    mvwget-wch
	    mvwgetn-wstr
	    mvwin-wch
	    mvwin-wchnstr
	    mvwins-nwstr
	    mvwins-wch
	    mvwins-wstr
	    mvwinwstr
	    term-attrs
	    unget-wch
	    vline-set
	    wacs-block
	    wacs-board
	    wacs-btee
	    wacs-bullet
	    wacs-ckboard
	    wacs-darrow
	    wacs-degree
	    wacs-diamond
	    wacs-hline
	    wacs-lantern
	    wacs-larrow
	    wacs-llcorner
	    wacs-lrcorner
	    wacs-ltee
	    wacs-plminus
	    wacs-plus
	    wacs-rarrow
	    wacs-rtee
	    wacs-s1
	    wacs-s9
	    wacs-ttee
	    wacs-uarrow
	    wacs-ulcorner
	    wacs-urcorner
	    wacs-vline
	    wget-wch
	    wgetn-wstr
	    win-wch
	    win-wchnstr
	    wins-nwstr
	    wins-wch
	    wins-wstr
))

(define* (add-wch ch #:key (win (stdscr)) x y)
  (and (if (and x y)
	   (wmove win y x)
	   #t)
       (%wadd-wch win ch)))

(define* (add-wchstr wchstr #:key (win (stdscr)) x y (n -1))
  (and (if (and x y)
	   (wmove win y x)
	   #t)
       (%wadd-wchnstr win wchstr n)))

(define* (addwstr win wstr #:key x y (n -1))
  (and (if (and x y)
	   (%wmove win y x)
	   #t)
       (%waddnwstr win wstr n)))

(define* (bkgrnd wch #:key (win (stdscr)))
  (%wbkgrnd win wch))

(define* (bkgrndset wch #:key (win (stdscr)))
  (%wbkgrndset win wch))

(define* (border-set left right top bottom tl tr bl br #:key (win (stdscr)))
  (%wborder-set win left right top bottom tl tr bl br))

(define* (box-set #:v h key (win (stdscr)))
  (%wborder-set win v v h h 0 0 0 0))

(define* (echo-wchar ch #:key (win (stdscr)))
  (%wecho-wchar win ch))

(define* (getbkgrnd #:key win)
  (%wgetbkgrnd win))

(define* (hline-set ch n #:key (win (stdscr) y x))
  (and (if (and y x)
	   (wmove win y x)
	   #t)
       (%whline-set win ch n)))

(define* (vline-set ch n #:key (win (stdscr) y x))
  (and (if (and y x)
	   (wmove win y x)
	   #t)
       (%wvline-set win ch n)))


(load-extension "XXlibnameXX" "gucu_cursw_init")
