(define* (add-wch ch #:key (win (stdscr)) x y)
  (and (if (and x y)
	   (wmove win y x)
	   #t)
       (%wadd-wch win ch)))

(define* (echo-wchar ch #:key (win (stdscr)))
  (%wecho-wchar win ch))

(load-extension "XXlibnameXX" "gucu_cursw_init")
