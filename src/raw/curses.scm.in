;; These functions may not exist depending on the 
;; compile time options
(if (defined? 'netwerm)
    (export newterm))


;; Scheme calling wrappers for C functions

(define* (addch win ch #:key y x)
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%waddch win ch)))

(define* (addchstr win chstr #:key y x (n -1))
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%waddchnstr win chstr n)))

(define* (addstr win str #:key y x (n -1))
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%waddnstr win str n)))

(define (attr-get win)
  (let* ((ac (%wattr-get win))
	 (attr (car ac))
	 (color (cadr ac)))
    (list
     (logand attr (logior A_STANDOUT
			  A_UNDERLINE
			  A_REVERSE
			  A_BLINK
			  A_DIM
			  A_BOLD
			  A_ALTCHARSET
			  A_INVIS
			  A_PROTECT
			  WA_HORIZONTAL
			  WA_LEFT
			  WA_LOW
			  WA_RIGHT
			  WA_TOP
			  WA_VERTICAL))
     color)))

(define (attr-off win attr)
  (%wattr-off win attr))
	
(define (attr-on win attr)
  (%wattr-on win attr))

(define* (attr-set win attr #:key (color 0))
  (%wattr-set win attr color))

(define (bkgd win ch)
  (%wbkgd win ch))

(define (bkgdset win ch)
  (%wbkgdset win ch))

(define (border win left right top bottom tl tr bl br)
  (%wborder win left right top bottom tl tr bl br))

(define (box win v h)
  (%wborder win v v h h 0 0 0 0))

(define* (chgat win n attr color #:key y x)
  (and
   (if (and y x)
       (%wmove win y x)
       #t)
   (%wchgat win n attr color)))

(define (clear win)
  (%wclear win))

(define (clrtobot win)
  (%wclrtobot win))

(define (clrtoeol win)
  (%wclrtoeol win))

(define (color-set win pair)
  (%wcolor-set win pair))

(define* (delch win #:key y x)
  (and
   (if (and y x)
       (%wmove win y x)
       #t)
   (%wdelch win)))

(define* (deleteln win #:key y x)
  (and
   (if (and y x)
       (%wmove win y x)
       #t)
   (%winsdelln win -1)))

(define (echochar win ch)
  (%wechochar win ch))

(define (erase win)
  (%werase win))

(define (getbkgd win)
  (%getbkgd win))

(define* (getch win #:key y x)
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%wgetch win)))
  
(define* (hline win ch n #:key y x)
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%whline win ch n)))

(define* (inch win #:key y x)
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%winch win)))

(define* (inchstr win #:key y x (n -1))
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%winchnstr win n)))

(define* (insch win ch #:key y x)
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%winsch win ch)))

(define* (instr win #:key y x (n -1))
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%winnstr win n)))

(define* (insdelln win n #:key y x)
  (and
   (if (and y x)
       (%wmove win y x)
       #t)
   (%winsdelln win n)))

(define* (insertln win #:key y x)
  (and
   (if (and y x)
       (%wmove win y x)
       #t)
   (%winsdelln win 1)))

(define* (insstr win str #:key y x (n -1))
  (and
   (if (and y x)
       (%wmove win y x)
       #t))
  (%winsnstr win str n))

;; The window information isn't used in the lower level function, so
;; it is dropped here
(define (intrflush flag)
  (%intrflush (stdscr) flag))

(define (keypad win bf)
  (%keypad win bf))

;; The window information isn't used in the lower level function, so
;; it is dropped here.
(define (meta bf)
  (%meta (stdscr) bf))

(define (move win y x)
  (%wmove win y x))

(define (nodelay win flag)
  (%nodelay win flag))

(define (nooutrefresh win)
  (%wnoutrefresh win))

(define (notimeout win flag)
  (%notimeout win flag))

(define (redrawln win beg_line end_line)
  (%wredrawln win beg_line end_line))
  
(define (refresh win)
  (%wrefresh win))

(define (scroll win)
  (%wscrl win 1))

(define (scrl win n)
  (%wscrl win n))

(define (setscrreg win top bot)
  (%wsetscrreg win top bot))

(define (standend win)
  (%wstandend win))

(define (standout win)
  (%wstandout win))

(define (timeout win bf)
  (%wtimeout win bf))

(define (touchwin win)
  (%wtouchln win 0 (getmaxy win) #t))

(define (untouchwin win)
  (%wtouchln win 0 (getmaxy win) #f))

(define* (touchline win start #:optional (count 1))
  (%wtouchln win start count #t))

(define* (untouchline win start #:optional (count 1))
  (%wtouchln win start count #f))

(define (typeahead port-or-fd)
  (cond 
   ((port? port-or-fd) (%typeahead (fileno port-or-fd)))
   (else (%typeahead port-or-fd))))

(define* (vline win ch n #:key y x)
  (and (if (and y x)
	   (%wmove win y x)
	   #t)
       (%wvline win ch n)))


		

(load-extension "XXlibnameXX" "gucu_init")
