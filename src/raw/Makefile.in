### CURSES ###
libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_CPPFLAGS =  \
	$(COMPILE_FLAGS) $(am__append_1)
libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_LDFLAGS = \
	-no-undefined \
	-export-dynamic \
	-version-info @LIBGUILE_GUCU_CURSES_INTERFACE@

libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_SOURCES =  \
	curs_const.c curs_const.h curs_func.c curs_func.h type.c \
	type.h curs_spec.c curs_spec.h curs_main.c menu_const.c \
	menu_const.h menu_func.c menu_func.h menu_type.c menu_type.h \
	menu_spec.c menu_spec.h menu_main.c panel_func.c panel_func.h \
	panel_type.c panel_type.h panel_spec.c panel_spec.h \
	panel_main.c form_const.c form_const.h form_func.c form_func.h \
	form_type.c form_type.h form_spec.c form_spec.h form_main.c \
	eti_const.c eti_const.h eti_main.c $(am__append_2)

# -lguile added to LIBS by autoconf in the AC_CHECK_LIB test
libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_LIBADD = \
	@LIBMENU@ @LIBPANEL@ @LIBFORM@ @LIBNCURSES@ 


######
guile_sitedir = ${datadir}/guile/site
pkgguile_sitedir = $(guile_sitedir)/$(PACKAGE)
pkgguile_site_DATA = curses.scm curses-alt.scm menu.scm panel.scm \
	form.scm eti.scm $(am__append_3)
ETAGS_ARGS = curses.scm curses-alt.scm menu.scm panel.scm form.scm \
	eti.scm $(am__append_4)

# Note that the "wide" .scm.in file needs to appear in EXTRA_DIST.  It
# is part of the distribution regardless of whether it is used.
EXTRA_DIST = \
	curses.scm.in curses-wide.scm.in \
	menu.scm.in panel.scm.in form.scm.in eti.scm.in \
	curses-alt.scm curses-wide-alt.scm

BUILT_SOURCES = curses.scm menu.scm panel.scm form.scm eti.scm \
	$(am__append_5)
CLEANFILES = curses.scm menu.scm panel.scm form.scm eti.scm \
	$(am__append_6)
all: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu  src/raw/Makefile'; \
	cd $(top_srcdir) && \
	  $(AUTOMAKE) --gnu  src/raw/Makefile
.PRECIOUS: Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
install-libLTLIBRARIES: $(lib_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	test -z "$(libdir)" || $(MKDIR_P) "$(DESTDIR)$(libdir)"
	@list='$(lib_LTLIBRARIES)'; for p in $$list; do \
	  if test -f $$p; then \
	    f=$(am__strip_dir) \
	    echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(libLTLIBRARIES_INSTALL) $(INSTALL_STRIP_FLAG) '$$p' '$(DESTDIR)$(libdir)/$$f'"; \
	    $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(libLTLIBRARIES_INSTALL) $(INSTALL_STRIP_FLAG) "$$p" "$(DESTDIR)$(libdir)/$$f"; \
	  else :; fi; \
	done

uninstall-libLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(lib_LTLIBRARIES)'; for p in $$list; do \
	  p=$(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(libdir)/$$p'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(libdir)/$$p"; \
	done

clean-libLTLIBRARIES:
	-test -z "$(lib_LTLIBRARIES)" || rm -f $(lib_LTLIBRARIES)
	@list='$(lib_LTLIBRARIES)'; for p in $$list; do \
	  dir="`echo $$p | sed -e 's|/[^/]*$$||'`"; \
	  test "$$dir" != "$$p" || dir=.; \
	  echo "rm -f \"$${dir}/so_locations\""; \
	  rm -f "$${dir}/so_locations"; \
	done
libguile-gucu-curses-v-@LIBGUILE_GUCU_CURSES_MAJOR@.la: $(libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_OBJECTS) $(libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_DEPENDENCIES) 
	$(libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_LINK) -rpath $(libdir) $(libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_OBJECTS) $(libguile_gucu_curses_v_@LIBGUILE_GUCU_CURSES_MAJOR@_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

