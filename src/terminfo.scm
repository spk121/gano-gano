(define *terminfo*
  (fold
   (lambda (term termlist)
     (setupterm term)
     (assoc-set! termlist term
		 (fold
		  (lambda (cap caplist)
		    (if (tiget cap)
			(assoc-set! caplist cap (tiget cap))
			caplist))
		  '()
		  *capabilities*)))
   '()
   *terminals*))
	       
(format #t ";;; Terminfo database\n")
(format #t ";;; This file is autogenerated.  Do not edit.\n")
(newline)
(newline)
(pretty-print *terminfo*)
(newline)
