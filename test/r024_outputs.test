;;;; -*- Mode: scheme; -*-
;;;; r024_outopts.test --- test suite for curses's output options

(use-modules (test lib)
	     (test lib2)
	     ;; (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(define (mvaddstr y x s)
  (addstr s #:y y #:x x))
(define (mvwaddstr w y x s)
  (addstr s #:win w #:y y #:x x))
 
(initscr)

;; Should be able to move the cursor
(with-test-prefix "outopts"
		  
		  (pass-if "setscrreg #t"
			   (begin
			     (clear)
			     (setscrreg 0 3)
			     (scrollok (stdscr) #t)
			     (mvaddstr 0 0 "aaa\n")
			     (addstr "bbb\n")
			     (addstr "ccc\n")
			     (addstr "ddd\n")
			     (addstr "eee\n")
			     (refresh)
			     (let ((x1 (mvinnstr 0 0 3))
				   (x2 (mvinnstr 1 0 3))
				   (x3 (mvinnstr 2 0 3)))
			       (and
				(string=? x1 "ccc")
				(string=? x2 "ddd")
				(string=? x3 "eee")))))
		  
		  (pass-if "setscrreg #f"
			   (begin
			     (clear)
			     (setscrreg 0 3)
			     (scrollok (stdscr) #f)
			     (mvaddstr 0 0 "aaa\n")
			     (addstr "bbb\n")
			     (addstr "ccc\n")
			     (addstr "ddd\n")
			     (addstr "eee\n")
			     (refresh)
			     (let ((x1 (mvinnstr 0 0 3))
				   (x2 (mvinnstr 1 0 3))
				   (x3 (mvinnstr 2 0 3)))
			       (and
				(string=? x1 "aaa")
				(string=? x2 "bbb")
				(string=? x3 "ccc"))))))

(setscrreg 0 (- (lines) 1))


(endwin)

(curses-test-end test "r024_outputs.out")		  
