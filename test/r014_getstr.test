;;;; -*- Mode: scheme; -*-
;;;; r014_getstr.test --- test suite for curses's getstr

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(initscr)

(define win (newwin 5 10 5 5))
(define letter-h (char->integer #\h))
(define letter-i (char->integer #\i))
(define letter-p (char->integer #\p))
(define newline (char->integer #\nl))
(standend)
(attron (logior (color-pair 0) A_NORMAL))

;; Should be able to get strings from the keyboard

(with-test-prefix "getstr"
		  
		  (pass-if "getstr"
			   (begin
			     (erase)
			     (refresh)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (getnstr 10)))
			       (begin
				 (refresh)
				 (string=? s1 "hip")))))

		  (pass-if "getnstr"
			   (begin
			     (erase)
			     (refresh)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (getnstr 2)))
			       (begin
				 (refresh)
				 (string=? s1 "hi")))))


		  (pass-if "mvgetstr"
			   (begin
			     (erase)
			     (refresh)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (mvgetnstr 1 1 10)))
			       (begin
				 (refresh)
				 (string=? s1 "hip")))))

		  (pass-if "mvgetnstr"
			   (begin
			     (erase)
			     (refresh)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (mvgetnstr 1 1 2)))
			       (begin
				 (refresh)
				 (string=? s1 "hi"))))))


(with-test-prefix "wgetstr"
		  
		  (pass-if "wgetstr"
			   (begin
			     (werase win)
			     (wrefresh win)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (wgetnstr win 10)))
			       (begin
				 (wrefresh win)
				 (string=? s1 "hip")))))

		  (pass-if "getnstr"
			   (begin
			     (werase win)
			     (wrefresh win)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (wgetnstr win 2)))
			       (begin
				 (wrefresh win)
				 (string=? s1 "hi")))))


		  (pass-if "mvgetstr"
			   (begin
			     (werase win)
			     (wrefresh win)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (mvwgetnstr win 1 1 10)))
			       (begin
				 (wrefresh win)
				 (string=? s1 "hip")))))

		  (pass-if "mvgetnstr"
			   (begin
			     (werase win)
			     (wrefresh win)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (mvwgetnstr win 1 1 2)))
			       (begin
				 (wrefresh win)
				 (string=? s1 "hi"))))))

(endwin)

(curses-test-end test "r014_getstr.out")

