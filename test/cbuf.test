(test-begin "CUP")
(test-begin "ASCII")

(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 1)
(cbuf-set-positions! buf 4 'data)

(test-begin "cursor position to line 2 col 3")
(cbuf-cursor-position buf 2 3)
(test-equal "line cur" 2 (cbuf-get-line-cur buf))
(test-equal "data position" 3 (cbuf-get-pd-cur buf))
(test-equal "presentation-position" 3 (cbuf-get-pp-cur buf))
