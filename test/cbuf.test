(cbuf-set-mark-flag! buf #t)
(cbuf-set-y-mark! buf 1)
(cbuf-set-x-mark! buf 1)
(cbuf-erase-character buf 'presentation 1 #t #t)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" "老婆は、一目下人を見ると、まるで弩（いしゆみ）" (first (cbuf-get-text buf)))
(test-equal "second line" "  でも弾かれたように　飛び上がっ　た。" (second (cbuf-get-text buf)))
