;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CUP

(test-begin "cbuf-cursor-position")
(test-begin "ASCII")

(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 3)
(cbuf-set-x! buf 1 'data)

(test-begin "cursor moved within range")
(cbuf-cursor-position buf 2 1)
(test-equal "y" 2 (cbuf-get-y buf))
(test-equal "x-data" 1 (cbuf-get-x-data buf))
(test-equal "x-cell" 1 (cbuf-get-x-cell buf))
(test-equal "x-goal" 1 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "as I pondered")
(test-end "cursor moved within range")

(test-begin "cursor moved too wide")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 3)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-line? err) #t)
                     (else #f))
                    (cbuf-cursor-position buf 1 40)))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" (string-base-length "a midnight-dreary") (cbuf-get-x-data buf))
(test-equal "x-cell" (string-base-length "a midnight-dreary") (cbuf-get-x-cell buf))
(test-equal "x-goal"  40 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "a midnight dreary")
(test-end "cursor moved too wide")

(test-begin "cursor moved too long")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 3)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-buffer? err) #t)
                     (else #f))
                    (cbuf-cursor-position buf 40 2)))
(test-equal "y" (+ -1 (length (cbuf-get-text buf))) (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal" 2 (cbuf-get-x-goal buf))
(test-equal "current line" (last (cbuf-get-text buf)) (cbuf-get-text-cur buf))
(test-end "cursor moved too long")

(test-begin "cursor moved too long and too wide")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 3)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-buffer? err) #t)
                     (else #f))
                    (cbuf-cursor-position buf 40 40)))
(test-equal "y" (+ -1 (length (cbuf-get-text buf))) (cbuf-get-y buf))
(test-equal "x-data" (string-base-length (last (cbuf-get-text buf)))
            (cbuf-get-x-data buf))
(test-equal "x-cell" (string-base-length (last (cbuf-get-text buf))) (cbuf-get-x-cell buf))
(test-equal "x-goal" 40 (cbuf-get-x-goal buf))
(test-equal "current line" (last (cbuf-get-text buf)) (cbuf-get-text-cur buf))
(test-end "cursor moved too long and too wide")

(test-end "ASCII")
(test-end "CUP")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DA

(test-begin "cbuf-device-attributes")
(test-assert (string? (cbuf-device-attributes buf)))
(test-end "cbuf-device-attributes")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DCH

(test-begin "cbuf-delete-character")

(test-begin "delete chars from BOB")
(init-buf! buf (list "老婆は、一目下人を見ると、まるで弩（いしゆみ）"
                     "にでも弾かれたように　飛び上がっ　た。"
                     "「おのれ、どこへ行く。」"))
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 0 'data)
(cbuf-set-mark-flag! buf #t)
(cbuf-set-y-mark! buf 0)
(cbuf-set-x-mark! buf 0)
(cbuf-delete-character buf 4 'data #t #t)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" "一目下人を見ると、まるで弩（いしゆみ）" (first (cbuf-get-text buf)))
(test-equal "second line" "にでも弾かれたように　飛び上がっ　た。" (second (cbuf-get-text buf)))
(test-equal "cut buffer" (list "老婆は、")
            (cbuf-get-cut-buffer buf))
(test-equal "mark" #t (cbuf-is-mark-set? buf))
(test-equal "x-mark" 1 (cbuf-get-x-mark buf))
(test-equal "y-mark" 0 (cbuf-get-y-mark buf))
(test-end "delete chars from BOB")

(define text-ascii-long
  '("\tPreserve me, O God: for in thee do I put my trust."
    "\tO my soul, thou has said unto the LORD, Thou art my Lord: my goodness"
    "extendeth not to thee;"
    "\tBut to the saints that are in the earth, and to the excellent, in whom"
    "is all my delight."
    "\tTheir sorrows shall be multiplied that hasten after another god: their"
    "drink offerings of blood will I not offer, nor take up their names"
    "into my lips."
    "\tThe LORD is the portion of mine inheritance and of my cup: thou"
    "maintainest my lot."
    "\tThe lines are fallen unto me in pleasant places; yea, I have a goodly"
    "heritage."
    "\tI will bless the LORD, who hath given me counsel: my reins also"
    "instruct me in the night seasons."
    "\tI have set the LORD always before me: because he is at my right hand,"
    "I shall not be moved."
    "\tTherefore my heart is glad, and my glory rejoiceth: my flesh also"
    "shall rest in hope."
    "\tFor thou wilt not leave my soul in hell; neither wilt thou suffer"
    "thine Holy One to see corruption."
    "\tThou wilt shew me the path of life: in thy presence is fulness of joy;"
    "at thy right hand there are pleasures for evermore."))


(test-begin "delete chars from center of buffer")
(init-buf! buf text-ascii-long)
(cbuf-set-y! buf 6)
(cbuf-set-x! buf 10 'data)
(cbuf-set-mark-flag! buf #t)
(cbuf-set-y-mark! buf 6)
(cbuf-set-x-mark! buf 20)
(cbuf-delete-character buf 5 'data #t #t)
(test-equal "y" 6 (cbuf-get-y buf))
(test-equal "x-data" 10 (cbuf-get-x-data buf))
(test-equal "x-cell" 10 (cbuf-get-x-cell buf))
(test-equal "x-goal" 10 (cbuf-get-x-goal buf))
(test-equal "first line" "\tPreserve me, O God: for in thee do I put my trust."
            (first (cbuf-get-text buf)))
;;                         "drink offerings of blood will I not offer, nor take up their names"
(test-equal "current line" "drink offe of blood will I not offer, nor take up their names"
            (cbuf-get-text-cur buf))
(test-equal "cut buffer" (list "rings") (cbuf-get-cut-buffer buf))
(test-equal "mark" #t (cbuf-is-mark-set? buf))
(test-equal "y mark" 6 (cbuf-get-y-mark buf))
(test-equal "x mark" 15 (cbuf-get-y-mark buf))
(test-end "delete chars from center of buffer")

(test-begin "delete all chars")
(init-buf! buf text-ascii-long)
(cbuf-set-y! buf 6)
(cbuf-set-x! buf 0 'data)
(cbuf-set-mark-flag! buf #t)
(cbuf-set-y-mark! buf 6)
(cbuf-set-x-mark! buf 20)
(cbuf-delete-character
 buf (string-length "drink offerings of blood will I not offer, nor take up their names")
 'data #t #t)
(test-equal "y" 6 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" "\tPreserve me, O God: for in thee do I put my trust."
            (first (cbuf-get-text buf)))
;;                         "drink offerings of blood will I not offer, nor take up their names"
(test-equal "current line" "" (cbuf-get-text-cur buf))
(test-equal "cut buffer" (list "drink offerings of blood will I not offer, nor take up their names") (cbuf-get-cut-buffer buf))
(test-equal "mark" #f (cbuf-is-mark-set? buf))
(test-end "delete all chars")

(test-begin "delete too many chars")
(init-buf! buf (list "老婆は、一目下人を見ると、まるで弩（いしゆみ）"
                     "にでも弾かれたように　飛び上がっ　た。"
                     "「おのれ、どこへ行く。」"))
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 4 'data)
(cbuf-set-mark-flag! buf #t)
(cbuf-set-y-mark! buf 0)
(cbuf-set-x-mark! buf 5)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-buffer? err) #t)
                     (else #f))
                    (cbuf-delete-character buf 1000 'data #t #t)))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 4 (cbuf-get-x-data buf))
(test-equal "x-cell" 8 (cbuf-get-x-cell buf))
(test-equal "x-goal" 8 (cbuf-get-x-goal buf))
(test-equal "first line" "老婆は、" (first (cbuf-get-text buf)))
(test-equal "cut buffer" (list "一目下人を見ると、まるで弩（いしゆみ）") (cbuf-get-cut-buffer buf))
(test-equal "mark" #f (cbuf-is-mark-set? buf))
(test-end "delete too many chars")

(test-end "cbuf-delete-character")



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
