;;; -*- mode: scheme -*-
;;; cbuf.test - test-script for Gano's character cell buffer

(define buf (cbuf-make-buffer))

(define (init-buf! buf str)
  (cbuf-set-text! buf (if (list? str) str (list str)))
  ;; (set-line-frame! buf 0)
  (cbuf-set-line-cur! buf 0)
  (cbuf-set-tab-size! buf 8)
  (cbuf-update-pp-list! buf)
  (cbuf-set-positions! buf 0 'data))

(define (print-pos buf)
  (format #t "Pd ~a Pp ~a Pp-Goal ~a~%"
          (cbuf-get-pd-cur buf) (cbuf-get-pp-cur buf) (cbuf-get-pp-goal buf)))


(test-begin "cbuf")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; CODEPOINT METHODS
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ICP
(test-begin "cbuf-insert-codepoint")

;; ASCII
(test-begin "(null) + 'a'")
(init-buf! buf "")
(cbuf-insert-codepoint buf #\a #f)
(test-equal "text" '("a") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 1 (cbuf-get-x-data buf))
(test-equal "x-cell" 1 (cbuf-get-x-cell buf))
(test-equal "x-goal" 1 (cbuf-get-x-goal buf))
(test-end "(null) + 'a'")

(test-begin "'b' after 'a'")
(init-buf! buf "a")
(cbuf-set-x! buf 1 'data)
(cbuf-insert-codepoint buf #\b #f)
(test-equal "text" '("ab") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal" 2 (cbuf-get-x-goal buf))
(test-end "'b' after 'a'")

(test-begin "'b' before 'a'")
(init-buf! buf "a")
(cbuf-set-x! buf 0 'data)
(cbuf-insert-codepoint buf #\b #f)
(test-equal "text" '("ba") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 1 (cbuf-get-x-data buf))
(test-equal "x-cell" 1 (cbuf-get-x-cell buf))
(test-equal "x-goal" 1 (cbuf-get-x-goal buf))
(test-end "'b' before 'a'")

;; ASCII + tab
(test-begin "'a' after tab")
(init-buf! buf "\t")
(cbuf-set-x! buf 1 'data)
(cbuf-insert-codepoint buf #\a #f)
(test-equal "text" '("\ta") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 9 (cbuf-get-x-cell buf))
(test-equal "x-goal" 9 (cbuf-get-x-goal buf))
(test-end "'a' after tab")

(test-begin "'a' before tab")
(init-buf! buf "\t")
(cbuf-set-x! buf 0 'data)
(cbuf-insert-codepoint buf #\a #f)
(test-equal "text" '("a\t") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 1 (cbuf-get-x-data buf))
(test-equal "x-cell" 1 (cbuf-get-x-cell buf))
(test-equal "x-goal" 1 (cbuf-get-x-goal buf))
(test-end "'a' before tab")

;; ASCII + zero-width space
(define str-ascii+zwbs (string #\u (integer->char #x200B) #\v))

(test-begin "zero-width space after 'a'")
(init-buf! buf "a")
(cbuf-set-x! buf 1 'data)
(cbuf-insert-codepoint buf (integer->char #x200B) #f)
(test-equal "text" '("a\u200b") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 1 (cbuf-get-x-cell buf))
(test-equal "x-goal" 1 (cbuf-get-x-goal buf))
(test-end "zero-width space after 'a'")

(test-begin "zero-width space before 'a'")
(init-buf! buf "a")
(cbuf-set-x! buf 0 'data)
(cbuf-insert-codepoint buf (integer->char #x200B) #f)
(test-equal "text" '("\u200ba") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 1 (cbuf-get-x-cell buf))
(test-equal "x-goal" 1 (cbuf-get-x-goal buf))
(test-end "zero-width space before 'a'")

;; Latin-1 and its NFD
(test-begin "NFC José")
(init-buf! buf "")
(cbuf-insert-codepoint buf #\J #f)
(cbuf-insert-codepoint buf #\o #f)
(cbuf-insert-codepoint buf #\s #f)
(cbuf-insert-codepoint buf #\é #f)
(test-equal "text" '("José") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 4 (cbuf-get-x-data buf))
(test-equal "x-cell" 4 (cbuf-get-x-cell buf))
(test-equal "x-goal" 4 (cbuf-get-x-goal buf))
(test-end "NFC José")

(test-begin "NFD José")
(init-buf! buf "")
(cbuf-insert-codepoint buf #\J #f)
(cbuf-insert-codepoint buf #\o #f)
(cbuf-insert-codepoint buf #\s #f)
(cbuf-insert-codepoint buf #\e #f)
(cbuf-insert-codepoint buf #\x0301 #f)
(test-equal "text" '("José") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 4 (cbuf-get-x-data buf))
(test-equal "x-cell" 4 (cbuf-get-x-cell buf))
(test-equal "x-goal" 4 (cbuf-get-x-goal buf))
(test-end "NFD José")

;; Latin-1 + tab and its NFD
(define str-latin-2 "más\taño")
(test-begin "NFC 'más' + tab before 'año'")
(init-buf! buf "")
(cbuf-insert-codepoint buf #\a #f)
(cbuf-insert-codepoint buf #\ñ #f)      ; U+00F1 LATIN SMALL LETTER N WITH TILDE
(cbuf-insert-codepoint buf #\o #f)
(cbuf-set-x! buf 0 'data)
(cbuf-insert-codepoint buf #\m #f)
(cbuf-insert-codepoint buf #\á #f)      ; U+00E1 LATIN SMALL LETTER A WITH ACUTE
(cbuf-insert-codepoint buf #\s #f)
(cbuf-insert-codepoint buf #\tab #f)
(test-equal "text" '("más\taño") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 4 (cbuf-get-x-data buf))
(test-equal "x-cell" 8 (cbuf-get-x-cell buf))
(test-equal "x-goal" 8 (cbuf-get-x-goal buf))
(test-end "NFC 'más' + tab before 'año'")

(test-begin "NFD 'más' + tab before 'año'")
(init-buf! buf "")
(cbuf-insert-codepoint buf #\a #f)
(cbuf-insert-codepoint buf #\n #f)
(cbuf-insert-codepoint buf #\x0303 #f)  ; U+0303 COMBINING TILDE
(cbuf-insert-codepoint buf #\o #f)
(cbuf-set-x! buf 0 'data)
(cbuf-insert-codepoint buf #\m #f)
(cbuf-insert-codepoint buf #\a #f)
(cbuf-insert-codepoint buf #\x0301 #f)  ; U+0301 COMBINING ACUTE ACCENT
(cbuf-insert-codepoint buf #\s #f)
(cbuf-insert-codepoint buf #\tab #f)
(test-equal "text" '("más\taño") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 4 (cbuf-get-x-data buf))
(test-equal "x-cell" 8 (cbuf-get-x-cell buf))
(test-equal "x-goal" 8 (cbuf-get-x-goal buf))
(test-end "NFD 'más' + tab before 'año'")

;; Hiragana and its NFD
(define str-hiragana-1 "ぐるなび")

(test-begin "NFC 'ぐるなび'")
(init-buf! buf "")
(cbuf-insert-codepoint buf #\ぐ #f)     ; U+3050 HIRIGANA LETTER GU
(cbuf-insert-codepoint buf #\る #f)     ; U+308B
(cbuf-insert-codepoint buf #\な #f)     ; U+306A
(cbuf-insert-codepoint buf #\び #f)     ; U+3073
(test-equal "text" '("ぐるなび") (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 4 (cbuf-get-x-data buf))
(test-equal "x-cell" 8 (cbuf-get-x-cell buf))
(test-equal "x-goal" 8 (cbuf-get-x-goal buf))
(test-end "NFC 'ぐるなび'")

(test-begin "NFD 'ぐるなび'")
(init-buf! buf "")
(cbuf-insert-codepoint buf #\く #f)     ; U+304F HIRAGANA LETTER KU
(cbuf-insert-codepoint
 buf (integer->char #x3099) #f)         ; U+3099 COMBINING
                                        ; KATAKANA-HIRAGANA VOICED
                                        ; SOUND MARK
(cbuf-insert-codepoint buf #\る #f)     ; U+308B
(cbuf-insert-codepoint buf #\な #f)     ; U+306A
(cbuf-insert-codepoint buf #\び #f)     ; U+3073
(test-equal "text" '("ぐるな")  (cbuf-get-text buf))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 4 (cbuf-get-x-data buf))
(test-equal "x-cell" 8 (cbuf-get-x-cell buf))
(test-equal "x-goal" 8 (cbuf-get-x-goal buf))
(test-end "NFC 'ぐるなび'")

;; Hiragana + tab and its NFD
(define str-hiragana-2 "まど\tみちお")
(test-end "cbuf-insert-codepoint")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; INL
(test-begin "cbuf-insert-newline")

(test-begin "(null)+NL")
(init-buf! buf "")
(cbuf-insert-newline buf #f)
(test-equal "text" '("" "")  (cbuf-get-text buf))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-end "(null)+NL")

(test-begin "NL before NL")
(init-buf! buf (list "" ""))
(cbuf-set-y! buf 0)
(cbuf-insert-newline buf #f)
(test-equal "text" '("" "" "")  (cbuf-get-text buf))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-end "NL before NL")

(test-begin "NL before 'ab'")
(init-buf! buf (list "ab"))
(cbuf-set-x! buf 0 'data)
(cbuf-insert-newline buf #f)
(test-equal "text" '("" "ab")  (cbuf-get-text buf))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-end "NL before 'ab'")

(test-begin "NL between 'ab'")
(init-buf! buf (list "ab"))
(cbuf-set-x! buf 1 'data)
(cbuf-insert-newline buf #f)
(test-equal "text" '("a" "b")  (cbuf-get-text buf))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-end "NL between 'ab'")

(test-begin "NL after 'ab'")
(init-buf! buf (list "ab"))
(cbuf-set-x! buf 2 'data)
(cbuf-insert-newline buf #f)
(test-equal "text" '("ab" "")  (cbuf-get-text buf))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-end "NL after 'ab'")

(test-begin "NL between 'ab' and 'ab'")
(init-buf! buf (list "ab" "ab"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 0 'data)
(cbuf-insert-newline buf #f)
(test-equal "text" '("ab" "" "ab")  (cbuf-get-text buf))
(test-equal "y" 2 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-end "NL between 'ab' and 'ab'")

(test-end "cbuf-insert-newline")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; CONTROL FUNCTIONS
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BEL

(test-begin "cbuf-bell")
(cbuf-set-bell! buf #f)
(cbuf-bell buf #f)
(test-assert "set bell" (cbuf-get-bell buf))
(test-end "cbuf-bell")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BS
(test-begin "cbuf-backspace")
(test-begin "ASCII")

                                        ;---
(test-begin "backspace from col 24")
(init-buf! buf string-data-ascii)
(cbuf-set-positions! buf 24 'data)
(cbuf-backspace buf #t)
(test-equal "data position" 23 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 23 (cbuf-get-pp-cur buf))
(test-equal "goal column" 23 (cbuf-get-pp-goal buf))
(test-equal "current-line" string-data-ascii (cbuf-get-text-cur buf))
(test-end "backspace from col 24")

(test-begin "undo backspace")
(%undo buf)
(test-equal "data position" 24 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 24 (cbuf-get-pp-cur buf))
(test-equal "goal column" 24 (cbuf-get-pp-goal buf))
(test-equal "current-line" string-data-ascii (cbuf-get-text-cur buf))
(test-end "undo backspace")

(test-end "ASCII")

(test-begin "Hanzi")

(test-begin "backspace from 24th col")
(init-buf! buf string-data-hanzi)
(cbuf-set-positions! buf 12 'data)
(cbuf-backspace buf #t)
(test-equal "data position" 11 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 22 (cbuf-get-pp-cur buf))
(test-equal "goal column" 22 (cbuf-get-pp-goal buf))
(test-equal "current-line" string-data-hanzi (cbuf-get-text-cur buf))
(test-end "backspace from 24th col")

(test-begin "undo backspace")
(%undo buf)
(test-equal "data position" 12 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 24 (cbuf-get-pp-cur buf))
(test-equal "goal column" 24 (cbuf-get-pp-goal buf))
(test-equal "current-line" string-data-hanzi (cbuf-get-text-cur buf))
(test-end "undo backspace")

(test-begin "backspace from 25th col")
(init-buf! buf string-data-hanzi)
(cbuf-set-positions! buf 25 'presentation)
(cbuf-backspace buf #t)
(test-equal "data position" 11 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 22 (cbuf-get-pp-cur buf))
(test-equal "goal column" 22 (cbuf-get-pp-goal buf))
(test-equal "current-line" string-data-hanzi (cbuf-get-text-cur buf))
(test-end "backspace from 25th col")

(test-begin "undo backspace")
(%undo buf)
(test-equal "data position" 12 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 24 (cbuf-get-pp-cur buf))
(test-equal "goal column" 25 (cbuf-get-pp-goal buf))
(test-equal "current-line" string-data-hanzi (cbuf-get-text-cur buf))
(test-end "undo backspace")

(test-end "Hanzi")
(test-end "cbuf-backspace")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CAN")
(test-assert "cancel" 'xfail)
(test-end "CAN")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CBT")

(test-begin "backtab once from col 25")
;; Cursor backward tabulation moves the cursor to the nth previous tab
;; column
(init-buf! buf string-data-ascii)
(cbuf-set-positions! buf 25 'data)
(cbuf-set-tab-size! buf 8)
(cbuf-cursor-backward-tabulation buf 1 #t)
(test-equal "data position" 24 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 24 (cbuf-get-pp-cur buf))
(test-equal "goal column" 24 (cbuf-get-pp-goal buf))
(test-equal "current line" string-data-ascii (cbuf-get-text-cur buf))
(test-end "backtab once from col 25")

(test-begin "undo backtab once")
(%undo buf)
(test-equal "data position" 25 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 25 (cbuf-get-pp-cur buf))
(test-equal "goal column" 25 (cbuf-get-pp-goal buf))
(test-end "undo backtab once")

(test-begin "backtab twice from col 25")
(cbuf-set-positions! buf 25 'data)
(cbuf-cursor-backward-tabulation buf 2 #t)
(test-equal "data position" 16 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 16 (cbuf-get-pp-cur buf))
(test-equal "goal column" 16 (cbuf-get-pp-goal buf))
(test-equal "current line" string-data-ascii (cbuf-get-text-cur buf))
(test-end "backtab twice from col 25")

(test-begin "undo backtab twice")
(%undo buf)
(test-equal "data position" 25 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 25 (cbuf-get-pp-cur buf))
(test-equal "goal column" 25 (cbuf-get-pp-goal buf))
(test-end "undo backtab twice")

(test-end "CBT")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CCH")
(test-assert "cch" 'xfail)
(test-end "CCH")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CHA")

;;---
(test-begin "ASCII")

(test-begin "move to col 23")
(init-buf! buf string-data-ascii)
(cbuf-set-positions! buf 0 'data)
(cbuf-cursor-character-absolute buf 23 #t)
(test-equal "data position" 23 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 23 (cbuf-get-pp-cur buf))
(test-equal "goal column" 23 (cbuf-get-pp-goal buf))
(test-end "move to col 23")

(test-begin "undo move to col 23")
(%undo buf)
(test-equal "data position" 0 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 0 (cbuf-get-pp-cur buf))
(test-equal "goal column" 0 (cbuf-get-pp-goal buf))
(test-end "undo move to col 23")

(test-end "ASCII")

;;---
(test-begin "Hanzi")

(test-begin "move to col 23")
(init-buf! buf string-data-hanzi)
(cbuf-set-positions! buf 0 'data)
(cbuf-cursor-character-absolute buf 23 #t)
(test-equal "data position" 11 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 22 (cbuf-get-pp-cur buf))
(test-equal "goal column" 23 (cbuf-get-pp-goal buf))
(test-end "move to col 23")

(test-begin "undo move to col 23")
(%undo buf)
(test-equal "data position" 0 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 0 (cbuf-get-pp-cur buf))
(test-equal "goal column" 0 (cbuf-get-pp-goal buf))
(test-end "undo move to col 23")

(test-end "Hanzi")

(test-end "CHA")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CHT")

(test-begin "tab once from col 3")
(init-buf! buf string-data-ascii)
(cbuf-set-positions! buf 3 'data)
(cbuf-set-tab-size! buf 8)
(cbuf-cursor-forward-tabulation buf 1 #t)
(test-equal "data position" 8 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 8 (cbuf-get-pp-cur buf))
(test-equal "goal column" 8 (cbuf-get-pp-goal buf))
(test-equal "current line" string-data-ascii (cbuf-get-text-cur buf))
(test-end "tab once from col 3")

(test-begin "undo tab once")
(%undo buf)
(test-equal "data position" 3 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 3 (cbuf-get-pp-cur buf))
(test-equal "goal column" 3 (cbuf-get-pp-goal buf))
(test-end "undo tab once")

(test-begin "tab twice from col 3")
(cbuf-set-positions! buf 3 'data)
(cbuf-cursor-forward-tabulation buf 2 #t)
(test-equal "data position" 16 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 16 (cbuf-get-pp-cur buf))
(test-equal "goal column" 16 (cbuf-get-pp-goal buf))
(test-equal "current line" string-data-ascii (cbuf-get-text-cur buf))
(test-end "tab twice from col 3")

(test-begin "undo tab twice")
(%undo buf)
(test-equal "data position" 3 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 3 (cbuf-get-pp-cur buf))
(test-equal "goal column" 3 (cbuf-get-pp-goal buf))
(test-end "undo tab twice")

(test-end "CHT")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CNL")
(test-begin "ASCII")

(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 1)
(cbuf-set-positions! buf 1 'data)

(test-begin "next line from line 1")
(cbuf-cursor-next-line buf 1 #t)
(test-equal "line cur" 2 (cbuf-get-line-cur buf))
(test-equal "data position" 0 (cbuf-get-pd-cur buf))
(test-equal "presentation-position" 0 (cbuf-get-pp-cur buf))
(test-equal "goal column" 0 (cbuf-get-pp-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "as I pondered")
(test-end "next line from line 1")

(test-begin "undo next line")
(%undo buf)
(test-equal "line cur" 1 (cbuf-get-line-cur buf))
(test-equal "data position" 1 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 1 (cbuf-get-pp-cur buf))
(test-equal "goal column" 1 (cbuf-get-pp-goal buf))
(test-end "undo next line")

(test-begin "next line x2 from line 1")
(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 1)
(cbuf-set-positions! buf 1 'data)
(cbuf-cursor-next-line buf 2 #t)
(test-equal "line cur" 3 (cbuf-get-line-cur buf))
(test-equal "data position" 0 (cbuf-get-pd-cur buf))
(test-equal "presentation-position" 0 (cbuf-get-pp-cur buf))
(test-equal "goal column"  0 (cbuf-get-pp-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "weak and weary")
(test-end "next line x2 from line 1")

(test-begin "undo next line x2")
(%undo buf)
(test-equal "line cur" 1 (cbuf-get-line-cur buf))
(test-equal "data position" 1 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 1 (cbuf-get-pp-cur buf))
(test-equal "goal column" 1 (cbuf-get-pp-goal buf))
(test-end "undo next line x2")

(test-end "ASCII")
(test-end "CNL")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CPL")
(test-begin "ASCII")

(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 3)
(cbuf-set-positions! buf 1 'data)

(test-begin "preceding line from line 3")
(cbuf-cursor-preceding-line buf 1 #t)
(test-equal "line cur" 2 (cbuf-get-line-cur buf))
(test-equal "data position" 0 (cbuf-get-pd-cur buf))
(test-equal "presentation-position" 0 (cbuf-get-pp-cur buf))
(test-equal "goal column" 0 (cbuf-get-pp-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "as I pondered")
(test-end "preceding line from line 3")

(test-begin "undo preceding line")
(%undo buf)
(test-equal "line cur" 3 (cbuf-get-line-cur buf))
(test-equal "data position" 1 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 1 (cbuf-get-pp-cur buf))
(test-equal "goal column" 1 (cbuf-get-pp-goal buf))
(test-end "undo preceding line")

(test-begin "preceding line x2 from line 3")
(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 3)
(cbuf-set-positions! buf 1 'data)
(cbuf-cursor-preceding-line buf 2 #t)
(test-equal "line cur" 1 (cbuf-get-line-cur buf))
(test-equal "data position" 0 (cbuf-get-pd-cur buf))
(test-equal "presentation-position" 0 (cbuf-get-pp-cur buf))
(test-equal "goal column"  0 (cbuf-get-pp-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "a midnight dreary")
(test-end "preceding line x2 from line 3")

;; (pretty-print (cbuf-get-undo-list buf))

(test-begin "undo preceding line x2")
(%undo buf)
(test-equal "line cur" 3 (cbuf-get-line-cur buf))
(test-equal "data position" 1 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 1 (cbuf-get-pp-cur buf))
(test-equal "goal column" 1 (cbuf-get-pp-goal buf))
(test-end "undo preceding line x2")

(test-end "ASCII")
(test-end "CPL")

