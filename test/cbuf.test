            (first (cbuf-get-text buf)))
(test-equal "second line" "\tO my soul, thou has said unto the LORD, Thou art my Lord: my goodness"
            (second (cbuf-get-text buf)))
(test-equal "cut buffer" (list "\tTheir sorrows shall be multiplied that hasten after another god: their"
                               "drink offerings of blood will I not offer, nor take up their names"
                               "into my lips."
                               "\tThe LORD is the portion of mine inheritance and of my cup: thou"
                               "maintainest my lot."
                               "\tThe lines are fallen unto me in pleasant places; yea, I have a goodly"
                               "heritage."
                               "\tI will bless the LORD, who hath given me counsel: my reins also"
                               "instruct me in the night seasons."
                               "\tI have set the LORD always before me: because he is at my right hand,")
            (cbuf-get-cut-buffer buf))
(test-equal "mark" #t (cbuf-is-mark-set? buf))
(test-equal "y mark" 9 (cbuf-get-y-mark buf))
(test-end "delete lines from center of buffer")


(test-begin "delete all lines")
(init-buf! buf (list "老婆は、一目下人を見ると、まるで弩（いしゆみ）"
                     "にでも弾かれたように　飛び上がっ　た。"
                     "「おのれ、どこへ行く。」"))
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 3 'data)
(cbuf-set-mark-flag! buf #t)
(cbuf-set-y-mark! buf 0)
(cbuf-set-x-mark! buf 5)
(cbuf-delete-line buf 3 #t #t)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" "" (first (cbuf-get-text buf)))
(test-equal "number of lines" 1 (length (cbuf-get-text buf)))
(test-equal "cut buffer" (list "老婆は、一目下人を見ると、まるで弩（いしゆみ）"
                               "にでも弾かれたように　飛び上がっ　た。"
                               "「おのれ、どこへ行く。」")
            (cbuf-get-cut-buffer buf))
(test-equal "mark" #f (cbuf-is-mark-set? buf))
(test-end "delete all lines")

(test-begin "delete too many lines")
(init-buf! buf (list "老婆は、一目下人を見ると、まるで弩（いしゆみ）"
                     "にでも弾かれたように　飛び上がっ　た。"
                     "「おのれ、どこへ行く。」"))
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 4 'data)
(cbuf-set-mark-flag! buf #t)
(cbuf-set-y-mark! buf 0)
(cbuf-set-x-mark! buf 5)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-buffer? err) #t)
                     (else #f))
                    (cbuf-delete-line buf 4 #t #t)))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" "" (first (cbuf-get-text buf)))
(test-equal "number of lines" 1 (length (cbuf-get-text buf)))
(test-equal "cut buffer" (list "老婆は、一目下人を見ると、まるで弩（いしゆみ）"
                               "にでも弾かれたように　飛び上がっ　た。"
                               "「おのれ、どこへ行く。」")
            (cbuf-get-cut-buffer buf))
(test-equal "mark" #f (cbuf-is-mark-set? buf))
(test-end "delete too many lines")


(test-end "cbuf-delete-line")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DSR

(test-begin "cbuf-device-status-report")
(init-buf! buf (list "老婆は、一目下人を見ると、まるで弩（いしゆみ）"
                     "にでも弾かれたように　飛び上がっ　た。"
                     "「おのれ、どこへ行く。」"))
(cbuf-set-y! buf 2)
(cbuf-set-x! buf 3 'data)
(test-equal "data y" 2 (car (cbuf-device-status-report buf 'data)))
(test-equal "data x" 3 (cdr (cbuf-device-status-report buf 'data)))
(test-equal "presentation y" 2(car (cbuf-device-status-report buf 'presentation)))
(test-equal "presentation x" 6 (cdr (cbuf-device-status-report buf 'presentation)))
(test-end "cbuf-device-status-report")

