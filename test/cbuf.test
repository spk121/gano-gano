(test-begin "CR")
(test-begin "ASCII")

(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 2)
(cbuf-set-positions! buf 9 'data)

(test-begin "carriage return with line-home = 0")
(cbuf-set-line-home buf 0)
(cbuf-carriage-return buf #t)
(test-equal "line cur" 2 (cbuf-get-line-cur buf))
(test-equal "data position" 0 (cbuf-get-pd-cur buf))
(test-equal "presentation-position" 0 (cbuf-get-pp-cur buf))
(test-equal "goal column" 0 (cbuf-get-pp-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "as I pondered")
(test-end "carriage return with line-home = 0")

(test-begin "undo carriage return")
(%undo buf)
(test-equal "line cur" 2 (cbuf-get-line-cur buf))
(test-equal "data position" 9 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 9 (cbuf-get-pp-cur buf))
(test-equal "goal column" 9 (cbuf-get-pp-goal buf))
(test-end "undo carriage return")

(test-begin "carriage return with line-home = 1")
(cbuf-set-line-home buf 1)
(cbuf-carriage-return buf #t)
(test-equal "line cur" 2 (cbuf-get-line-cur buf))
(test-equal "data position" 1 (cbuf-get-pd-cur buf))
(test-equal "presentation-position" 1 (cbuf-get-pp-cur buf))
(test-equal "goal column" 1 (cbuf-get-pp-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "as I pondered")
(test-end "carriage return with line-home = 1")

(test-begin "undo carriage return")
(%undo buf)
(test-equal "line cur" 2 (cbuf-get-line-cur buf))
(test-equal "data position" 9 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 9 (cbuf-get-pp-cur buf))
(test-equal "goal column" 9 (cbuf-get-pp-goal buf))
(test-end "undo carriage return")

(test-end "ASCII")
(test-end "CR")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(test-begin "CTC")
(test-begin "ASCII")

(test-begin "two tabs of tabsize = 6")
(init-buf! buf string-data-ascii)
(cbuf-set-positions! buf 0 'data)
(cbuf-cursor-tabulation-control buf 6)
(cbuf-cursor-forward-tabulation buf 2 #t)
(test-equal "data position" 12 (cbuf-get-pd-cur buf))
(test-equal "presentation position" 12 (cbuf-get-pp-cur buf))
(test-equal "goal column" 12 (cbuf-get-pp-goal buf))
(test-end "two tabs of tabsize = 6")

(test-end "ASCII")
(cbuf-cursor-tabulation-control buf 8)
(test-end "CTC")

