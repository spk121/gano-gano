;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HPA

(test-begin "cbuf-character-position-absolute")

(test-begin "move to beginning of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(cbuf-character-position-absolute buf 0)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move to beginning of line")

(test-begin "move before beginning of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-beginning-of-line? err) #t)
                     (else #f))
                    (cbuf-character-position-absolute buf -1)))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move before beginning of line")

(test-begin "move to end of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(cbuf-character-position-absolute buf 6)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move to end of line")

(test-begin "move past end of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-line? err) #t)
                     (else #f))
                    (cbuf-character-position-absolute buf 7)))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move past end of line")

(test-end "cbuf-character-position-absolute")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HPB

(test-begin "cbuf-character-position-backward")

(test-begin "move to beginning of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(cbuf-character-position-backward buf 1)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move to beginning of line")

(test-begin "move before beginning of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-beginning-of-line? err) #t)
                     (else #f))
                    (cbuf-character-position-backward buf 2)))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move before beginning of line")

(test-end "cbuf-character-position-backward")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HPR

(test-begin "cbuf-character-position-forward")

(test-begin "move to end of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(cbuf-character-position-forward buf 5)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move to end of line")

(test-begin "move past end of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-line? err) #t)
                     (else #f))
                    (cbuf-character-position-forward buf 7)))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "move past end of line")

(test-end "cbuf-character-position-forward")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; HVP

(test-begin "cbuf-character-and-line-position")

(test-begin "jump to beginning of buffer")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(cbuf-character-and-line-position buf 0 0)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "jump to beginning of buffer")

(test-begin "jump to end of buffer")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(cbuf-character-and-line-position buf 1 6)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "jump to end of buffer")

(test-begin "jump past end of buffer")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-line? err) #t)
                     (else #f))
                    (cbuf-character-and-line-position buf 1 7)))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "jump past end of buffer")

(test-begin "jump past end of buffer #2")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-buffer? err) #t)
                     (else #f))
                    (cbuf-character-and-line-position buf 2 6)))
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "jump past end of buffer #2")


(test-end "cbuf-character-and-line-position")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ICH

(test-begin "cbuf-insert-character")

(test-begin "insert character at beginning of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 0 'data)
(cbuf-insert-character buf 2 #t)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "  line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "insert character at beginning of line")

(test-begin "undo insert character at beginning of line")
(cbuf-undo buf)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "undo insert character at beginning of line")

(test-begin "insert character at end of line")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 6 'data)
(cbuf-insert-character buf 2 #t)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2  ")
(test-end "insert character at end of line")

(test-begin "undo insert character at end of line")
(cbuf-undo buf)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 6 (cbuf-get-x-data buf))
(test-equal "x-cell" 6 (cbuf-get-x-cell buf))
(test-equal "x-goal" 6 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-end "undo insert character at end of line")

(test-end "cbuf-insert-character")
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; IL

(test-begin "cbuf-insert-line")

(test-begin "insert lines at beginning")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 2 'data)
(cbuf-insert-line buf 2 #t)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal"  0 (cbuf-get-x-goal buf))
(test-equal "first line" (cbuf-get-text-cur buf) "")
(test-equal "second line" (second (cbuf-get-text buf)) "")
(test-equal "third line" (third (cbuf-get-text buf)) "line 1")
(test-end "insert lines at beginning")

(test-begin "undo insert lines at beginning")
(cbuf-undo buf)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "line 2")
(test-equal "line count" 2 (length (cbuf-get-text buf)))
(test-end "undo insert lines at beginning")

(test-begin "insert line at end")
(init-buf! buf (list "line 1" "line 2"))
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 6 'data)
(cbuf-insert-line buf 1 #t)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal"  0 (cbuf-get-x-goal buf))
(test-equal "first line" (first (cbuf-get-text buf)) "line 1")
(test-equal "second line" (second (cbuf-get-text buf)) "")
(test-equal "third line" (third (cbuf-get-text buf)) "line 2")
(test-end "insert line at end")

(test-end "cbuf-insert-line")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VPA

(test-begin "cbuf-line-position-absolute")

(test-begin "move to last line")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 2)
(cbuf-set-x! buf 2 'data)
(cbuf-line-position-absolute buf 3)
(test-equal "y" 3 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "weak and weary")
(test-end "move to last line")

(test-begin "move to first line")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 3)
(cbuf-set-x! buf 0 'data)
(cbuf-line-position-absolute buf 0)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "\tOnce upon")
(test-end "move to first line")

(test-begin "move past end")
(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 1)
(cbuf-set-positions! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-buffer? err)
                      #t)
                     (else
                      #f))
                    (cbuf-line-position-absolute buf 4)))
(test-equal "y" 3 (cbuf-get-y buf))
(test-equal "x-data" 14 (cbuf-get-x-data buf))
(test-equal "x-cell" 14 (cbuf-get-x-cell buf))
(test-equal "x-goal" 14 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "weak and weary")
(test-end "move past end")

(test-begin "move to a shorter line")
(init-buf! buf '("abcde" "def" "ghijk"))
(cbuf-set-y! buf 2)
(cbuf-set-x! buf 5 'data)
(cbuf-line-position-absolute buf 1)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 3 (cbuf-get-x-data buf))
(test-equal "x-cell" 3 (cbuf-get-x-cell buf))
(test-equal "x-goal"  3 (cbuf-get-x-goal buf))
(test-end "move to a shorter line")

(test-begin "continuation marks")
(init-buf! buf (list "aeiou"
                     (string #\a #\◌́ #\e #\◌̂ #\◌̡ #\i #\◌̣ #\◌̅ #\o #\◌̆ #\u #\◌̐)))
;; Move from the `i' in the second line to the `i' in the first line.
(cbuf-set-line-cur! buf 1)
(cbuf-set-x! buf 2 'data)
(cbuf-line-position-absolute buf 0)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-index" 2 (cbuf-get-x-index buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-end "continuation marks")

(test-end "cbuf-line-position-absolute")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VPB

(test-begin "cbuf-line-position-backward")

(test-begin "backward from last line")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 3)
(cbuf-set-x! buf 2 'data)
(cbuf-line-position-backward buf 2)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "a midnight dreary")
(test-end "backward from last line")

(test-begin "backward to beginning")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 0 'data)
(cbuf-line-position-backward buf 1)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "\tOnce upon")
(test-end "backward to beginning")

(test-begin "backward before beginning")
(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 1)
(cbuf-set-positions! buf 1 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-beginning-of-buffer? err)
                      #t)
                     (else
                      #f))
                    (cbuf-line-position-backward buf 3)))
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-data" 0 (cbuf-get-x-data buf))
(test-equal "x-cell" 0 (cbuf-get-x-cell buf))
(test-equal "x-goal" 0 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "\tOnce upon")
(test-end "backward before beginning")

(test-begin "backward to a shorter line")
(init-buf! buf '("abcde" "def" "ghijk"))
(cbuf-set-y! buf 2)
(cbuf-set-x! buf 5 'data)
(cbuf-line-position-backward buf 1)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 3 (cbuf-get-x-data buf))
(test-equal "x-cell" 3 (cbuf-get-x-cell buf))
(test-equal "x-goal"  3 (cbuf-get-x-goal buf))
(test-end "backward to a shorter line")

(test-begin "continuation marks")
(init-buf! buf (list "aeiou"
                     (string #\a #\◌́ #\e #\◌̂ #\◌̡ #\i #\◌̣ #\◌̅ #\o #\◌̆ #\u #\◌̐)))
;; Move from the `i' in the second line to the `i' in the first line.
(cbuf-set-line-cur! buf 1)
(cbuf-set-x! buf 2 'data)
(cbuf-line-position-backward buf 1)
(test-equal "y" 0 (cbuf-get-y buf))
(test-equal "x-index" 2 (cbuf-get-x-index buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-end "continuation marks")

(test-end "cbuf-line-position-backward")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VPR

(test-begin "cbuf-line-position-forward")

(test-begin "forward from beginning")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 2 'data)
(cbuf-line-position-forward buf 2)
(test-equal "y" 2 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "as I pondered")
(test-end "forward from beginning")

(test-begin "forward from middle")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 2 'data)
(cbuf-line-position-forward buf 2)
(test-equal "y" 3 (cbuf-get-y buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "weak and weary")
(test-end "forward from middle")

(test-begin "forward to end")
(init-buf! buf text-ascii-short)
(cbuf-set-y! buf 1)
(cbuf-set-x! buf 14 'data)
(cbuf-line-position-forward buf 2)
(test-equal "y" 3 (cbuf-get-y buf))
(test-equal "x-data" 14 (cbuf-get-x-data buf))
(test-equal "x-cell" 14 (cbuf-get-x-cell buf))
(test-equal "x-goal"  14 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "weak and weary")
(test-end "forward to end")

(test-begin "forward past end")
(init-buf! buf text-ascii-short)
(cbuf-set-line-cur! buf 1)
(cbuf-set-positions! buf 14 'data)
(test-assert "throws error"
             (guard (err
                     ((cbuf-end-of-buffer? err)
                      #t)
                     (else
                      #f))
                    (cbuf-line-position-forward buf 3)))
(test-equal "y" 3 (cbuf-get-y buf))
(test-equal "x-data" 14 (cbuf-get-x-data buf))
(test-equal "x-cell" 14 (cbuf-get-x-cell buf))
(test-equal "x-goal"  14 (cbuf-get-x-goal buf))
(test-equal "current line" (cbuf-get-text-cur buf) "weak and weary")
(test-end "forward past end")

(test-begin "forward to a shorter line")
(init-buf! buf '("abcde" "def" "ghijk"))
(cbuf-set-y! buf 0)
(cbuf-set-x! buf 5 'data)
(cbuf-line-position-forward buf 1)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-data" 3 (cbuf-get-x-data buf))
(test-equal "x-cell" 3 (cbuf-get-x-cell buf))
(test-equal "x-goal"  3 (cbuf-get-x-goal buf))
(test-end "forward to a shorter line")


(test-begin "continuation marks")
(init-buf! buf (list "aeiou"
                     (string #\a #\◌́ #\e #\◌̂ #\◌̡ #\i #\◌̣ #\◌̅ #\o #\◌̆ #\u #\◌̐)))
;; Move from the ASCII `i' in the first line to the decorated `#\ị̅'
;; in the second line.
(cbuf-set-line-cur! buf 0)
(cbuf-set-x! buf 2 'data)
(cbuf-line-position-forward buf 1)
(test-equal "y" 1 (cbuf-get-y buf))
(test-equal "x-index" 5 (cbuf-get-x-index buf))
(test-equal "x-data" 2 (cbuf-get-x-data buf))
(test-equal "x-cell" 2 (cbuf-get-x-cell buf))
(test-equal "x-goal"  2 (cbuf-get-x-goal buf))
(test-end "continuation marks")

(test-end "cbuf-line-position-forward")
(test-end "cbuf")