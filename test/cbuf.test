(test-equal "second line" " でも弾かれたように　飛び上がっ　た。" (second (cbuf-get-text buf)))
(test-equal "cut buffer" (list "に") (cbuf-get-cut-buffer buf))
(test-equal "mark" #t (cbuf-is-mark-set? buf))
(test-equal "x-mark" 1 (cbuf-get-x-mark buf))
(test-end "erase Kanji data from bol")

(test-begin "erase Kanji presentation from bol")
