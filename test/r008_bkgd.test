;;;; -*- Mode: scheme; -*-
;;;; r008_bkgd.test --- test suite for curses's background functions

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(define win (initscr))

(define period (char->integer #\.))
(define plus (char->integer #\+))
(define space (char->integer #\sp))


(clear win)
(standend! win)

(with-test-prefix 
 "bkgd"
 
 (pass-if "bkgd"
	  (begin
	    (addstr win "This is a string" #:y 0 #:x 0)
	    (bkgd win (logior A_BOLD period))
	    (addstr win "This is a new string" #:y 1 #:x 0)
	    (refresh win)
	    (let ((x1 (inch win #:y 0 #:x 4)) ;Loc of space between "This" and "is"
		  (x2 (inch win #:y 1 #:x 4)))
	      (begin
		(bkgd win (logior A_NORMAL space)) ; clear bkgd
		(clear win)
		(refresh win)
		(and
		 (equal? (logior A_BOLD period) x1)
		 (equal? (logior A_BOLD period) x2))))))
 
 (pass-if "bkgdset"
	  (begin
	    (standend! win)
	    (addstr win "This is a string" #:y 0 #:x 0)
	    (bkgdset win (logior A_DIM (color-pair 1) plus))
	    (addstr win "This is another string" #:y 1 #:x 0)
	    (refresh win)
	    (let ((x1 (inch win #:y 0 #:x 4))
		  (x2 (inch win #:y 1 #:x 4)))
	      (begin
		(bkgd win (logior A_NORMAL space)) ; clear bkgd
		(clear win)
		(refresh win)
		(and
		 (equal? (logior A_NORMAL space) x1)
		 (equal? (logior A_DIM (color-pair 1) plus) x2)))))))

(endwin)

(curses-test-end test "r008_bkgd.out")
		  
