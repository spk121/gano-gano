;;;; -*- Mode: scheme; -*-
;;;; r008_bkgd.test --- test suite for curses's background functions

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(initscr)

(define period (char->integer #\.))
(define plus (char->integer #\+))
(define space (char->integer #\sp))


(clear)
(standend)

(with-test-prefix 
 "bkgd"
 
 (pass-if "bkgd"
	  (begin
	    (addstr "This is a string" #:y 0 #:x 0)
	    (bkgd (logior A_BOLD period))
	    (addstr "This is a new string" #:y 1 #:x 0)
	    (refresh)
	    (let ((x1 (mvinch 0 4)) ;Loc of space between "This" and "is"
		  (x2 (mvinch 1 4)))
	      (begin
		(bkgd (logior A_NORMAL space)) ; clear bkgd
		(clear)
		(refresh)
		(and
		 (equal? (logior A_BOLD period) x1)
		 (equal? (logior A_BOLD period) x2))))))
 
 (pass-if "bkgdset"
	  (begin
	    (standend)
	    (addstr "This is a string" #:y 0 #:x 0)
	    (bkgdset (logior A_DIM (color-pair 1) plus))
	    (addstr "This is another string" #:y 1 #:x 0)
	    (refresh)
	    (let ((x1 (mvinch 0 4))
		  (x2 (mvinch 1 4)))
	      (begin
		(bkgd (logior A_NORMAL space)) ; clear bkgd
		(clear)
		(refresh)
		(and
		 (equal? (logior A_NORMAL space) x1)
		 (equal? (logior A_DIM (color-pair 1) plus) x2)))))))

(define win (newwin 5 10 5 5))

(with-test-prefix 
 "wbkgd"
 
 (pass-if "bkgd #:win"
	  (begin
	    (addstr "This is a string" #:win win #:y 0 #:x 0)
	    (bkgd (logior A_BOLD period) #:win win)
	    (addstr "This is a new string" #:win win #:y 1 #:x 0)
	    (wrefresh win)
	    (let ((x1 (mvwinch win 0 4))
		  (x2 (mvwinch win 1 4)))
	      (begin
		(bkgd (logior A_NORMAL space) #:win win ) ; clear bkgd
		(wclear win)
		(wrefresh win)
		(and
		 (equal? (logior A_BOLD period) x1)
		 (equal? (logior A_BOLD period) x2))))))
 
 (pass-if "bkgdget"
	  (begin
	    (standend #:win win)
	    (addstr "This is a string" #:win win #:y 0 #:x 0)
	    (bkgdset (logior A_DIM (color-pair 1) plus) #:win win)
	    (addstr "This is another string" #:win win #:y 1 #:x 0)
	    (wrefresh win)
	    (let ((bk (getbkgd #:win win)))
	      (begin
		(bkgd (logior A_NORMAL space) #:win win) ; clear bkgd
		(wclear win)
		(wrefresh win)
		(equal? bk (logior A_DIM (color-pair 1) plus)))))))
(delwin win)
(refresh)

(endwin)

(curses-test-end test "r008_bkgd.out")
		  
