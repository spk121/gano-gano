;;;; -*- Mode: scheme; -*-
;;;; r008_bkgd.test --- test suite for curses's background functions

(define-module (test r008_bkgd)
  #:use-module (test lib)
  #:use-module (gucu raw))

(define period (char->integer #\.))
(define plus (char->integer #\+))
(define space (char->integer #\sp))


(clear)
(standend)

(with-test-prefix "bkgd"
		  
		  (pass-if "bkgd"
			   (begin
			     (mvaddstr 0 0 "This is a string")
			     (bkgd (logior *a-bold* period))
			     (mvaddstr 1 0 "This is a new string")
			     (refresh)
			     (let ((x1 (mvinch 0 4)) ;Loc of space between "This" and "is"
				   (x2 (mvinch 1 4)))
			       (begin
				 (bkgd (logior *a-normal* space)) ; clear bkgd
				 (clear)
				 (refresh)
				 (and
				  (equal? (logior *a-bold* period) x1)
				  (equal? (logior *a-bold* period) x2))))))
		  
		  (pass-if "bkgdset"
			   (begin
			     (standend)
			     (mvaddstr 0 0 "This is a string")
			     (bkgdset (logior *a-dim* (color-pair 1) plus))
			     (mvaddstr 1 0 "This is another string")
			     (refresh)
			     (let ((x1 (mvinch 0 4))
				   (x2 (mvinch 1 4)))
			       (begin
				 (bkgd (logior *a-normal* space)) ; clear bkgd
				 (clear)
				 (refresh)
				 (and
				  (equal? (logior *a-normal* space) x1)
				  (equal? (logior *a-dim* (color-pair 1) plus) x2)))))))
		  
(define win (newwin 5 10 5 5))

(with-test-prefix "wbkgd"
		  
		  (pass-if "wbkgd"
			   (begin
			     (mvwaddstr win 0 0 "This is a string")
			     (wbkgd win (logior *a-bold* period))
			     (mvwaddstr win 1 0 "This is a new string")
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 4))
				   (x2 (mvwinch win 1 4)))
			       (begin
				 (wbkgd win (logior *a-normal* space)) ; clear bkgd
				 (wclear win)
				 (wrefresh win)
				 (and
				  (equal? (logior *a-bold* period) x1)
				  (equal? (logior *a-bold* period) x2))))))
		  
		  (pass-if "bkgdget / wbkgdset"
			   (begin
			     (wstandend win)
			     (mvwaddstr win 0 0 "This is a string")
			     (wbkgdset win (logior *a-dim* (color-pair 1) plus))
			     (mvwaddstr win 1 0 "This is another string")
			     (wrefresh win)
			     (let ((bk (getbkgd win)))
			       (begin
				 (wbkgd win (logior *a-normal* space)) ; clear bkgd
				 (wclear win)
				 (wrefresh win)
				 (equal? bk (logior *a-dim* (color-pair 1) plus)))))))
(delwin win)
(refresh)

		  
