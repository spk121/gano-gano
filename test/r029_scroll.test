;;;; -*- Mode: scheme; -*-
;;;; r029_scroll.test --- test suite for curses's scroll

(use-modules (test lib)
	     (test lib2)
	     ;; (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(define (mvaddstr y x s)
  (addstr s #:y y #:x x))
(define (mvwaddstr w y x s)
  (addstr s #:win w #:y y #:x x))

(initscr)

;; Should be able to dump windows to files
(with-test-prefix "scroll"

		  (pass-if "scroll"
			   (begin
			     (clear)
			     (mvaddstr 1 0 "xxx")
			     (scrollok (stdscr) #t)
			     (scroll (stdscr))
			     (refresh)
			     (let ((x1 (mvinnstr 0 0 3)))
			       (string=? "xxx" x1))))


		  (pass-if "scrl"
			   (begin
			     (clear)
			     (mvaddstr 0 0 "xxx")
			     (scrollok (stdscr) #t)
			     (scrl -1)
			     (refresh)
			     (let ((x1 (mvinnstr 1 0 3)))
			       (string=? "xxx" x1))))

		  (pass-if "scrl"
			   (begin
			     (clear)
			     (mvaddstr 0 0 "xxx")
			     (scrollok (stdscr) #t)
			     (wscrl (stdscr) -1)
			     (refresh)
			     (let ((x1 (mvinnstr 1 0 3)))
			       (string=? "xxx" x1))))
		  )


(endwin)

(curses-test-end test "r029_scroll.out")		  
