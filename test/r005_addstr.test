;;;; -*- Mode: scheme; -*-
;;;; r005_addstr.test --- test suite for curses's addstr

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))

(define test (curses-test-start))

(initscr)

(with-test-prefix 
 "addstr"
 
 (pass-if "addstr"
	  (begin
	    (clear)
	    (move 0 0)
	    (addstr "hello")
	    (refresh)
	    (let ((w2 (mvinstr 0 0)))
	      (string=? "hello" (string-take w2 (string-length "hello"))))))

 (pass-if "addstr #:n"
	  (begin
	    (clear)
	    (move 0 0)
	    (addstr "hello" #:n 2)
	    (refresh)
	    (let ((w2 (mvinstr 0 0)))
	      (string=? "he" (string-take w2 (string-length "he"))))))

 (pass-if "addstr #:y #:x"
	  (begin
	    (clear)
	    (addstr "bold" #:y 1 #:x 0)
	    (refresh)
	    (let ((x2 (mvinstr 1 0)))
	      (string=? "bold" (string-take x2 (string-length "bold"))))))

 (pass-if "addstr #:y #:x #:n"
	  (begin
	    (clear)
	    (addstr "bold" #:y 1 #:x 0 #:n 2)
	    (refresh)
	    (let ((x2 (mvinstr 1 0)))
	      (string=? "bo" (string-take x2 (string-length "bo")))))))

(define win (newwin 5 10 5 5))

(with-test-prefix 
 "addstr #:win"
		  
 (pass-if "addstr #:win"
	  (begin
	    (wclear win)
	    (wmove win 0 0)
	    (addstr "hello" #:win win)
	    (wrefresh win)
	    (let ((w2 (mvwinstr win 0 0)))
	      (string=? "hello" (string-take w2 (string-length "hello"))))))
 
 (pass-if "addstr #:win #:n"
	  (begin
	    (wclear win)
	    (wmove win 0 0)
	    (addstr "hello" #:win win #:n 2)
	    (wrefresh win)
	    (let ((w2 (mvwinstr win 0 0)))
	      (string=? "he" (string-take w2 (string-length "he"))))))
 
 (pass-if "addstr #:win #:y #:x"
	  (begin
	    (wclear win)
	    (addstr "bold" #:win win #:y 1 #:x 0)
	    (wrefresh win)
	    (let ((x2 (mvwinstr win 1 0)))
	      (string=? "bold" (string-take x2 (string-length "bold"))))))
 
 (pass-if "addstr #:win #:y #:x #:n"
	  (begin
	    (wclear win)
	    (addstr "bold" #:win win #:y 1 #:x 0 #:n 2)
	    (wrefresh win)
	    (let ((x2 (mvwinstr win 1 0)))
	      (string=? "bo" (string-take x2 (string-length "bo")))))))


(delwin win)
(refresh)

(endwin)

(curses-test-end test "r005_addstr.out")
