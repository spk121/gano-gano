;;;; -*- Mode: scheme; -*-
;;;; r037_border_set.test --- test suite for curses's border

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses-wide)
	     (gucu curses))

(define test (curses-test-start))

(define win (initscr))

;; Should be able to draw borders
(with-test-prefix 
 "border-set"
		  
 (pass-if "border-set default"
	  (begin
	    (clear win)
	    (border-set win (wacs-vline) (wacs-vline) (wacs-hline) (wacs-hline)
			(wacs-ulcorner) (wacs-urcorner) (wacs-llcorner) (wacs-lrcorner))
	    (refresh win)
	    (let ((l  (in-wch win #:y 1 		#:x 0))
		  (r  (in-wch win #:y 1			#:x (- (cols) 1)))
		  (t  (in-wch win #:y 0 		#:x 1))
		  (b  (in-wch win #:y (- (lines) 1) 	#:x 1))
		  (tl (in-wch win #:y 0 		#:x 0))
		  (tr (in-wch win #:y 0 		#:x (- (cols) 1)))
		  (bl (in-wch win #:y (- (lines) 1) 	#:x 0))
		  (br (in-wch win #:y (- (lines) 1) 	#:x (- (cols) 1)))
		  )
	      (and
	       ;; These are the unicode values
	       ;; U+2502 BOX DRAWINGS LIGHT VERTICAL
	       (lset= equal? l '(0 0 #x2502))
	       (lset= equal? r '(0 0 #x2502))
	       ;; U+2500 BOX DRAWINGS LIGHT HORIZONTAL
	       (lset= equal? t '(0 0 #x2500))
	       (lset= equal? b '(0 0 #x2500))
	       ;; U+250C BOX DRAWINGS LIGHT DOWN AND RIGHT
	       (lset= equal? tl '(0 0 #x250C))
	       ;; U+2510 BOX DRAWINGS LIGHT DOWN AND LEFT
	       (lset= equal? tr '(0 0 #x2510))
	       ;; U+2514 BOX DRAWINGS LIGHT UP AND RIGHT
	       (lset= equal? bl '(0 0 #x2514))
	       ;; U+2518 BOX DRAWINGS LIGHT UP AND LEFT
	       (lset= equal? br '(0 0 #x2518))))
	    *unspecified*
	    ))

 (pass-if "border dashed"
	  (begin
	    (clear win)
	    (border-set win 
			'(0 0 #x2506) ; dashed vert
			'(0 0 #x2506)
			'(0 0 #x2504) ; dashed horiz
			'(0 0 #x2504)
			'(0 0 #x250C)
			'(0 0 #x2510)
			'(0 0 #x2514)
			'(0 0 #x2518))
	    (refresh win)
	    (let ((l  (in-wch win #:y 1 	#:x 0))
		  (r  (in-wch win #:y 1 	#:x (- (cols) 1)))
		  (t  (in-wch win #:y 0 	#:x 1))
		  (b  (in-wch win #:y (- (lines) 1) #:x 1))
		  (tl (in-wch win #:y 0 	#:x 0))
		  (tr (in-wch win #:y 0 	#:x (- (cols) 1)))
		  (bl (in-wch win #:y (- (lines) 1) #:x 0))
		  (br (in-wch win #:y (- (lines) 1) #:x (- (cols) 1)))
		  )
	      (and
	       (lset= equal? l '(0 0 #x2506))
	       (lset= equal? r '(0 0 #x2506))
	       (lset= equal? t '(0 0 #x2504))
	       (lset= equal? b '(0 0 #x2504))
	       (lset= equal? tl '(0 0 #x250C))
	       (lset= equal? tr '(0 0 #x2510))
	       (lset= equal? bl '(0 0 #x2514))
	       (lset= equal? br '(0 0 #x2518))))))

 (pass-if "hline-set"
	  (begin
	    (clear win)
	    (move win 1 1)
	    (hline-set win '(0 0 #x2500) 2) 
	    (refresh win)
	    (let ((x1 (in-wch win #:y 1 #:x 1))
		  (x2  (in-wch win #:y 1 #:x 2))
		  )
	      (and
	       (lset= equal? x1 '(0 0 #x2500))
	       (lset= equal? x2 '(0 0 #x2500))))))
 
 (pass-if "vline-set"
	  (begin
	    (clear win)
	    (move win 1 1)
	    (vline-set win '(0 0 #x2501) 2) 
	    (refresh win)
	    (let ((x1  (in-wch win #:y 1 #:x 1))
		  (x2  (in-wch win #:y 2 #:x 1))
		  )
	      (and
	       (lset= equal? x1 '(0 0 #x2501))
	       (lset= equal? x2 '(0 0 #x2501))))))
 
 (pass-if "hline-set #:x #:y"
	  (begin
	    (clear win)
	    (hline-set win '(0 0 #x2503) 2 #:y 1 #:x 1) 
	    (refresh win)
	    (let ((x1  (in-wch win #:y 1 #:x 1))
		  (x2  (in-wch win #:y 1 #:x 2))
		  )
	      (and
	       (lset= equal? x1 '(0 0 #x2503))
	       (lset= equal? x2 '(0 0 #x2503))))))

 (pass-if "vline-set #:y #:x"
	  (begin
	    (clear win)
	    (vline-set win '(0 0 #x2504) 2 #:y 1 #:x 1) 
	    (refresh win)
	    (let ((x1  (in-wch win #:y 1 #:x 1))
		  (x2  (in-wch win #:y 2 #:x 1))
		  )
	      (and
	       (lset= equal? x1 '(0 0 #x2504))
	       (lset= equal? x2 '(0 0 #x2504))))))

 )

(endwin)

(curses-test-end test "r037_border_set.out")


