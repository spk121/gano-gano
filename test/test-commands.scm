;;; Strict tests for (gano commands): the command registry and the
;;; standard command table.

(define-module (test commands)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-64)
  #:use-module (gano commands)
  #:use-module (gano buffer)
  #:use-module (gano frame)
  #:use-module (gano keys))

(define (buf text) (make-cbuf #:initial-text text #:tab-size 4 #:form-size 3))
(define (text-of cbuf) (string-join (cbuf-text cbuf) "\n"))
(define (pos cbuf) (cons (cbuf-line-cur cbuf) (cbuf-x-data cbuf)))
(define (ctx cbuf) (make-command-context cbuf))
(define (std name)
  (or (command-table-ref standard-commands name)
      (error "no standard command" name)))
(define (run name cbuf . values)
  (apply run-command (std name) (ctx cbuf) values))
(define (run/frame name cbuf frame . values)
  (apply run-command (std name) (make-command-context cbuf frame) values))
(define (select! cbuf line1 x1 line2 x2)
  (cbuf-set-y! cbuf line1) (cbuf-set-x! cbuf x1 'data)
  (cbuf-set-mark! cbuf)
  (cbuf-set-y! cbuf line2) (cbuf-set-x! cbuf x2 'data))
(define (noop ctx) 'ran)

(test-begin "commands")

;;; ---------------------------------------------------------------
(test-group "modes"
  (test-equal "mode values" '(main search replace replace-with goto-line write-file
                              insert-file extended help yes-no prompt)
              all-modes)
  (test-equal "text prompt modes" '(search replace replace-with goto-line write-file
                                    insert-file extended prompt)
              text-prompt-modes)
  (test-eq "MMAIN" 'main MMAIN)
  (test-eq "MSEARCH" 'search MSEARCH)
  (test-assert "mode?" (and (mode? MMAIN) (mode? MYESNO)))
  (test-assert "not a mode" (not (mode? 'nonsense)))
  (test-assert "a string is not a mode" (not (mode? "main"))))

(test-group "inputs"
  (let ([i (make-command-input 'string "Search")])
    (test-eq "kind" 'string (command-input-kind i))
    (test-equal "prompt" "Search" (command-input-prompt i))
    (test-equal "no choices" '() (command-input-choices i)))
  (let ([i (make-command-input 'choice "Pick" #:choices '("a" "b"))])
    (test-equal "choices" '("a" "b") (command-input-choices i)))
  (test-equal "kinds" '(yes-no string integer char choice) input-kinds)
  (test-eq "a text input is asked in MPROMPT" MPROMPT
           (command-input-mode (make-command-input 'string "S")))
  (test-eq "a yes-no input in MYESNO" MYESNO
           (command-input-mode (make-command-input 'yes-no "Sure?")))
  (test-eq "a given mode" MSEARCH
           (command-input-mode (make-command-input 'string "S" #:mode MSEARCH)))
  (test-error "a text input in MYESNO" #t (make-command-input 'string "S" #:mode MYESNO))
  (test-error "a text input in MMAIN" #t (make-command-input 'string "S" #:mode MMAIN))
  (test-error "a yes-no input elsewhere" #t (make-command-input 'yes-no "S" #:mode MPROMPT))
  (test-error "unknown kind" #t (make-command-input 'colour "Pick"))
  (test-error "empty prompt" #t (make-command-input 'string ""))
  (test-error "prompt not a string" #t (make-command-input 'string 'search))
  (test-error "choice without choices" #t (make-command-input 'choice "Pick"))
  (test-error "choices not strings" #t (make-command-input 'choice "Pick" #:choices '(a)))
  (test-error "choices on a non-choice" #t
              (make-command-input 'string "Pick" #:choices '("a"))))

;;; ---------------------------------------------------------------
(test-group "make-command"
  (let ([c (make-command "do-it" "Do the thing" noop
                         #:modes `((,MMAIN "^K" "A-K") ,MEXTCMD (,MSEARCH "^Y")))])
    (test-equal "name" "do-it" (command-name c))
    (test-equal "help" "Do the thing" (command-help c))
    (test-eq "procedure" noop (command-procedure c))
    (test-equal "modes in order" '(main extended search) (command-modes c))
    (test-assert "in main" (command-in-mode? c MMAIN))
    (test-assert "not in help" (not (command-in-mode? c MHELP)))
    (test-equal "shortcuts are canonical (Alt letter lower case)" '("^K" "A-k")
                (command-shortcuts c MMAIN))
    (test-equal "no shortcuts in a mode it is only named in" '() (command-shortcuts c MEXTCMD))
    (test-equal "no shortcuts in a mode it is not in" '() (command-shortcuts c MHELP))
    (test-assert "has shortcuts: not extended-only" (not (command-extended-only? c MMAIN)))
    (test-assert "extended-only" (command-extended-only? c MEXTCMD))
    (test-assert "not available: not extended-only" (not (command-extended-only? c MHELP)))
    (test-assert "needs no input" (not (command-needs-input? c)))
    (test-equal "no inputs" '() (command-inputs c)))
  (let ([c (make-command "x" "X" noop)])
    (test-equal "default mode is main, by name only" '(main) (command-modes c))
    (test-assert "default is extended-only" (command-extended-only? c MMAIN)))
  (let ([c (make-command "ask" "Asks" noop
                         #:inputs (list (make-command-input 'yes-no "Sure?")))])
    (test-assert "needs input" (command-needs-input? c)))
  (test-equal "11-character name is allowed" "abcdefghijk"
              (command-name (make-command "abcdefghijk" "h" noop)))
  (test-equal "40-character help is allowed" 40
              (string-length (command-help (make-command "a" (make-string 40 #\h) noop))))
  (test-error "12-character name" #t (make-command "abcdefghijkl" "h" noop))
  (test-error "empty name" #t (make-command "" "h" noop))
  (test-error "name with a space" #t (make-command "do it" "h" noop))
  (test-error "name not a string" #t (make-command 'do-it "h" noop))
  (test-error "41-character help" #t (make-command "a" (make-string 41 #\h) noop))
  (test-error "empty help" #t (make-command "a" "" noop))
  (test-error "procedure not a procedure" #t (make-command "a" "h" 'noop))
  (test-error "no modes" #t (make-command "a" "h" noop #:modes '()))
  (test-error "unknown mode" #t (make-command "a" "h" noop #:modes '(nowhere)))
  (test-error "mode listed twice" #t
              (make-command "a" "h" noop #:modes `((,MMAIN "^K") ,MMAIN)))
  (test-error "invalid shortcut" #t (make-command "a" "h" noop #:modes `((,MMAIN "no-such-key"))))
  (test-error "shortcut not a string" #t (make-command "a" "h" noop #:modes `((,MMAIN #\k))))
  (test-error "shortcut repeated (Alt case)" #t
              (make-command "a" "h" noop #:modes `((,MMAIN "A-u" "A-U"))))
  (test-error "inputs not command-inputs" #t (make-command "a" "h" noop #:inputs '(string))))

(test-group "reports"
  (let ([c (make-command "r" "R" noop #:report (lambda (x) (and (not x) "No")))])
    (test-equal "a report message" "No" (command-result-message c #f))
    (test-eq "no message" #f (command-result-message c #t)))
  (test-eq "no report" #f (command-result-message (make-command "r" "R" noop) #f))
  (test-eq "a report returning a non-string" #f
           (command-result-message (make-command "r" "R" noop #:report (lambda (x) 'oops)) #f))
  (test-error "report not a procedure" #t (make-command "r" "R" noop #:report "No"))
  (let ([msg (lambda (name result) (command-result-message (std name) result))])
    (test-equal "search not found" "Not found" (msg "search" #f))
    (test-eq "search found" #f (msg "search" #t))
    (test-equal "search-back" "Not found" (msg "search-back" #f))
    (test-equal "replace" "Not found" (msg "replace" #f))
    (test-equal "replace-sel" "The selection does not match" (msg "replace-sel" #f))
    (test-equal "replace-all none" "Not found" (msg "replace-all" 0))
    (test-equal "replace-all one" "Replaced 1 occurrence" (msg "replace-all" 1))
    (test-equal "replace-all many" "Replaced 3 occurrences" (msg "replace-all" 3))
    (test-eq "replace-all answered no" #f (msg "replace-all" #f))
    (test-eq "motion reports nothing" #f (msg "forward" #f))))

(test-group "key-binding-name"
  (test-equal "control" "^K" (key-binding-name "^k"))
  (test-equal "Alt upper case" "A-u" (key-binding-name "A-U"))
  (test-equal "Alt lower case" "A-u" (key-binding-name "A-u"))
  (test-equal "Alt with Shift keeps the shift" "A-S-up" (key-binding-name "A-S-up"))
  (test-equal "a key record" "A-x" (key-binding-name (make-key #:char #\X #:alt? #t)))
  (test-equal "named key" "pagedown" (key-binding-name "pagedown"))
  (test-equal "plain letters keep their case" "Q" (key-binding-name "Q")))

;;; ---------------------------------------------------------------
(test-group "run-command"
  (let* ([seen #f]
         [c (make-command "two" "Two inputs"
                          (lambda (ctx a b) (set! seen (list (command-context-cbuf ctx) a b)) 'done)
                          #:inputs (list (make-command-input 'string "A")
                                         (make-command-input 'integer "B")))]
         [b (buf "")])
    (test-eq "returns the procedure's value" 'done (run-command c (ctx b) "x" 3))
    (test-equal "procedure gets context and inputs in order" (list b "x" 3) seen)
    (test-error "too few inputs" #t (run-command c (ctx b) "x"))
    (test-error "too many inputs" #t (run-command c (ctx b) "x" 3 4))
    (test-error "wrong kind of input" #t (run-command c (ctx b) "x" "3"))
    (test-error "non-integer number" #t (run-command c (ctx b) "x" 3.5)))
  (let ([check (lambda (kind value . choices)
                 (let ([c (make-command "k" "k" (lambda (ctx v) v)
                                        #:inputs (list (apply make-command-input kind "P"
                                                              (if (null? choices) '()
                                                                  (list #:choices choices)))))])
                   (run-command c (ctx (buf "")) value)))])
    (test-eq "yes-no #f" #f (check 'yes-no #f))
    (test-error "yes-no needs a boolean" #t (check 'yes-no 'yes))
    (test-eqv "char" #\a (check 'char #\a))
    (test-error "char needs a char" #t (check 'char "a"))
    (test-equal "choice" "b" (check 'choice "b" "a" "b"))
    (test-error "choice must be one of the choices" #t (check 'choice "c" "a" "b")))
  (let ([c (make-command-context (buf "") )])
    (test-eq "context without a frame" #f (command-context-frame c))
    (test-assert "context?" (command-context? c))))

;;; ---------------------------------------------------------------
(test-group "command tables"
  (let* ([t (make-command-table)]
         [a (make-command "a" "A" noop #:modes `((,MMAIN "^A" "home") (,MSEARCH "^Y")))]
         [b (make-command "b" "B" noop #:modes `((,MMAIN "A-b") ,MHELP))]
         [c (make-command "c" "C" noop #:modes `(,MSEARCH))])
    (test-assert "table?" (command-table? t))
    (test-equal "empty" 0 (command-table-count t))
    (test-eq "add returns the command" a (command-table-add! t a))
    (command-table-add! t c)
    (command-table-add! t b)
    (test-equal "count" 3 (command-table-count t))
    (test-eq "ref" b (command-table-ref t "b"))
    (test-eq "ref of an unknown name" #f (command-table-ref t "zzz"))
    (test-eq "key ref by string" a (command-table-key-ref t MMAIN "^A"))
    (test-eq "key ref by key" a (command-table-key-ref t MMAIN (string->key "home")))
    (test-eq "key ref: Alt case-insensitive" b (command-table-key-ref t MMAIN "A-B"))
    (test-eq "key ref by a decoded key record" b
             (command-table-key-ref t MMAIN (make-key #:char #\B #:alt? #t)))
    (test-eq "key ref in another mode" a (command-table-key-ref t MSEARCH "^Y"))
    (test-eq "key unbound in that mode" #f (command-table-key-ref t MSEARCH "^A"))
    (test-eq "key unbound anywhere" #f (command-table-key-ref t MMAIN "^Z"))
    (test-equal "commands in order added" '("a" "c" "b") (map command-name (command-table-commands t)))
    (test-equal "commands in a mode" '("a" "c") (map command-name (command-table-commands t MSEARCH)))
    (test-equal "commands in a mode with no shortcuts" '("b")
                (map command-name (command-table-commands t MHELP)))
    (test-equal "names, sorted" '("a" "b" "c") (command-table-names t))
    (test-equal "names in a mode" '("a" "c") (command-table-names t MSEARCH))
    (test-equal "names in an empty mode" '() (command-table-names t MYESNO))
    (test-equal "shortcuts" '(("^A" . "a") ("home" . "a") ("A-b" . "b"))
                (map (lambda (p) (cons (car p) (command-name (cdr p))))
                     (command-table-shortcuts t MMAIN)))
    (test-error "duplicate name" #t (command-table-add! t (make-command "a" "again" noop)))
    (test-error "duplicate shortcut in a mode" #t
                (command-table-add! t (make-command "d" "D" noop #:modes `((,MSEARCH "^Y")))))
    (test-error "duplicate shortcut differing only in Alt case" #t
                (command-table-add! t (make-command "e" "E" noop #:modes `((,MMAIN "A-B")))))
    (test-equal "a failed add changes nothing" 3 (command-table-count t))
    (test-eq "a failed add binds none of its keys" #f (command-table-key-ref t MHELP "^Z"))
    (command-table-add! t (make-command "f" "F" noop #:modes `((,MHELP "^Y"))))
    (test-equal "the same key in another mode is fine" "f"
                (command-name (command-table-key-ref t MHELP "^Y")))))

(test-group "command-table-override"
  (let* ([base (make-command-table)]
         [a (make-command "a" "A" noop #:modes `((,MMAIN "^A")))]
         [b (make-command "b" "B" noop #:modes `((,MMAIN "^B")))]
         [b2 (make-command "b" "New B" noop #:modes `((,MMAIN "^N")))]
         [c (make-command "c" "C" noop)])
    (command-table-add! base a)
    (command-table-add! base b)
    (let ([t (command-table-override base (list b2 c))])
      (test-equal "base order, then the new commands" '("a" "b" "c")
                  (map command-name (command-table-commands t)))
      (test-eq "the new command replaces the old" b2 (command-table-ref t "b"))
      (test-eq "with its own keys" b2 (command-table-key-ref t MMAIN "^N"))
      (test-eq "the replaced command's keys are gone" #f (command-table-key-ref t MMAIN "^B"))
      (test-eq "others keep theirs" a (command-table-key-ref t MMAIN "^A"))
      (test-eq "base unchanged" b (command-table-ref base "b"))
      (test-equal "base count unchanged" 2 (command-table-count base)))
    (test-error "a key clash with a kept command" #t
                (command-table-override base (list (make-command "z" "Z" noop
                                                                 #:modes `((,MMAIN "^A"))))))))

(test-group "context"
  (let* ([b (buf "")]
         [c (make-command-context b #f #:editor 'my-editor)])
    (test-eq "editor" 'my-editor (command-context-editor c))
    (test-eq "cbuf" b (command-context-cbuf c))
    (test-eq "editor defaults to #f" #f (command-context-editor (make-command-context b)))))

;;; ---------------------------------------------------------------
(test-group "standard table: well formed"
  (let ([all (command-table-commands standard-commands)])
    (test-assert "has commands" (> (length all) 100))
    (test-assert "names fit" (every (lambda (c) (<= (string-length (command-name c)) 11)) all))
    (test-assert "help fits" (every (lambda (c) (<= (string-length (command-help c)) 40)) all))
    (test-equal "names unique" (length all)
                (length (delete-duplicates (map command-name all))))
    (test-assert "every command is available in main mode"
                 (every (lambda (c) (command-in-mode? c MMAIN)) all))
    (test-equal "no help string ends with a full stop" '()
                (filter (lambda (c) (string-suffix? "." (command-help c))) all))
    (test-assert "every shortcut is a valid key"
                 (every (lambda (mode)
                          (every (lambda (p) (valid-key-string? (car p)))
                                 (command-table-shortcuts standard-commands mode)))
                        all-modes))))

(test-group "standard table: nano-style shortcuts"
  (for-each (lambda (k+name)
              (let ([c (command-table-key-ref standard-commands MMAIN (car k+name))])
                (test-equal (car k+name) (cadr k+name) (and c (command-name c)))))
            '(("^K" "cut-line") ("^U" "paste") ("A-u" "undo") ("A-U" "undo") ("A-e" "redo")
              ("^W" "search") ("^\\" "replace") ("^_" "goto-line") ("A-g" "goto-line")
              ("^A" "line-start") ("^E" "line-end") ("^Y" "page-up") ("^V" "page-down")
              ("up" "prev-line") ("down" "next-line") ("left" "back") ("right" "forward")
              ("pageup" "page-up") ("pagedown" "page-down") ("home" "home") ("end" "line-end")
              ("backspace" "backspace") ("delete" "delete") ("enter" "newline") ("tab" "tab")
              ("A-\\" "first-line") ("A-/" "last-line") ("^^" "set-mark") ("A-6" "copy")
              ("A-down" "scroll-up") ("A-up" "scroll-down") ("^L" "view-cursor")))
  (test-equal "^Y in the search prompt goes to the first line" "first-line"
              (command-name (command-table-key-ref standard-commands MSEARCH "^Y")))
  (test-equal "^V at the go-to-line prompt goes to the last line" "last-line"
              (command-name (command-table-key-ref standard-commands MGOTOLINE "^V")))
  (test-eq "plain letters are not shortcuts" #f
           (command-table-key-ref standard-commands MMAIN "a"))
  (test-assert "some commands are run only by name"
               (command-extended-only? (std "sort-lines") MMAIN)))

(test-group "standard table: inputs"
  (let ([kinds (lambda (name) (map command-input-kind (command-inputs (std name))))])
    (test-equal "search asks for a string" '(string) (kinds "search"))
    (test-equal "replace asks for two strings" '(string string) (kinds "replace"))
    (test-equal "replace-all asks for confirmation too" '(string string yes-no)
                (kinds "replace-all"))
    (test-equal "goto-line asks for a number" '(integer) (kinds "goto-line"))
    (test-equal "clear asks yes/no" '(yes-no) (kinds "clear"))
    (test-equal "insert-char asks for a character" '(char) (kinds "insert-char"))
    (test-equal "final-nl offers the policies" '("always-add" "never-add" "preserve")
                (command-input-choices (car (command-inputs (std "final-nl")))))
    (test-assert "motion needs nothing" (not (command-needs-input? (std "forward"))))
    (let ([modes (lambda (name) (map command-input-mode (command-inputs (std name))))])
      (test-equal "search asks in search mode" (list MSEARCH) (modes "search"))
      (test-equal "replace asks in the replace modes" (list MREPLACE MREPLACEWITH) (modes "replace"))
      (test-equal "replace-all" (list MREPLACE MREPLACEWITH MYESNO) (modes "replace-all"))
      (test-equal "goto-line" (list MGOTOLINE) (modes "goto-line"))
      (test-equal "view-page" (list MGOTOLINE) (modes "view-page"))
      (test-equal "anything else in MPROMPT" (list MPROMPT) (modes "insert-text")))
    (test-equal "commands that ask"
                '("clear" "final-nl" "goto-col" "goto-line" "insert-char" "insert-text"
                  "replace" "replace-all" "replace-sel" "search" "search-back" "search-ci"
                  "search-word" "set-comment" "set-index" "set-line" "set-text"
                  "view-back" "view-fwd" "view-page")
                (sort (map command-name (filter command-needs-input?
                                                (command-table-commands standard-commands)))
                      string<?))))

;;; ---------------------------------------------------------------
(test-group "standard commands: motion"
  (let ([b (buf "one two\nthree\nfour\nfive\nsix")])
    (run "forward" b)            (test-equal "forward" '(0 . 1) (pos b))
    (run "line-end" b)           (test-equal "line-end" '(0 . 7) (pos b))
    (run "back" b)               (test-equal "back" '(0 . 6) (pos b))
    (run "line-start" b)         (test-equal "line-start" '(0 . 0) (pos b))
    (run "next-word" b)          (test-equal "next-word" '(0 . 4) (pos b))
    (run "prev-word" b)          (test-equal "prev-word" '(0 . 0) (pos b))
    (run "word-end" b)           (test-equal "word-end" '(0 . 3) (pos b))
    (run "next-line" b)          (test-equal "next-line keeps the column" '(1 . 3) (pos b))
    (run "prev-line" b)          (test-equal "prev-line" '(0 . 3) (pos b))
    (run "last-line" b)          (test-equal "last-line" 4 (cbuf-line-cur b))
    (run "first-line" b)         (test-equal "first-line" '(0 . 0) (pos b))
    (run "page-down" b)          (test-equal "page-down (form size 3)" 3 (cbuf-line-cur b))
    (run "page-up" b)            (test-equal "page-up" 0 (cbuf-line-cur b))
    (run "goto-line" b 3)        (test-equal "goto-line counts from 1" '(2 . 0) (pos b))
    (run "goto-line" b 99)       (test-equal "goto-line clamps" 4 (cbuf-line-cur b))
    (run "goto-line" b 1)
    (run "goto-col" b 5)         (test-equal "goto-col counts from 1" '(0 . 4) (pos b))
    (run "set-line" b 2)         (test-equal "set-line keeps the column" '(1 . 4) (pos b))
    (run "set-index" b 2)        (test-equal "set-index counts from 0" '(1 . 2) (pos b))
    (run "home" b)               (test-equal "home" '(1 . 0) (pos b))))

(test-group "standard commands: moving and deleting across lines"
  (let ([b (buf "ab\ncd")])
    (run "line-end" b)
    (run "forward" b)            (test-equal "forward wraps to the next line" '(1 . 0) (pos b))
    (run "back" b)               (test-equal "back wraps to the previous line" '(0 . 2) (pos b))
    (run "first-line" b)
    (run "back" b)               (test-equal "back at the buffer start stays" '(0 . 0) (pos b))
    (run "last-line" b) (run "line-end" b)
    (run "forward" b)            (test-equal "forward at the buffer end stays" '(1 . 2) (pos b))
    (run "line-start" b)
    (run "backspace" b)          (test-equal "backspace at a line start joins" "abcd" (text-of b))
    (test-equal "leaving the cursor at the join" '(0 . 2) (pos b))
    (run "undo" b)
    (test-equal "one undo step" "ab\ncd" (text-of b))
    (test-equal "and undo puts the cursor back" '(1 . 0) (pos b))
    (run "first-line" b) (run "line-end" b)
    (run "delete" b)             (test-equal "delete at a line end joins" "abcd" (text-of b))
    (run "line-end" b)
    (run "delete" b)             (test-equal "delete at the buffer end does nothing" "abcd" (text-of b))
    (run "line-start" b)
    (run "backspace" b)          (test-equal "backspace at the buffer start does nothing" "abcd"
                                             (text-of b))))

(test-group "standard commands: sentences and paragraphs"
  (let ([b (buf "One. Two.\n\nThree.")])
    (run "next-sent" b)  (test-equal "next-sent" '(0 . 5) (pos b))
    (run "prev-sent" b)  (test-equal "prev-sent" '(0 . 0) (pos b))
    (run "next-para" b)  (test-assert "next-para moves down" (> (cbuf-line-cur b) 0))
    (run "prev-para" b)  (test-equal "prev-para" 0 (cbuf-line-cur b))))

(test-group "standard commands: editing"
  (let ([b (buf "ab")])
    (run "line-end" b)
    (run "insert-char" b #\c)    (test-equal "insert-char" "abc" (text-of b))
    (run "insert-text" b "de")   (test-equal "insert-text" "abcde" (text-of b))
    (run "backspace" b)          (test-equal "backspace" "abcd" (text-of b))
    (run "line-start" b)
    (run "delete" b)             (test-equal "delete" "bcd" (text-of b))
    (run "forward" b)
    (run "newline" b)            (test-equal "newline" "b\ncd" (text-of b))
    (run "undo" b)               (test-equal "undo" "bcd" (text-of b))
    (run "redo" b)               (test-equal "redo" "b\ncd" (text-of b))
    (run "first-line" b)
    (run "join-lines" b)         (test-equal "join-lines" "bcd" (text-of b))
    (run "tab" b)                (test-equal "tab (tab size 4)" "    bcd" (text-of b))
    (run "del-line" b)           (test-equal "del-line keeps the only line" "    bcd" (text-of b))
    (run "line-end" b)
    (run "newline" b)
    (run "del-line" b)           (test-equal "del-line" "    bcd" (text-of b))
    (test-equal "del-line leaves one line" 1 (cbuf-line-count b)))
  (let ([b (buf "one two three")])
    (cbuf-set-x! b 4 'data)
    (run "del-word" b)           (test-equal "del-word" "one  three" (text-of b))
    (run "del-word-bk" b)        (test-equal "del-word-bk" " three" (text-of b))
    (cbuf-set-x! b 2 'data)
    (run "del-to-end" b)         (test-equal "del-to-end" " t" (text-of b))
    (cbuf-set-x! b 1 'data)
    (run "del-to-bol" b)         (test-equal "del-to-bol" "t" (text-of b)))
  (let ([b (buf "  x")])
    (run "line-end" b)
    (run "newl-indent" b)        (test-equal "newl-indent" "  x\n  " (text-of b)))
  (let ([b (buf "hello world")])
    (select! b 0 2 0 7)
    (run "del-region" b)
    (test-equal "del-region" "heorld" (text-of b))
    (test-assert "del-region clears the mark" (not (cbuf-mark-set? b)))
    (test-equal "del-region leaves the cut buffer alone" '() (cbuf-cut-buffer b))
    (run "del-region" b)
    (test-equal "del-region without a selection does nothing" "heorld" (text-of b))
    (run "undo" b)
    (test-equal "del-region is one undo step" "hello world" (text-of b)))
  (let ([b (buf "keep\nme")])
    (test-eq "clear, answered no" #f (run "clear" b #f))
    (test-equal "nothing cleared" "keep\nme" (text-of b))
    (test-eq "clear, answered yes" #t (run "clear" b #t))
    (test-equal "cleared" "" (text-of b))
    (run "set-text" b "a\nb")
    (test-equal "set-text" "a\nb" (text-of b))))

(test-group "standard commands: mark, selection, cut and paste"
  (let ([b (buf "alpha beta\ngamma")])
    (run "set-mark" b)
    (run "line-end" b)
    (test-equal "selection" "alpha beta" (cbuf-get-region-text b))
    (run "swap-mark" b)          (test-equal "swap-mark" '(0 . 0) (pos b))
    (run "clear-mark" b)         (test-assert "clear-mark" (not (cbuf-mark-set? b)))
    (run "select-all" b)         (test-equal "select-all" "alpha beta\ngamma" (cbuf-get-region-text b))
    (run "first-line" b)
    (run "select-word" b)        (test-equal "select-word" "alpha" (cbuf-get-region-text b))
    (run "clear-mark" b)
    (run "select-line" b)        (test-equal "select-line" "alpha beta" (cbuf-get-region-text b))
    (run "clear-mark" b)
    (run "line-start" b)
    (run "sel-fwd-wrd" b)        (test-assert "sel-fwd-wrd starts a selection" (cbuf-mark-set? b))
    (test-equal "sel-fwd-wrd" "alpha " (cbuf-get-region-text b))
    (run "sel-bk-word" b)        (test-equal "sel-bk-word" "" (cbuf-get-region-text b))
    (run "clear-mark" b)
    (select! b 0 0 0 5)
    (run "copy" b)
    (test-equal "copy keeps the text" "alpha beta\ngamma" (text-of b))
    (run "line-end" b)
    (run "paste" b)              (test-equal "paste" "alpha betaalpha\ngamma" (text-of b))
    (select! b 0 10 0 15)
    (run "cut" b)                (test-equal "cut" "alpha beta\ngamma" (text-of b))
    (run "first-line" b)
    (run "cut-line" b)           (test-equal "cut-line" "gamma" (text-of b))
    (run "paste" b)              (test-equal "paste a cut line" "alpha beta\ngamma" (text-of b))
    (run "first-line" b)
    (run "copy-word" b)
    (run "cut-word" b)           (test-equal "cut-word" " beta\ngamma" (text-of b))
    (set-cbuf-cut-buffer! b '("X" "Y"))
    (run "line-start" b)
    (run "paste-prev" b)         (test-equal "paste-prev" "Y beta\ngamma" (text-of b))))

(test-group "standard commands: search and replace"
  (let ([b (buf "foo Bar foo\nbar")])
    (test-eq "search found" #t (run "search" b "foo"))
    (test-equal "search selects the match" "foo" (cbuf-get-region-text b))
    (test-eq "search again finds the next" #t (run "search" b "foo"))
    (test-equal "next match" '(0 . 11) (pos b))
    (test-eq "search not found" #f (run "search" b "zzz"))
    (test-eq "search-back" #t (run "search-back" b "Bar"))
    (test-equal "search-back lands on the start" '(0 . 4) (pos b))
    (run "first-line" b)
    (test-eq "search is case-sensitive" #t (run "search" b "bar"))
    (test-equal "so it finds the second line" 1 (cbuf-line-cur b))
    (run "first-line" b)
    (test-eq "search-ci" #t (run "search-ci" b "bar"))
    (test-equal "search-ci finds Bar" '(0 . 7) (pos b))
    (run "first-line" b)
    (test-eq "search-word skips partial words" #f (run "search-word" b "ar"))
    (test-equal "and leaves the cursor" '(0 . 0) (pos b))
    (test-eq "search-word" #t (run "search-word" b "bar"))
    (test-equal "search-word finds the whole word" '(1 . 3) (pos b)))
  (let ([b (buf "a cat, a cat")])
    (test-eq "replace" #t (run "replace" b "cat" "dog"))
    (test-equal "replaced the first" "a dog, a cat" (text-of b))
    (test-eq "replace with no match" #f (run "replace" b "cow" "dog"))
    (run "first-line" b)
    (test-eq "replace-all, answered no" #f (run "replace-all" b "a" "the" #f))
    (test-equal "nothing replaced" "a dog, a cat" (text-of b))
    (test-equal "replace-all counts" 3 (run "replace-all" b "a" "A" #t))
    (test-equal "replaced all" "A dog, A cAt" (text-of b))
    (select! b 0 0 0 1)
    (test-eq "replace-sel matching" #t (run "replace-sel" b "A" "One"))
    (test-equal "replace-sel" "One dog, A cAt" (text-of b))
    (test-eq "replace-sel not matching" #f (run "replace-sel" b "x" "y"))))

(test-group "standard commands: lines"
  (let ([b (buf "1\n2\n3")])
    (run "dup-line" b)           (test-equal "dup-line" "1\n1\n2\n3" (text-of b))
    (run "goto-line" b 3)
    (run "line-up" b)            (test-equal "line-up" "1\n2\n1\n3" (text-of b))
    (run "line-down" b)          (test-equal "line-down" "1\n1\n2\n3" (text-of b))
    (run "swap-prev" b)          (test-equal "swap-prev" "1\n2\n1\n3" (text-of b))
    (run "swap-next" b)          (test-equal "swap-next" "1\n1\n2\n3" (text-of b)))
  (let ([b (buf "abc")])
    (cbuf-set-x! b 1 'data)
    (run "swap-char-b" b)        (test-equal "swap-char-b" "bac" (text-of b))
    (cbuf-set-x! b 0 'data)
    (run "swap-char-f" b)        (test-equal "swap-char-f" "abc" (text-of b)))
  (let ([b (buf "c\na\nb")])
    (select! b 0 0 2 1)
    (run "sort-lines" b)         (test-equal "sort-lines" "a\nb\nc" (text-of b)))
  (let ([b (buf "  hi  ")])
    (set-cbuf-limit-type! b 'presentation)
    (set-cbuf-home-pos! b 0)
    (set-cbuf-limit-pos! b 10)
    (run "center" b)             (test-equal "center" "    hi" (text-of b))))

(test-group "standard commands: indentation, comments and case"
  (let ([b (buf "x\ny")])
    (run "indent" b)             (test-equal "indent" "    x\ny" (text-of b))
    (run "outdent" b)            (test-equal "outdent" "x\ny" (text-of b))
    (select! b 0 0 1 1)
    (run "indent-reg" b)         (test-equal "indent-reg" "    x\n    y" (text-of b))
    (run "outdent-reg" b)        (test-equal "outdent-reg" "x\ny" (text-of b)))
  (let ([b (buf "  a\n      b")])
    (select! b 0 0 1 1)
    (run "align" b)              (test-equal "align" "  a\n  b" (text-of b)))
  (let ([b (buf "x\ny")]
        [saved (cbuf-get-comment-string)])
    (run "set-comment" b "#")
    (test-equal "set-comment" "#" (cbuf-get-comment-string))
    (run "comment" b)            (test-equal "comment" "# x\ny" (text-of b))
    (run "undo" b)
    (select! b 0 0 1 1)
    (run "comment-reg" b)        (test-equal "comment-reg" "# x\n# y" (text-of b))
    (run "uncomment" b)          (test-equal "uncomment" "x\ny" (text-of b))
    (cbuf-set-comment-string! saved))
  (let ([b (buf "hello world")])
    (select! b 0 0 0 11)
    (run "upcase" b)             (test-equal "upcase" "HELLO WORLD" (text-of b))
    (select! b 0 0 0 11)
    (run "downcase" b)           (test-equal "downcase" "hello world" (text-of b))
    (select! b 0 0 0 11)
    (run "titlecase" b)          (test-equal "titlecase" "Hello World" (text-of b))
    (select! b 0 0 0 11)
    (run "downcase" b)
    (select! b 0 0 0 11)
    (run "capitalize" b)         (test-equal "capitalize" "Hello World" (text-of b))))

(test-group "standard commands: whitespace and final newline"
  (let ([b (buf "        x\n\ty")])
    (run "tabify" b)             (test-equal "tabify" "\t\tx\n\ty" (text-of b))
    (run "untabify" b)           (test-equal "untabify" "        x\n    y" (text-of b))
    (select! b 0 0 0 1)
    (run "tabify-reg" b)         (test-equal "tabify-reg" "\t\tx\n    y" (text-of b))
    (select! b 0 0 0 1)
    (run "untabify-rg" b)        (test-equal "untabify-rg" "        x\n    y" (text-of b)))
  (let ([b (buf "a  \n  b  ")])
    (run "trim-trail" b)         (test-equal "trim-trail" "a\n  b" (text-of b)))
  (let ([b (buf "<  a  >")])
    (select! b 0 1 0 6)
    (run "trim-region" b)        (test-equal "trim-region" "<a>" (text-of b)))
  (let ([b (buf "a")])
    (run "final-nl" b "never-add")
    (test-eq "final-nl sets the policy" 'never-add (cbuf-final-newline-policy b))
    (test-eq "and applies it" #f (cbuf-final-newline? b))
    (test-error "final-nl only takes a policy" #t (run "final-nl" b "sometimes"))
    (set-cbuf-final-newline-policy! b 'always-add)
    (run "apply-fnl" b)
    (test-eq "apply-fnl" #t (cbuf-final-newline? b))))

(test-group "standard commands: the view"
  (let* ([b (buf (string-join (map number->string (iota 20)) "\n"))]
         [f (make-frame 10 5)])
    (run/frame "scroll-up" b f)     (test-equal "scroll-up moves the view down" 1 (frame-y-start f))
    (run/frame "scroll-down" b f)   (test-equal "scroll-down" 0 (frame-y-start f))
    (run/frame "scroll-down" b f)   (test-equal "scroll-down stops at the top" 0 (frame-y-start f))
    (run/frame "scroll-left" b f)   (test-equal "scroll-left" 1 (frame-x-start f))
    (run/frame "scroll-rt" b f)     (test-equal "scroll-rt" 0 (frame-x-start f))
    (run/frame "view-next" b f)     (test-equal "view-next (form size 3)" 3 (frame-y-start f))
    (run/frame "view-prev" b f)     (test-equal "view-prev" 0 (frame-y-start f))
    (run/frame "view-page" b f 3)   (test-equal "view-page counts from 1" 6 (frame-y-start f))
    (run/frame "view-fwd" b f 2)    (test-equal "view-fwd" 12 (frame-y-start f))
    (run/frame "view-back" b f 1)   (test-equal "view-back" 9 (frame-y-start f))
    (cbuf-goto-line! b 0)
    (run/frame "view-cursor" b f)
    (test-equal "view-cursor brings the cursor into view" 0 (frame-y-start f))
    (test-error "a view command without a frame" #t (run "scroll-up" b)))
  (let* ([b (buf (string-join (map number->string (iota 20)) "\n"))]
         [f (make-frame 4 5)])
    (run/frame "scroll-up" b f)
    (test-equal "scrolling past the cursor takes it along" 1 (cbuf-line-cur b))
    (run/frame "view-next" b f)
    (test-equal "paging too (pages are 3 lines)" 3 (cbuf-line-cur b))
    (cbuf-goto-line! b 8)
    (run/frame "scroll-down" b f)
    (test-equal "upward: the cursor stays on the bottom line" '(2 . 6)
                (cons (frame-y-start f) (cbuf-line-cur b)))
    (run/frame "scroll-up" b f)
    (test-equal "a cursor still in view stays put" 6 (cbuf-line-cur b))
    (cbuf-set-x! b 1 'data)
    (run/frame "scroll-left" b f) (run/frame "scroll-left" b f)
    (test-equal "sideways: the cursor moves to the left edge (end of the short line)" 1
                (cbuf-x-cell b))
    (run/frame "view-page" b f 1)
    (test-equal "view-page" '(0 . 4) (cons (frame-y-start f) (cbuf-line-cur b)))))

(test-group "standard commands: every command runs"
  ;; Run every command that asks nothing on a small buffer with a
  ;; selection and a frame; none may raise an error.
  (for-each
   (lambda (c)
     (let ([b (buf "Alpha beta.  Gamma\n\n  delta\tepsilon  \nzeta")]
           [f (make-frame 20 3)])
       (set-cbuf-limit-type! b 'presentation)
       (set-cbuf-home-pos! b 0)
       (set-cbuf-limit-pos! b 30)
       (select! b 0 2 2 3)
       (test-assert (command-name c)
                    (begin (run-command c (make-command-context b f)) #t))))
   (remove command-needs-input? (command-table-commands standard-commands))))

(test-end "commands")
