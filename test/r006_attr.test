;;;; -*- Mode: scheme; -*-
;;;; r006_attr.test --- test suite for curses's attr

(define-module (test r006_attr)
  #:use-module (test lib)
  #:use-module (srfi srfi-1)
  #:use-module (gucu curses-raw))


(with-test-prefix "attr"
		  
		  ;; clear all attributes
		  (pass-if "standend #1"
			   (begin
			     (clear)
			     (standend)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))
		  ;; add them one by one
		  (pass-if "attron *a-blink*"
			   (begin
			     (attron *a-blink*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? *a-blink* (logand *a-attributes* x2)))))

		  (pass-if "attron *a-bold*"
			   (begin
			     (attron *a-bold*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*)
				       (logand *a-attributes* x2)))))

		  (pass-if "attron *a-dim*"
			   (begin
			     (attron *a-dim*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*
					       *a-dim*)
				       (logand *a-attributes* x2)))))

		  (pass-if "attron *a-invis*"
			   (begin
			     (attron *a-invis*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*
					       *a-dim*
					       *a-invis*)
				       (logand *a-attributes* x2)))))

		  (pass-if "attron *a-protect*"
			   (begin
			     (attron *a-protect*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*
					       *a-dim*
					       *a-invis*
					       *a-protect*)
				       (logand *a-attributes* x2)))))
		  
		  (pass-if "attron *a-reverse*"
			   (begin
			     (attron *a-reverse*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*
					       *a-dim*
					       *a-invis*
					       *a-protect*
					       *a-reverse*)
				       (logand *a-attributes* x2)))))
		  
		  (pass-if "attron *a-standout*"
			   (begin
			     (attron *a-standout*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*
					       *a-dim*
					       *a-invis*
					       *a-protect*
					       *a-reverse*
					       *a-standout*)
				       (logand *a-attributes* x2)))))
		  
		  (pass-if "attron *a-underline*"
			   (begin
			     (attron *a-underline*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*
					       *a-dim*
					       *a-invis*
					       *a-protect*
					       *a-reverse*
					       *a-standout*
					       *a-underline*)
				       (logand *a-attributes* x2)))))
		  ;; take one away
		  (pass-if "attroff *a-underline*"
			   (begin
			     (attroff *a-underline*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (logior *a-blink*
					       *a-bold*
					       *a-dim*
					       *a-invis*
					       *a-protect*
					       *a-reverse*
					       *a-standout*)
				       (logand *a-attributes* x2)))))
		  ;; set the attribute to be blink* alone
		  (pass-if "attrset *a-blink*"
			   (begin
			     (attrset *a-blink*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? *a-blink* (logand *a-attributes* x2)))))

		  ;; set it to STANDOUT alone
		  (pass-if "standout"
			   (begin
			     (clear)
			     (standout)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? *a-standout* (logand *a-attributes* x2)))))

		  ;; reset via *a-normal*
		  (pass-if "attrset *a-normal*"
			   (begin
			     (clear)
			     (attrset *a-normal*)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))

		  ;; add color via color-set
		  (pass-if "color-set 1"
			   (begin
			     (clear)
			     (color-set 1 #f)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? (color-pair 1) (logand *a-color* x2)))))


		  (pass-if "standend #2"
			   (begin
			     (clear)
			     (standend)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))
		  
		  (pass-if "attr-on *a-bold*"
			   (begin
			     (clear)
			     (attr-on *a-bold* #f)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? *a-bold* (logand *a-attributes* x2)))))

		  (pass-if "attr-off *a-bold*"
			   (begin
			     (clear)
			     (attr-off *a-bold* #f)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (mvinch 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))

		  (pass-if "attr-set and attr-get *a-underline* color-pair1"
			   (begin
			     (clear)
			     (attr-set *a-underline* 1 #f)
			     (mvaddstr 0 0 "x")
			     (refresh)
			     (let ((x2 (attr-get)))
			       (and
				(equal? (car x2) (logior *a-underline* (color-pair 1)))
				;; FIXME: should it be this? (equal? (car x2) *a-underline*)
				(equal? (cadr x2) 1)))))

		  (pass-if "chgat"
			   (begin
			     (clear)
			     (attrset *a-normal*)
			     (mvaddstr 0 0 "xx")
			     (refresh)
			     (move 0 0)
			     (chgat 2 *a-bold* 1 #f)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 0 1)))
			       (and
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x1))
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x2))))))


		  (pass-if "mvchgat"
			   (begin
			     (clear)
			     (attrset *a-normal*)
			     (mvaddstr 0 0 "xx")
			     (refresh)
			     (mvchgat 0 0 2 *a-bold* 1 #f)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 0 1)))
			       (and
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x1))
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x2))))))





		  )

(define win (newwin 5 10 5 5))

(with-test-prefix "wattr"
		  
		  ;; clear all attributes
		  (pass-if "wstandend #1"
			   (begin
			     (wclear win)
			     (wstandend win)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))
		  ;; add one
		  (pass-if "wattron *a-blink*"
			   (begin
			     (wattron win *a-blink*)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? *a-blink* (logand *a-attributes* x2)))))

		  ;; take one away
		  (pass-if "wattroff *a-blink*"
			   (begin
			     (wattroff win *a-blink*)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? *a-normal* 
				       (logand *a-attributes* x2)))))

		  ;; set the attribute to be blink* alone
		  (pass-if "wattrset *a-blink*"
			   (begin
			     (wattrset win *a-blink*)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? *a-blink* (logand *a-attributes* x2)))))

		  ;; set it to STANDOUT alone
		  (pass-if "wstandout"
			   (begin
			     (wclear win)
			     (wstandout win)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? *a-standout* (logand *a-attributes* x2)))))

		  ;; reset via *a-normal*
		  (pass-if "wattrset *a-normal*"
			   (begin
			     (wclear win)
			     (wattrset win *a-normal*)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win )
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))

		  ;; add color via color-set
		  (pass-if "color-set 1"
			   (begin
			     (wclear win)
			     (wcolor-set win 1 #f)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? (color-pair 1) (logand *a-color* x2)))))


		  (pass-if "wstandend #2"
			   (begin
			     (wclear win)
			     (wstandend win)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))
		  
		  (pass-if "wattr-on *a-bold*"
			   (begin
			     (wclear win)
			     (wattr-on win *a-bold* #f)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? *a-bold* (logand *a-attributes* x2)))))

		  (pass-if "wattr-off *a-bold*"
			   (begin
			     (wclear win)
			     (wattr-off win *a-bold* #f)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (mvwinch win 0 0)))
			       (equal? 0 (logand *a-attributes* x2)))))

		  (pass-if "attr-set and attr-get *a-underline* color-pair1"
			   (begin
			     (wclear win)
			     (wattr-set win *a-underline* 1 #f)
			     (mvwaddstr win 0 0 "x")
			     (wrefresh win)
			     (let ((x2 (wattr-get win)))
			       (and
				(equal? (car x2) (logior *a-underline* (color-pair 1)))
				;; FIXME: should it be this? (equal? (car x2) *a-underline*)
				(equal? (cadr x2) 1)))))

		  (pass-if "wchgat"
			   (begin
			     (wclear win)
			     (wattrset win *a-normal*)
			     (mvwaddstr win 0 0 "xx")
			     (wrefresh win)
			     (wmove win 0 0)
			     (wchgat win 2 *a-bold* 1 #f)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 0 1)))
			       (and
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x1))
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x2))))))


		  (pass-if "mvwchgat"
			   (begin
			     (wclear win)
			     (wattrset win *a-normal*)
			     (mvwaddstr win 0 0 "xx")
			     (wrefresh win)
			     (mvwchgat win 0 0 2 *a-bold* 1 #f)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 0 1)))
			       (and
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x1))
				(equal? (logior *a-bold* (color-pair 1)) (logand *a-attributes* x2))))))


		  )



(delwin win)
(refresh)
