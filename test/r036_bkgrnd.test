;;;; -*- Mode: scheme; -*-
;;;; r036_bkgrnd.test --- test suite for curses's background functions

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(define win (initscr))

(define period (char->integer #\.))
(define plus (char->integer #\+))
(define space (char->integer #\sp))

(with-test-prefix 
 "bkgrnd"
		  
 (pass-if "bkgrnd"
	  (begin
	    (addstr win "This is a string")
	    (bkgrnd win (list A_BOLD 0 period))
	    (move win 1 0)
	    (addstr win "This is a new string" #:y 1 #:x 0)
	    (refresh win)
	    ;; (sleep 2)
	    (let ((x1 (in-wch win #:y 0 #:x 4)) ; Space between "This" and "is"
		  (x2 (in-wch win #:y 1 #:x 4)))
	      (begin
		(bkgrnd win (list A_NORMAL 0 space)) ; clear bkgd
		(clear win)
		(refresh win)
		(and
		 (lset= eqv? (list A_BOLD 0 period) x1)
		 (lset= eqv? (list A_BOLD 0 period) x2))))))
		  
 (pass-if "bkgdset"
	  (begin
	    (standend win)
	    (addstr win "This is a string" #:y 0 #:x 0)
	    (bkgrndset win (list A_DIM 1 plus))
	    (addstr win "This is another string" #:y 1 #:x 0)
	    (refresh win)
	    ;; (sleep 2)
	    (let ((x1 (in-wch win #:y 0 #:x 4))
		  (x2 (in-wch win #:y 1 #:x 4)))
	      (begin
		(bkgrnd win (list A_NORMAL 0 space)) ; clear bkgd
		(clear win)
		(refresh win)
		(and
		 (lset= equal? (list A_NORMAL 0 space) x1)
		 (lset= equal? (list A_DIM 1 plus) x2)))))))
		  
(endwin)

(curses-test-end test "r036_bkgrnd.out")		  
