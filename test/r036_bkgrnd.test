;;;; -*- Mode: scheme; -*-
;;;; r036_bkgrnd.test --- test suite for curses's background functions

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(initscr)

(define period (char->integer #\.))
(define plus (char->integer #\+))
(define space (char->integer #\sp))


(clear)
(standend)

(with-test-prefix "bkgrnd"
		  
		  (pass-if "bkgrnd"
			   (begin
			     (mvaddstr 0 0 "This is a string")
			     (bkgrnd (list A_BOLD 0 period))
			     (mvaddstr 1 0 "This is a new string")
			     (refresh)
			     ;; (sleep 2)
			     (let ((x1 (mvin-wch 0 4)) ;Loc of space between "This" and "is"
				   (x2 (mvin-wch 1 4)))
			       (begin
				 (bkgrnd (list A_NORMAL 0 space)) ; clear bkgd
				 (clear)
				 (refresh)
				 (and
				  (lset= eqv? (list A_BOLD 0 period) x1)
				  (lset= eqv? (list A_BOLD 0 period) x2))))))
		  
		  (pass-if "bkgdset"
			   (begin
			     (standend)
			     (mvaddstr 0 0 "This is a string")
			     (bkgrndset (list A_DIM 1 plus))
			     (mvaddstr 1 0 "This is another string")
			     (refresh)
			     ;; (sleep 2)
			     (let ((x1 (mvin-wch 0 4))
				   (x2 (mvin-wch 1 4)))
			       (begin
				 (bkgrnd (list A_NORMAL 0 space)) ; clear bkgd
				 (clear)
				 (addstr (format #f "~a~%" x1))
				 (addstr (format #f "~a~%" x2))
				 (refresh)
				 ;; (sleep 2)
				 (and
				  (lset= equal? (list A_NORMAL 0 space) x1)
				  (lset= equal? 
					 (list A_DIM 1 plus) 
					 x2)))))))
		  
; (define win (newwin 5 10 5 5))

