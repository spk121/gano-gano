;;;; -*- Mode: scheme; -*-
;;;; r036_bkgrnd.test --- test suite for curses's background functions

(define-module (test r036_bkgrnd)
  #:use-module (test lib)
  #:use-module (gucu raw)
  #:use-module (srfi srfi-1))

(define period (char->integer #\.))
(define plus (char->integer #\+))
(define space (char->integer #\sp))


(clear)
(standend)

(with-test-prefix "bkgrnd"
		  
		  (pass-if "bkgrnd"
			   (begin
			     (mvaddstr 0 0 "This is a string")
			     (bkgrnd (list *a-bold* 0 period))
			     (mvaddstr 1 0 "This is a new string")
			     (refresh)
			     (sleep 2)
			     (let ((x1 (mvin-wch 0 4)) ;Loc of space between "This" and "is"
				   (x2 (mvin-wch 1 4)))
			       (begin
				 (bkgrnd (list *a-normal* 0 space)) ; clear bkgd
				 (clear)
				 (refresh)
				 (and
				  (lset= eqv? (list *a-bold* 0 period) x1)
				  (lset= eqv? (list *a-bold* 0 period) x2))))))
		  
		  (pass-if "bkgdset"
			   (begin
			     (standend)
			     (mvaddstr 0 0 "This is a string")
			     (bkgrndset (list *a-dim* 1 plus))
			     (mvaddstr 1 0 "This is another string")
			     (refresh)
			     (sleep 2)
			     (let ((x1 (mvin-wch 0 4))
				   (x2 (mvin-wch 1 4)))
			       (begin
				 (bkgrnd (list *a-normal* 0 space)) ; clear bkgd
				 (clear)
				 (addstr (format #f "~a~%" x1))
				 (addstr (format #f "~a~%" x2))
				 (refresh)
				 (sleep 2)
				 (and
				  (lset= equal? (list *a-normal* 0 space) x1)
				  (lset= equal? 
					 (list *a-dim* 1 plus) 
					 x2)))))))
		  
