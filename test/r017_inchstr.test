;;;; -*- Mode: scheme; -*-
;;;; r017_inchstr.test --- test suite for curses's inchstr

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(initscr)

(define hello (map char->integer (string->list "hello")))
(define he (map char->integer (string->list "he")))
(define hello-bold (map (lambda (x) 
			  (logior A_BOLD (char->integer x)))
			(string->list "hello")))
(define he-bold (map (lambda (x) 
		       (logior A_BOLD (char->integer x)))
		     (string->list "he")))

(with-test-prefix "inchstr"
		  
		  
		  (pass-if "inchnstr"
			   (begin
			     (clear)
			     (addchstr hello #:y 0 #:x 0)
			     (refresh)
			     (move 0 0)
			     (let ((w2 (inchnstr 2)))
			       (lset= equal? he w2))))
		  
		  
		  (pass-if "mvinchnstr"
			   (begin
			     (clear)
			     (addchstr hello-bold #:y 1 #:x 0)
			     (refresh)
			     (let ((x2 (mvinchnstr 1 0 2)))
			       (equal? he-bold x2)))))

(define win (newwin 5 10 5 5))

(with-test-prefix "inchstr"
		  
		  (pass-if "winchnstr"
			   (begin
			     (wclear win)
			     (addchstr hello #:win win #:y 0 #:x 0)
			     (wrefresh win)
			     (wmove win 0 0)
			     (let ((w2 (winchnstr win 2)))
			       (lset= equal? he w2))))
		  
		  (pass-if "mvwinchnstr"
			   (begin
			     (wclear win)
			     (addchstr hello-bold #:win win #:y 1 #:x 0)
			     (wrefresh win)
			     (let ((x2 (mvwinchnstr win 1 0 2)))
			       (equal? he-bold x2)))))

(delwin win)
(refresh)

(endwin)

(curses-test-end test "r016_inch.out")
