;;;; -*- Mode: scheme; -*-
;;;; r013_getch.test --- test suite for curses's getch

(define-module (test r013_getch)
  #:use-module (test lib)
  #:use-module (srfi srfi-1)
  #:use-module (gucu raw))


(cbreak)
(echo)

(define win (newwin 5 10 5 5))

;; Should be able to get characters from the keyboard
(with-test-prefix "getch"
		  
		  (pass-if "ungetch / getch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (ungetch x1)
			       (equal? (getch) x1))))


		  (pass-if "wgetch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (ungetch x1)
			       (equal? (wgetch win) x1))))


		  (pass-if "mvgetch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (begin
				 (clear)
				 (ungetch x1)
				 (let ((x2 (mvgetch 2 2))
				       (pos (getyx (stdscr))))
				   (and
				    (equal? x1 x2)
				    (lset= eqv? pos '(2 2))))))))
					  
		  (pass-if "mvwgetch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (begin
				 (wclear win)
				 (ungetch x1)
				 (let ((x2 (mvwgetch win 2 2))
				       (pos (getyx win)))
				   (and
				    (equal? x1 x2)
				    (lset= eqv? pos '(2 2)))))))))

(delwin win)
(refresh)

