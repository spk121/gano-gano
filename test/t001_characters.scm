(begin-test-case)

(add-string "Test 1: characters and attributes...\n" #:window right-window)
(refresh #:window right-window)

(add-string "7-bit characters\n" #:window right-window)
(refresh #:window right-window)
(add-character #\sp #:window left-window #:x 0 #:y 0)
(let loop ((x 33))
  (if (< x 128)
      (begin
	(add-character x #:window left-window)
	(loop (+ x 1)))))
(refresh #:window left-window)

(add-string "8-bit characters\n" #:window right-window)
(refresh #:window right-window)
(add-character #\newline #:window left-window)
(let loop ((x (+ 32 128)))
  (if (< x 256)
      (begin
	(add-character x #:window left-window)
	(loop (+ 1 x)))))
(refresh #:window left-window)

(add-string "ACS symbols\n" #:window right-window)
(refresh #:window right-window)
(add-character #\newline #:window left-window)
(define acs (list 
	    (acs-block)
	    (acs-board)
	    (acs-btee)
	    (acs-bullet)
	    (acs-ckboard)
	    (acs-darrow)
	    (acs-degree)
	    (acs-diamond)
	    (acs-gequal)
	    (acs-hline)
	    (acs-lantern)
	    (acs-larrow)
	    (acs-lequal)
	    (acs-llcorner)
	    (acs-lrcorner)
	    (acs-ltee)
	    (acs-nequal)
	    (acs-pi)
	    (acs-plminus)
	    (acs-plus)
	    (acs-rarrow)
	    (acs-rtee)
	    (acs-s1)
	    (acs-s3)
	    (acs-s7)
	    (acs-s9)
	    (acs-sterling)
	    (acs-ttee)
	    (acs-uarrow)
	    (acs-ulcorner)
	    (acs-urcorner)
	    (acs-vline)
))
(let loop ((acs acs))
  (if (not (null? acs))
      (begin
	(add-character (car acs) #:window left-window)
	(loop (cdr acs)))))
(refresh #:window left-window)

(end-test-case)