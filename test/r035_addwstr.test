;;;; -*- Mode: scheme; -*-
;;;; r035_addwstr.test --- test suite for curses's addwstr

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(define win (initscr))

(define (string->wstring str)	
  (map char->integer (string->list str)))

(with-test-prefix 
 "addwstr"
 
 (pass-if "addwstr"
	  (begin
	    (clear win)
	    (move win 0 0)
	    (addwstr win (string->wstring "hello"))
	    (refresh win)
	    (let ((w2 (innwstr win 6 #:y 0 #:x 0)))
	      (lset= eqv?  
		     (string->wstring "hello") 
		     (take w2 (string-length "hello"))))))


 (pass-if "addwstr #:n"
	  (begin
	    (clear win)
	    (move win 0 0)
	    (addwstr win (string->wstring "hello") #:n 2)
	    (refresh win)
	    (let ((w2 (innwstr win 6 #:y 0 #:x 0)))
	      (lset= eqv? 
		     (string->wstring "he")
		     (take w2 (string-length "he"))))))

 (pass-if "addwstr #:y #:x"
	  (begin
	    (clear win)
	    (addwstr win (string->wstring "bold") #:y 1 #:x 0)
	    (refresh win)
	    (let ((x2 (innwstr win 6 #:y 1 #:x 0)))
	      (lset= eqv? 
		     (string->wstring "bold") 
		     (take x2 (string-length "bold"))))))

 (pass-if "addwstr #:y #:x #:n"
	  (begin
	    (clear win)
	    (addwstr win (string->wstring "bold") #:y 1 #:x 0 #:n 2)
	    (refresh win)
	    (let ((x2 (innwstr win 6 #:y 1 #:x 0)))
	      (lset= eqv? 
		     (string->wstring "bo")
		     (take x2 (string-length "bo")))))))

(endwin)

(curses-test-end test "r035_addwstr.out")		  
