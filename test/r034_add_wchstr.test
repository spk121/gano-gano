;;;; -*- Mode: scheme; -*-
;;;; r034_add_wchstr.test --- test suite for curses's add_wchstr functions

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(initscr)


(define (string->cstring str attrib)
  (map (lambda (x)
	 (list attrib 0 (char->integer x)))
       (string->list str)))

(define hello (string->cstring "hello" A_NORMAL))
(define he (string->cstring "he" A_NORMAL))
(define hello-bold (string->cstring "hello" A_BOLD))
(define he-bold (string->cstring "he" A_BOLD))

(with-test-prefix "add-wchstr"
		  
		  (pass-if "add-wchstr"
			   (begin
			     (clear)
			     (move 0 0)
			     (add-wchstr hello)
			     (refresh)
			     (let ((w2 (mvin-wchnstr 0 0 10)))
			       (lset= equal? hello (list-head w2 (length hello))))))
		  
		  (pass-if "add-wchstr #:n"
			   (begin
			     (clear)
			     (move 0 0)
			     (add-wchstr hello #:n 2)
			     (refresh)
			     (let ((w2 (mvin-wchnstr 0 0 10)))
			       (lset= equal? he (list-head w2 (length he))))))
		  
		  (pass-if "add-wchstr #:y #:x"
			   (begin
			     (clear)
			     (add-wchstr hello-bold #:y 1 #:x 0)
			     (refresh)
			     (let ((x2 (mvin-wchnstr 1 0 10)))
			       (equal? hello-bold (list-head x2 (length hello-bold))))))
		  
		  (pass-if "add-wchstr #:y #:x #:n"
			   (begin
			     (clear)
			     (add-wchstr hello-bold #:y 1 #:x 0 #:n 2)
			     (refresh)
			     (let ((x2 (mvin-wchnstr 1 0 10)))
			       (equal? he-bold (list-head x2 (length he-bold)))))))

(define win (newwin 5 10 5 5))

(with-test-prefix "wadd-wchstr"
		  
		  (pass-if "add-wchstr #:win"
			   (begin
			     (wclear win)
			     (wmove win 0 0)
			     (add-wchstr hello #:win win)
			     (wrefresh win)
			     (let ((w2 (mvwin-wchnstr win 0 0 10)))f
				  (lset= equal? hello (list-head w2 (length hello))))))
			   
		  (pass-if "add-wchstr #:win #:n"
			   (begin
			     (wclear win)
			     (wmove win 0 0)
			     (add-wchstr hello #:win win #:n 2)
			     (wrefresh win)
			     (let ((w2 (mvwin-wchnstr win 0 0 10)))
			       (lset= equal? he (list-head w2 (length he))))))
		  
		  (pass-if "add-wchstr #:win #:x #:y"
			   (begin
			     (wclear win)
			     (add-wchstr hello-bold #:win win #:y 1 #:x 0)
			     (wrefresh win)
			     (let ((x2 (mvwin-wchnstr win 1 0 10)))
			       (equal? hello-bold (list-head x2 (length hello-bold))))))
		  
		  (pass-if "add-wchstr #:win #:n #:y #:x"
			   (begin
			     (wclear win)
			     (add-wchstr hello-bold #:win win #:n 2 #:y 1 #:x 0)
			     (wrefresh win)
			     (let ((x2 (mvwin-wchnstr win 1 0 10)))
			       (equal? he-bold (list-head x2 (length he-bold)))))))

(delwin win)
(refresh)

(endwin)

(curses-test-end test "r034_add_wchstr.out")		  
