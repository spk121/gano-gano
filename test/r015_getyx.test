;;;; -*- Mode: scheme; -*-
;;;; r015_getyx.test --- test suite for curses's position reporting functions

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(initscr)

(define win (newwin 5 6 7 8))
(define win2 (subwin win 2 2 8 9))


;; Should be able to determine where the cursor is
(with-test-prefix "getyx"
		  
		  (pass-if "setup"
			   (begin
			     (clear)
			     (refresh)
			     (box win 0 0)
			     (box win2 0 0)
			     (touchwin win)
			     (wrefresh win2)
			     (wrefresh win)
			     #t))

		  (pass-if "getyx"
			   (begin
			     (wmove win 2 1)
			     (refresh)
			     (lset= eqv? '(2 1) (getyx win))))

		  (pass-if "getparyx"
			   (lset= eqv? (list (- 8 7) (- 9 8)) (getparyx win2)))

		  (pass-if "getbegyx"
			   (lset= eqv? '(7 8) (getbegyx win)))

		  (pass-if "getmaxyx"
			   (lset= eqv? '(5 6) (getmaxyx win))))

(delwin win2)
(touchwin win)
(wrefresh win)
(delwin win)
(refresh)

(endwin)

(curses-test-end test "r015_getyx.out")
