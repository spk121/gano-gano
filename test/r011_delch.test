;;;; -*- Mode: scheme; -*-
;;;; r011_delch.test --- test suite for curses's character deletion

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(initscr)

;; Should be able to delete characters
(with-test-prefix "delch"
		  
		  (pass-if "delch"
			   (begin
			     (clear)
			     (addstr "abc" #:y 0 #:x 0)
			     (move 0 1)
			     (delch)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 0 1)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\c))))))
		  
		  (pass-if "mvdelch"
			   (begin
			     (clear)
			     (addstr "abc" #:y 0 #:x 0)
			     (mvdelch 0 1)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 0 1)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\c)))))))

(define win (newwin 5 10 5 5))

(with-test-prefix "wdelch"
		  
		  (pass-if "wdelch"
			   (begin
			     (wclear win)
			     (addstr "abc" #:win win #:y 0 #:x 0)
			     (wmove win 0 1)
			     (wdelch win)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 0 1)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\c))))))
		  
		  (pass-if "mvwdelch"
			   (begin
			     (wclear win)
			     (addstr "abc" #:win win #:y 0 #:x 0)
			     (mvwdelch win 0 1)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 0 1)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\c)))))))


(delwin win)
(refresh)

(endwin)

(curses-test-end test "r011_delch.out")
