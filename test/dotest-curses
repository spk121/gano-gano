#!/bin/sh

# Script for running individual tests within the libtool framework,
# possibly using the debugger or valgrind

case $1 in
    run)
	# We are just running the test
	mode=run
	;;
    debug|gdb)
	# We are running the test in the debugger
	mode=debug
	;;
    tui)
	# We are running the test in the TUI debugger
	mode=tui
	;;
    grind|valgrind)
	# We are running the test in valgrind
	mode=valgrind
	;;
    *)
	echo Usage $0 [run\|debug\|valgrind] sometest.test
	exit 1;
esac

# The second argument should be a test name
if [ -z $2 ]; then
    echo Usage $0 [run\|debug\|valgrind] sometest.test
    exit 1;
fi

if [ ! -f $2 ]; then 
    echo $2 is not a test file
    echo Usage $0 [run\|debug\|valgrind] sometest.test
    exit 1;
fi

# Make a path to the guile modules
ln -s ../src/raw gucu

#### Run one of the following methods ####
case $mode in
    run)
	# We are just running the test
	libtool -dlopen ../src/raw/libguile-gucu.la \
	    --mode=execute guile -L .. -L . -s $2
	;;
    debug)
	# We are running the test in the debugger
	libtool -dlopen ../src/raw/libguile-gucu.la \
	    --mode=execute gdb --args guile --debug -L .. -L . -s $2
	;;
    tui)
	# We are running the test in the debugger
	libtool -dlopen ../src/raw/libguile-gucu.la \
	    --mode=execute gdb --tui --args guile -L .. -L . -s $2
	;;
    valgrind)
	# We are running the test in valgrind
	libtool -dlopen ../src/raw/libguile-gucu.la \
	    --mode=execute valgrind --leak-check=full --show-reachable=yes \
	    --trace-children=yes \
	    guile -L .. -L . -s $2 2> vgrind.out
	;;
    *)
	echo Doing nothing
	exit 1;
esac

