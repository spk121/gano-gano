#!/bin/sh

# This contains contains skeletons of commands that might be useful
# when debugging specific tests

# Make a path to the guile modules
ln -s ../src/raw ${PACKAGE}

# MODIFY_ME: A specific test to debug 
TESTS=../doc/menu_example1.scm

# This should be the same as in Makefile.am
LIBGUILE_GUCU_CURSES_MAJOR=0

# Some info
echo "major->" ${LIBGUILE_GUCU_CURSES_MAJOR}

echo "testlist->" ${TESTS}


#### Uncomment one of the following ####

# Run the library
#libtool -dlopen ../src/raw/libguile-gucu-curses-v-${LIBGUILE_GUCU_CURSES_MAJOR}.la \
#    --mode=execute guile -L .. -L . -s ${TESTS}


# Debug the library with GDB
libtool -dlopen ../src/raw/libguile-gucu-curses-v-${LIBGUILE_GUCU_CURSES_MAJOR}.la \
    --mode=execute gdb --tui --args guile -L .. -L . -s ${TESTS}

