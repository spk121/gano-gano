;;;; -*- Mode: scheme; -*-
;;;; r032_util.test --- test suite for curses's utility routines

(define-module (test r032_util)
  #:use-module (test lib)
  #:use-module (gucu raw))


;; Should be able to get term attributes
(define fp #f)
(with-test-prefix "util"

		  (define win (newwin 5 5 5 5))
		  
		  (pass-if "keyname"
			   (and
			    (string=? "^G" (keyname (char->integer #\bel)))
			    (string=? "x" (keyname (char->integer #\x)))
			    (string=? "*key-home*" (keyname *key-home*))))
		  
		  (pass-if "putwin"
			   (begin
			     (mvwaddstr win 0 0 "zzz")
			     (wrefresh win)
			     (set! fp (fopen "win.tmp" "w"))
			     (eqv? *ok* (putwin win fp))))
		  
		  (fclose fp)
		  (delwin win)
		  (refresh)
		  
		  (pass-if "getwin"
			   (begin
			     (clear)
			     (refresh)
			     (set! fp (fopen "win.tmp" "r"))
			     (set! win (getwin fp))
			     (wrefresh win)
			     (string=? "zzz" (mvwinnstr win 0 0 3))
			     )))
