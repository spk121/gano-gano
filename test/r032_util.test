;;;; -*- Mode: scheme; -*-
;;;; r032_util.test --- test suite for curses's utility routines

(define-module (test r032_util)
  #:use-module (test lib)
  #:use-module (gucu raw))


;; Should be able to get term attributes
(define fp #f)
(with-test-prefix "util"

		  
		  (pass-if "keyname #\\bel"
			   (string=? "^G" (keyname (char->integer #\bel))))

		  (pass-if "keyname x"
			   (string=? "x" (keyname (char->integer #\x))))

		  (pass-if "keyname home"
			   (string=? "KEY_HOME" (keyname *key-home*))))

