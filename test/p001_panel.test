;;;; -*- Mode: scheme; -*-

;;;; p001_panel.test --- 

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses)
	     (gucu panel))

(define test (curses-test-start))

(initscr)

;; Should be able to make a panel
(with-test-prefix 
 "panel"

 (pass-if "new-panel"
	  (let* ((win1 (newwin 5 10 5 5))
		 (win2 (newwin 5 10 7 7))
		 (panel1 (new-panel win1))
		 (panel2 (new-panel win2)))
	    (box win1 (acs-vline) (acs-hline))
	    (addstr "box 1" #:win win1 #:y 1 #:x 1)
	    (box win2 (acs-vline) (acs-hline))
	    (addstr "box 2" #:win win2 #:y 1 #:x 1)
	    (update-panels)
	    (doupdate)
	    (sleep 1)

	    (addstr "bottom" #:win win1 #:y 1 #:x 1)
	    (addstr "box 2 " #:win win2 #:y 1 #:x 1)
	    (bottom-panel panel1)
	    (update-panels)
	    (doupdate)
	    (sleep 1)

	    (addstr "top   " #:win win1 #:y 1 #:x 1)
	    (addstr "box 2 " #:win win2 #:y 1 #:x 1)
	    (top-panel panel1)
	    (update-panels)
	    (doupdate)
	    (sleep 1)

	    (addstr "hide   " #:win win1 #:y 1 #:x 1)
	    (addstr "box 2 " #:win win2 #:y 1 #:x 1)
	    (hide-panel panel1)
	    (update-panels)
	    (doupdate)
	    (sleep 1)

	    (addstr "show   " #:win win1 #:y 1 #:x 1)
	    (addstr "box 2 " #:win win2 #:y 1 #:x 1)
	    (show-panel panel1)
	    (update-panels)
	    (doupdate)
	    (sleep 1)

	    (addstr "move   " #:win win1 #:y 1 #:x 1)
	    (addstr "box 2 " #:win win2 #:y 1 #:x 1)
	    (move-panel panel1 2 2)
	    (update-panels)
	    (doupdate)
	    (sleep 1)

	    (addstr "delete   " #:win win1 #:y 1 #:x 1)
	    (addstr "box 2 " #:win win2 #:y 1 #:x 1)
	    (del-panel panel1)
	    (update-panels)
	    (doupdate)
	    (sleep 1)

	    *unspecified*)))

(endwin)

(curses-test-end test "p001_panel.out")
