;;;; -*- Mode: scheme; -*-

;;;; p001_panel.test --- 

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses)
	     (gucu panel))

(define test (curses-test-start))

(initscr)

;; Should be able to make a panel
(with-test-prefix "panel"

		  (pass-if "new-panel"
			   (let* ((win1 (newwin 5 10 5 5))
				  (win2 (newwin 5 10 7 7))
				  (panel1 (new-panel win1))
				  (panel2 (new-panel win2)))
			     (box win1 (acs-vline) (acs-hline))
			     (mvwaddstr win1 1 1 "box 1")
			     (box win2 (acs-vline) (acs-hline))
			     (mvwaddstr win2 1 1 "box 2")
			     (update-panels)
			     (doupdate)
			     (sleep 1)

			     (mvwaddstr win1 1 1 "bottom")
			     (mvwaddstr win2 1 1 "box 2 ")
			     (bottom-panel panel1)
			     (update-panels)
			     (doupdate)
			     (sleep 1)

			     (mvwaddstr win1 1 1 "top   ")
			     (mvwaddstr win2 1 1 "box 2 ")
			     (top-panel panel1)
			     (update-panels)
			     (doupdate)
			     (sleep 1)

			     (mvwaddstr win1 1 1 "hide   ")
			     (mvwaddstr win2 1 1 "box 2 ")
			     (hide-panel panel1)
			     (update-panels)
			     (doupdate)
			     (sleep 1)

			     (mvwaddstr win1 1 1 "show   ")
			     (mvwaddstr win2 1 1 "box 2 ")
			     (show-panel panel1)
			     (update-panels)
			     (doupdate)
			     (sleep 1)

			     (mvwaddstr win1 1 1 "move   ")
			     (mvwaddstr win2 1 1 "box 2 ")
			     (move-panel panel1 2 2)
			     (update-panels)
			     (doupdate)
			     (sleep 1)

			     (mvwaddstr win1 1 1 "delete   ")
			     (mvwaddstr win2 1 1 "box 2 ")
			     (del-panel panel1)
			     (update-panels)
			     (doupdate)
			     (sleep 1)

			     *unspecified*)))

(endwin)

(curses-test-end test "p001_panel.out")
