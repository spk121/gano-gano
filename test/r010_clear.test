;;;; -*- Mode: scheme; -*-
;;;; r010_beep.test --- test suite for curses's clear and erase

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(initscr)

(define space (char->integer #\sp))

;; Should be able to erase
(with-test-prefix "clear"
		  
		  (pass-if "clear"
			   (begin
			     (clear)
			     (addstr "xxxx" #:y 0 #:x 0)
			     (addstr "xxxx" #:y 1 #:x 0)
			     (clear)
			     (refresh)
			     (let ((x1 (mvinch 0 1))
				   (x2 (mvinch 1 1)))
			       (and
				(equal? x1 space)
				(equal? x2 space)))))

		  (pass-if "erase"
			   (begin
			     (clear)
			     (addstr "xxxx" #:y 0 #:x 0)
			     (addstr "xxxx" #:y 1 #:x 0)
			     (erase)
			     (refresh)
			     (let ((x1 (mvinch 0 1))
				   (x2 (mvinch 1 1)))
			       (and
				(equal? x1 space)
				(equal? x2 space)))))
			      

		  (pass-if "clrtobot"
			   (begin
			     (clear)
			     (addstr "xxxx" #:y 0 #:x 0)
			     (addstr "xxxx" #:y 1 #:x 0)
			     (move 0 0)
			     (clrtobot)
			     (refresh)
			     (let ((x1 (mvinch 0 1))
				   (x2 (mvinch 1 1)))
			       (and
				(equal? x1 space))
				(equal? x2 space))))

		  (pass-if "clrtoeol"
			   (begin
			     (clear)
			     (addstr "xxxx" #:y 0 #:x 0)
			     (addstr "xxxx" #:y 1 #:x 0)
			     (move 0 0)
			     (clrtoeol)
			     (refresh)
			     (let ((x1 (mvinch 0 1))
				   (x2 (mvinch 1 1)))
			       (and
				(equal? x1 space)
				(equal? x2 (char->integer #\x)))))))

(define win (newwin 5 10 5 5))

(with-test-prefix "wclear"
		  
		  (pass-if "wclear"
			   (begin
			     (wclear win)
			     (addstr "xxxx" #:win win #:y 0 #:x 0)
			     (addstr "xxxx" #:win win #:y 1 #:x 0)
			     (wclear win)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 1))
				   (x2 (mvwinch win 1 1)))
			       (and
				(equal? x1 space)
				(equal? x2 space)))))

		  (pass-if "werase"
			   (begin
			     (wclear win)
			     (addstr "xxxx" #:win win #:y 0 #:x 0)
			     (addstr "xxxx" #:win win #:y 1 #:x 0)
			     (werase win)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 1))
				   (x2 (mvwinch win 1 1)))
			       (and
				(equal? x1 space)
				(equal? x2 space)))))
			      

		  (pass-if "wclrtobot"
			   (begin
			     (wclear win)
			     (addstr "xxxx" #:win win #:y 0 #:x 0)
			     (addstr "xxxx" #:win win #:y 1 #:x 0)
			     (wmove win 0 0)
			     (wclrtobot win)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 1))
				   (x2 (mvwinch win 1 1)))
			       (and
				(equal? x1 space))
				(equal? x2 space))))

		  (pass-if "clrtoeol"
			   (begin
			     (wclear win)
			     (addstr "xxxx" #:win win #:y 0 #:x 0)
			     (addstr "xxxx" #:win win #:y 1 #:x 0)
			     (wmove win 0 0)
			     (wclrtoeol win)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 1))
				   (x2 (mvwinch win 1 1)))
			       (and
				(equal? x1 space)
				(equal? x2 (char->integer #\x)))))))


(delwin win)
(refresh)

(endwin)

(curses-test-end test "r010_clear.out")
