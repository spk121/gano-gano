;;;; -*- Mode: scheme; -*-
;;;; r004_addchstr.test --- test suite for curses's addchstr functions

(define-module (test r004_addchstr)
  #:use-module (test lib)
  #:use-module (srfi srfi-1)
  #:use-module (gucu raw))


(define hello (map char->integer (string->list "hello")))
(define he (map char->integer (string->list "he")))
(define hello-bold (map (lambda (x) 
			  (logior *a-bold* (char->integer x)))
			(string->list "hello")))
(define he-bold (map (lambda (x) 
		       (logior *a-bold* (char->integer x)))
		     (string->list "he")))

(with-test-prefix "addchstr"
		  
		  (pass-if "addchstr"
			   (begin
			     (clear)
			     (move 0 0)
			     (addchstr hello)
			     (refresh)
			     (let ((w2 (mvinchstr 0 0)))
			       (lset= equal? hello (list-head w2 (length hello))))))

		  (pass-if "addchnstr"
			   (begin
			     (clear)
			     (move 0 0)
			     (addchnstr hello 2)
			     (refresh)
			     (let ((w2 (mvinchstr 0 0)))
			       (lset= equal? he (list-head w2 (length he))))))

		  (pass-if "mvaddchstr"
			   (begin
			     (clear)
			     (mvaddchstr 1 0 hello-bold)
			     (refresh)
			     (let ((x2 (mvinchstr 1 0)))
			       (equal? hello-bold (list-head x2 (length hello-bold))))))

		  (pass-if "mvaddchnstr"
			   (begin
			     (clear)
			     (mvaddchnstr 1 0 hello-bold 2)
			     (refresh)
			     (let ((x2 (mvinchstr 1 0)))
			       (equal? he-bold (list-head x2 (length he-bold)))))))

(define win (newwin 5 10 5 5))

(with-test-prefix "waddchstr"
		  
		  (pass-if "waddchstr"
			   (begin
			     (wclear win)
			     (wmove win 0 0)
			     (waddchstr win hello)
			     (wrefresh win)
			     (let ((w2 (mvwinchstr win 0 0)))
			       (lset= equal? hello (list-head w2 (length hello))))))

		  (pass-if "waddchnstr"
			   (begin
			     (wclear win)
			     (wmove win 0 0)
			     (waddchnstr win hello 2)
			     (wrefresh win)
			     (let ((w2 (mvwinchstr win 0 0)))
			       (lset= equal? he (list-head w2 (length he))))))

		  (pass-if "mvwaddchstr"
			   (begin
			     (wclear win)
			     (mvwaddchstr win 1 0 hello-bold)
			     (wrefresh win)
			     (let ((x2 (mvwinchstr win 1 0)))
			       (equal? hello-bold (list-head x2 (length hello-bold))))))

		  (pass-if "mvwaddchnstr"
			   (begin
			     (wclear win)
			     (mvwaddchnstr win 1 0 hello-bold 2)
			     (wrefresh win)
			     (let ((x2 (mvwinchstr win 1 0)))
			       (equal? he-bold (list-head x2 (length he-bold)))))))
			      
(delwin win)
(refresh)
