;;;; -*- Mode: scheme; -*-
;;;; r012_deleteln.test --- test suite for curses's line deletion functions

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(initscr)

(with-test-prefix "deleteln"
		  
		  (pass-if "deleteln"
			   (begin
			     (clear)
			     (addstr "aaa" #:y 0 #:x 0)
			     (addstr "bbb" #:y 1 #:x 0)
			     (addstr "ccc" #:y 2 #:x 0)
			     (move 1 0)
			     (deleteln)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\sp))))))

		  (pass-if "insdelln -1"
			   (begin
			     (clear)
			     (addstr "aaa" #:y 0 #:x 0)
			     (addstr "bbb" #:y 1 #:x 0)
			     (addstr "ccc" #:y 2 #:x 0)
			     (move 1 0)
			     (insdelln -1)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\sp))))))

		  (pass-if "insertln"
			   (begin
			     (clear)
			     (addstr "aaa" #:y 0 #:x 0)
			     (addstr "bbb" #:y 1 #:x 0)
			     (addstr "ccc" #:y 2 #:x 0)
			     (move 1 0)
			     (insertln)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\b))))))

		  (pass-if "insdelln +1"
			   (begin
			     (clear)
			     (addstr "aaa" #:y 0 #:x 0)
			     (addstr "bbb" #:y 1 #:x 0)
			     (addstr "ccc" #:y 2 #:x 0)
			     (move 1 0)
			     (insdelln 1)
			     (refresh)
			     (let ((x1 (mvinch 0 0))
				   (x2 (mvinch 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\b)))))))

(define win (newwin 5 10 5 5))


(with-test-prefix "wdeleteln"
		  
		  (pass-if "wdeleteln"
			   (begin
			     (wclear win)
			     (addstr "aaa" #:win win #:y 0 #:x 0)
			     (addstr "bbb" #:win win #:y 1 #:x 0)
			     (addstr "ccc" #:win win #:y 2 #:x 0)
			     (wmove win 1 0)
			     (wdeleteln win)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\sp))))))

		  (pass-if "insdelln -1"
			   (begin
			     (wclear win)
			     (addstr "aaa" #:win win #:y 0 #:x 0)
			     (addstr "bbb" #:win win #:y 1 #:x 0)
			     (addstr "ccc" #:win win #:y 2 #:x 0)
			     (wmove win 1 0)
			     (winsdelln win -1)
			     (wrefresh win )
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\sp))))))

		  (pass-if "insertln"
			   (begin
			     (wclear win)
			     (addstr "aaa" #:win win #:y 0 #:x 0)
			     (addstr "bbb" #:win win #:y 1 #:x 0)
			     (addstr "ccc" #:win win #:y 2 #:x 0)
			     (wmove win 1 0)
			     (winsertln win)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\b))))))

		  (pass-if "insdelln +1"
			   (begin
			     (wclear win)
			     (addstr "aaa" #:win win #:y 0 #:x 0)
			     (addstr "bbb" #:win win #:y 1 #:x 0)
			     (addstr "ccc" #:win win #:y 2 #:x 0)
			     (wmove win 1 0)
			     (winsdelln win 1)
			     (wrefresh win)
			     (let ((x1 (mvwinch win 0 0))
				   (x2 (mvwinch win 2 0)))
			       (and
				(equal? x1 (char->integer #\a))
				(equal? x2 (char->integer #\b)))))))

(endwin)

(curses-test-end test "r012_deleteln.out")
