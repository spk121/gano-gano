;;;; -*- Mode: scheme; -*-
;;;; r041-ports.test --- test suite for newterm

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (ice-9 format)
	     (srfi srfi-1))

(define test (curses-test-start))

(define input-port (open-input-file "r041_ports.test"))
(define output-port (open-output-string))

(define scr #f)
(define win #f)

(with-test-prefix 
 "newterm"
 (pass-if "create"
	  (begin
	    (set! scr (newterm "xterm" output-port input-port))
	    (screen? scr)))

 (pass-if "stdscr"
	  (begin
	    (set! win (stdscr))
	    (window? win)))

 (pass-if "addstr"
	  (begin
	    (addstr win "Blammo!")
	    #t))

 (pass-if "refresh"
	  (begin
	    (refresh win)
	    #t))

 (pass-if "nodelay"
	  (begin
	    (nodelay! win #t)
	    #t))

 (pass-if "getch"
	  (getch win))

 ;; Should be false because it should not be possible to restore
 ;; the "shell mode" of a port
 (pass-if "endwin"
	  (eqv? (endwin) #f))
 
 (pass-if "delscreen"
	  (false-if-exception (delscreen scr))))

(curses-test-end test "r041_ports.out")
