;;;; -*- Mode: scheme; -*-
;;;; r039_getstr.test --- test suite for curses's get_wstr

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(initscr)

(define win (newwin 5 10 5 5))
(define letter-h (char->integer #\h))
(define letter-i (char->integer #\i))
(define letter-p (char->integer #\p))
(define newline (char->integer #\nl))
(define wstring-hip (map char->integer (string->list "hip")))
(define wstring-hi (map char->integer (string->list "hi")))
(standend)
(attr-on (logior (color-pair 0) A_NORMAL))

;; Should be able to get strings from the keyboard

(with-test-prefix "get-wstr"
		  
		  (pass-if "getn-wstr"
			   (begin
			     (erase)
			     (refresh)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (getn-wstr 2)))
			       (begin
				 (refresh)
				 (lset= equal? s1 wstring-hi)))))


		  (pass-if "mvgetn-wstr"
			   (begin
			     (erase)
			     (refresh)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (mvgetn-wstr 1 1 2)))
			       (begin
				 (refresh)
				 (lset= equal? s1 wstring-hi))))))


(with-test-prefix "wget-wstr"
		  
		  (pass-if "wgetn-wstr"
			   (begin
			     (werase win)
			     (wrefresh win)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (wgetn-wstr win 2)))
			       (begin
				 (wrefresh win)
				 (lset= equal? s1 wstring-hi)))))


		  (pass-if "mvgetn-wstr"
			   (begin
			     (werase win)
			     (wrefresh win)
			     (ungetch newline)
			     (ungetch letter-p)
			     (ungetch letter-i)
			     (ungetch letter-h)
			     (let ((s1 (mvwgetn-wstr win 1 1 2)))
			       (begin
				 (wrefresh win)
				 (lset= equal? s1 wstring-hi))))))


(endwin)
(curses-test-end test "r039_get_wstr.out")
