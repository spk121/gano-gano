;;;; -*- Mode: scheme; -*-
;;;; r039_getstr.test --- test suite for curses's get_wstr

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(define win (initscr))

(define letter-h (char->integer #\h))
(define letter-i (char->integer #\i))
(define letter-p (char->integer #\p))
(define newline (char->integer #\nl))
(define wstring-hip (map char->integer (string->list "hip")))
(define wstring-hi (map char->integer (string->list "hi")))

;; Should be able to get strings from the keyboard

(with-test-prefix 
 "get-wstr"
 
 (pass-if "getn-wstr"
	  (begin
	    (erase win)
	    (refresh win)
	    (ungetch newline)
	    (ungetch letter-p)
	    (ungetch letter-i)
	    (ungetch letter-h)
	    (let ((s1 (getn-wstr win 2)))
	      (begin
		(refresh win)
		(lset= equal? s1 wstring-hi)))))


 (pass-if "getn-wstr #:y #:x"
	  (begin
	    (erase win)
	    (refresh win)
	    (ungetch newline)
	    (ungetch letter-p)
	    (ungetch letter-i)
	    (ungetch letter-h)
	    (let ((s1 (getn-wstr win 2 #:y 1 #:x 1)))
	      (begin
		(refresh win)
		(lset= equal? s1 wstring-hi))))))


(endwin)
(curses-test-end test "r039_get_wstr.out")
