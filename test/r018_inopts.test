;;;; -*- Mode: scheme; -*-
;;;; r018_inopts.test --- test suite for curse's input options

(define-module (test r018_inopts)
  #:use-module (test lib)
  #:use-module (gucu raw))


;; Should be able to change input options
(with-test-prefix "inopts"
		  
		  (pass-if "cbreak"
			   (begin
			     (clear)
			     (refresh)
			     (cbreak)
			     (nodelay (stdscr) #t)
			     (equal? *err* (getch))))

		  (pass-if "halfdelay"
			   (begin
			     (halfdelay 1)
			     (equal? *err* (getch))))

