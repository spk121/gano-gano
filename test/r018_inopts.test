;;;; -*- Mode: scheme; -*-
;;;; r018_inopts.test --- test suite for curse's input options

(use-modules (test lib)
	     (test lib2)
	     ;; (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(initscr)

;; Should be able to change input options
(with-test-prefix "inopts"
		  
		  (pass-if "cbreak"
			   (begin
			     (clear)
			     (refresh)
			     (cbreak)
			     (nodelay (stdscr) #t)
			     (equal? ERR (getch))))

		  (pass-if "halfdelay"
			   (begin
			     (halfdelay 1)
			     (equal? ERR (getch))))

; 		  (pass-if "meta"
; 			   (begin
