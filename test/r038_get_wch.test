;;;; -*- Mode: scheme; -*-
;;;; r038_get_wch.test --- test suite for curses's get-wch

(define-module (test r038_get_wch)
  #:use-module (test lib)
  #:use-module (srfi srfi-1)
  #:use-module (gucu curses-wide)
  #:use-module (gucu curses))


(cbreak)
(echo)

(define win (newwin 5 10 5 5))

;; Should be able to get characters from the keyboard
(with-test-prefix "get-wch"
		  
		  (pass-if "unget-wch / get-wch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (unget-wch x1)
			       (lset= equal? (get-wch) (list *ok* x1)))))


		  (pass-if "wget-wch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (unget-wch x1)
			       (lset= equal? (wget-wch win) (list *ok* x1)))))


		  (pass-if "mvget-wch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (begin
				 (clear)
				 (unget-wch x1)
				 (let ((x2 (mvget-wch 2 2))
				       (pos (getyx (stdscr))))
				   (and
				    (lset= equal? x2 (list *ok* x1))
				    (lset= equal? pos '(2 2))))))))
					  
		  (pass-if "mvwget-wch"
			   (begin
			     (let ((x1 (char->integer #\x)))
			       (begin
				 (wclear win)
				 (unget-wch x1)
				 (let ((x2 (mvwget-wch win 2 2))
				       (pos (getyx win)))
				   (and
				    (lset= equal? x2 (list *ok* x1))
				    (lset= eqv? pos '(2 2)))))))))

(delwin win)
(refresh)

