;;;; -*- Mode: scheme; -*-
;;;; r027_refresh.test --- test suite for curses's refresh

(use-modules (test lib)
	     (test lib2)
	     ;; (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(initscr)

;; Should be able to refresh the windows
(with-test-prefix "refresh"

		  (pass-if "refresh"
			   (begin
			     (and
			      (eqv? (clear) OK)
			      (eqv? (refresh) OK)
			      (eqv? (addstr "a") OK)
			      (eqv? (refresh) OK)
			      (eqv? (addstr "b") OK)
			      (eqv? (wrefresh (stdscr)) OK)
			      (eqv? (addstr "c") OK)
			      (eqv? (wnoutrefresh (stdscr)) OK)
			      (eqv? (doupdate) OK)
			      (eqv? (begin (display "d")
					   (wredrawln (stdscr) 0 3))
				    OK)
			      (eqv? (refresh) OK)
			      (eqv? (begin (display "e")
					   (redrawwin (stdscr)))
				    OK)
			      (eqv? (refresh) OK)))))
				      

(endwin)

(curses-test-end test "r027_refresh.out")		  

