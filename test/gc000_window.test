;;;; -*- Mode: scheme; -*-
;;;; gc000_window.test -- garbage collect window

(use-modules (test lib)
	     (test lib2)
	     (gucu curses))

(define test (curses-test-start))

(setlocale LC_ALL "")

;;;
;;; initscr
;;;

(define std (initscr))

(add-hook! after-gc-hook 
	   (lambda ()
	     (addstr std "Garbage Collection" #:y 0 #:x 0)
	     (refresh std)
	     (sleep 1)
	     (clear std)
	     (refresh std)))

;; This should work
(define (do)
  (let ((s2 #f))
    (let loop ((i 0))
      (if (> i 5000)
	  (endwin)
	  (begin
	    ;;(gc)
	    (set! s2 (newwin 23 80 1 0))
	    (addstr s2 (format #f "~a      " i))
	    (refresh s2)
	    (loop (+ 1 i)))))

    ;; This time, explicitly delete the window instead of
    ;; waiting for the GC
    (let loop ((i 0))
      (if (> i 5000)
	  (endwin)
	  (begin
	    ;;(gc)
	    (set! s2 (newwin 23 80 1 0))
	    (addstr s2 (format #f "~a      " i))
	    (refresh s2)
	    (delwin s2)
	    (loop (+ 1 i)))))

    ))

(do)
(refresh std)
(gc)
(refresh std)
(endwin)

(curses-test-end test "gc000_windowr.out")