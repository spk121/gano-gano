#!/bin/sh
# This copies over the libraries and runs the test suite

# make a path to the guile modules
ln -s ../src/raw ${PACKAGE}

# This should be exported from the Makefile.am
echo "major->" ${LIBGUILE_GUCU_MAJOR}

# Run the library
libtool -dlopen ../src/raw/libguile-gucu-v-${LIBGUILE_GUCU_MAJOR}.la --mode=execute guile -e main -s ${srcdir}/guile-test
