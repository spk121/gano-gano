;;;; -*- Mode: scheme; -*-
;;;; r016_inch.test --- test suite for curses's inch

(define-module (test r016_inch)
  #:use-module (test lib)
  #:use-module (gucu curses))


(define x-normal (char->integer #\x))
(define x-bold (logior x-normal *a-bold*))

(with-test-prefix "inch"
		  
		  (pass-if "inch"
			   (begin
			     (clear)
			     (mvaddch 4 5 x-normal)
			     (move 4 5)
			     (refresh)
			     (let ((x1 (inch)))
			       (equal? x-normal x1))))

		  (pass-if "mvinch"
			   (begin
			     (clear)
			     (mvaddch 1 0 x-bold)
			     (refresh)
			     (let ((x2 (mvinch 1 0)))
			       (equal? x-bold x2)))))
			      
(define win (newwin 5 5 5 5))

(with-test-prefix "winch"
		  
		  (pass-if "winch"
			   (begin
			     (wclear win)
			     (mvwaddch win 2 3 x-normal)
			     (wrefresh win)
			     (wmove win 2 3)
			     (let ((x1 (winch win)))
			       (equal? x-normal x1))))

		  (pass-if "mvwinch"
			   (begin
			     (wclear win)
			     (mvwaddch win 1 0 x-bold)
			     (wrefresh win)
			     (let ((x2 (mvwinch win 1 0)))
			       (equal? x-bold x2)))))

			      
(delwin win)
(refresh)