;;;; -*- Mode: scheme; -*-
;;;; r009_border.test --- test suite for curses's border

(use-modules (test lib)
	     (test lib2)
	     (srfi srfi-1)
	     (gucu curses))


(define test (curses-test-start))

(define win (initscr))

(define (mvinch y x)
  (inch win #:y y #:x x))

;; Should be able to draw borders
(with-test-prefix 
 "border"
		  
 (pass-if "border default"
	  (begin
	    (clear win)
	    (border win 0 0 0 0 0 0 0 0)
	    (refresh win)
	    (let ((l  (mvinch 1 	     0))
		  (r  (mvinch 1             (- (cols) 1)))
		  (t  (mvinch 0 	     1))
		  (b  (mvinch (- (lines) 1) 1))
		  (tl (mvinch 0 	     0))
		  (tr (mvinch 0 	     (- (cols) 1)))
		  (bl (mvinch (- (lines) 1) 0))
		  (br (mvinch (- (lines) 1) (- (cols) 1)))
		  )
	      (and
	       (equal? l (acs-vline))
	       (equal? r (acs-vline))
	       (equal? t (acs-hline))
	       (equal? b (acs-hline))
	       (equal? tl (acs-ulcorner))
	       (equal? tr (acs-urcorner))
	       (equal? bl (acs-llcorner))
	       (equal? br (acs-lrcorner))))))
 
 (pass-if "border"
	  (begin
	    (clear win)
	    (border win 65 66 67 68 69 70 71 72) ; ABCDEFGH
	    (refresh win)
	    (let ((l  (mvinch 1 	     0))
		  (r  (mvinch 1             (- (cols) 1)))
		  (t  (mvinch 0 	     1))
		  (b  (mvinch (- (lines) 1) 1))
		  (tl (mvinch 0 	     0))
		  (tr (mvinch 0 	     (- (cols) 1)))
		  (bl (mvinch (- (lines) 1) 0))
		  (br (mvinch (- (lines) 1) (- (cols) 1)))
		  )
	      (and
	       (equal? l 65)
	       (equal? r 66)
	       (equal? t 67)
	       (equal? b 68)
	       (equal? tl 69)
	       (equal? tr 70)
	       (equal? bl 71)
	       (equal? br 72)))))
 
 (pass-if "hline"
	  (begin
	    (clear win)
	    (move win 1 1)
	    (hline win 65 2) ; A
	    (refresh win)
	    (let ((x1  (mvinch 1 1))
		  (x2  (mvinch 1 2))
		  )
	      (and
	       (equal? x1 65)
	       (equal? x2 65)))))

 (pass-if "vline"
	  (begin
	    (clear win)
	    (move win 1 1)
	    (vline win 65 2) ; A
	    (refresh win)
	    (let ((x1  (mvinch 1 1))
		  (x2  (mvinch 2 1))
		  )
	      (and
	       (equal? x1 65)
	       (equal? x2 65)))))
 
 (pass-if "hline #:y #:x"
	  (begin
	    (clear win)
	    (hline win 65 2 #:y 1 #:x 1) ; A
	    (refresh win)
	    (let ((x1  (mvinch 1 1))
		  (x2  (mvinch 1 2))
		  )
	      (and
	       (equal? x1 65)
	       (equal? x2 65)))))
 
 (pass-if "vline #:y #:x"
	  (begin
	    (clear win)
	    (vline win 65 2 #:y 1 #:x 1) ; A
	    (refresh win)
	    (let ((x1  (mvinch 1 1))
		  (x2  (mvinch 2 1))
		  )
	      (and
	       (equal? x1 65)
	       (equal? x2 65)))))
 )

(endwin)

(curses-test-end test "r009_border.out")



