;;;; -*- Mode: scheme; -*-
;;;; r009_border.test --- test suite for curses's border

(define-module (test r009_border)
  #:use-module (test lib)
  #:use-module (gucu raw))


;; Should be able to draw borders
(with-test-prefix "border"
		  
		  (pass-if "border default"
			   (begin
			     (clear)
			     (border 0 0 0 0 0 0 0 0)
			     (refresh)
			     (let ((l  (mvinch 1 	     0))
				   (r  (mvinch 1             (- (COLS) 1)))
				   (t  (mvinch 0 	     1))
				   (b  (mvinch (- (LINES) 1) 1))
				   (tl (mvinch 0 	     0))
				   (tr (mvinch 0 	     (- (COLS) 1)))
				   (bl (mvinch (- (LINES) 1) 0))
				   (br (mvinch (- (LINES) 1) (- (COLS) 1)))
				   )
			       (and
				(equal? l (ACS_VLINE))
				(equal? r (ACS_VLINE))
				(equal? t (ACS_HLINE))
				(equal? b (ACS_HLINE))
				(equal? tl (ACS_ULCORNER))
				(equal? tr (ACS_URCORNER))
				(equal? bl (ACS_LLCORNER))
				(equal? br (ACS_LRCORNER))))))

		  (pass-if "border"
			   (begin
			     (clear)
			     (border 65 66 67 68 69 70 71 72) ; ABCDEFGH
			     (refresh)
			     (let ((l  (mvinch 1 	     0))
				   (r  (mvinch 1             (- (COLS) 1)))
				   (t  (mvinch 0 	     1))
				   (b  (mvinch (- (LINES) 1) 1))
				   (tl (mvinch 0 	     0))
				   (tr (mvinch 0 	     (- (COLS) 1)))
				   (bl (mvinch (- (LINES) 1) 0))
				   (br (mvinch (- (LINES) 1) (- (COLS) 1)))
				   )
			       (and
				(equal? l 65)
				(equal? r 66)
				(equal? t 67)
				(equal? b 68)
				(equal? tl 69)
				(equal? tr 70)
				(equal? bl 71)
				(equal? br 72)))))

		  (pass-if "hline"
			   (begin
			     (clear)
			     (move 1 1)
			     (hline 65 2) ; A
			     (refresh)
			     (let ((x1  (mvinch 1 1))
				   (x2  (mvinch 1 2))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  (pass-if "vline"
			   (begin
			     (clear)
			     (move 1 1)
			     (vline 65 2) ; A
			     (refresh)
			     (let ((x1  (mvinch 1 1))
				   (x2  (mvinch 2 1))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  (pass-if "mvhline"
			   (begin
			     (clear)
			     (mvhline 1 1 65 2) ; A
			     (refresh)
			     (let ((x1  (mvinch 1 1))
				   (x2  (mvinch 1 2))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  (pass-if "mvvline"
			   (begin
			     (clear)
			     (mvvline 1 1 65 2) ; A
			     (refresh)
			     (let ((x1  (mvinch 1 1))
				   (x2  (mvinch 2 1))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  )

(define maxy 4)
(define maxx 9)
(define win (newwin (+ 1 maxy) (+ 1 maxx) 5 5))
(with-test-prefix "wborder"
		  
		  (pass-if "wborder default"
			   (begin
			     (wclear win)
			     (wborder win 0 0 0 0 0 0 0 0)
			     (wrefresh win)
			     (let ((l  (mvwinch win 1 0))
				   (r  (mvwinch win 1 maxx))
				   (t  (mvwinch win 0 1))
				   (b  (mvwinch win maxy 1))
				   (tl (mvwinch win 0 0))
				   (tr (mvwinch win 0 maxx))
				   (bl (mvwinch win maxy 0))
				   (br (mvwinch win maxy maxx))
				   )
			       (and
				(equal? l (ACS_VLINE))
				(equal? r (ACS_VLINE))
				(equal? t (ACS_HLINE))
				(equal? b (ACS_HLINE))
				(equal? tl (ACS_ULCORNER))
				(equal? tr (ACS_URCORNER))
				(equal? bl (ACS_LLCORNER))
				(equal? br (ACS_LRCORNER))))))

		  (pass-if "wborder"
			   (begin
			     (wclear win)
			     (wborder win 65 66 67 68 69 70 71 72) ; ABCDEFGH
			     (wrefresh win)
			     (let ((l  (mvwinch win 1 0))
				   (r  (mvwinch win 1 maxx))
				   (t  (mvwinch win 0 1))
				   (b  (mvwinch win maxy 1))
				   (tl (mvwinch win 0 0))
				   (tr (mvwinch win 0 maxx))
				   (bl (mvwinch win maxy 0))
				   (br (mvwinch win maxy maxx))
				   )
			       (and
				(equal? l 65)
				(equal? r 66)
				(equal? t 67)
				(equal? b 68)
				(equal? tl 69)
				(equal? tr 70)
				(equal? bl 71)
				(equal? br 72)))))

		  (pass-if "box"
			   (begin
			     (wclear win)
			     (box win 0 0 ) ; ABCDEFGH
			     (wrefresh win)
			     (let ((l  (mvwinch win 1 0))
				   (r  (mvwinch win 1 maxx))
				   (t  (mvwinch win 0 1))
				   (b  (mvwinch win maxy 1))
				   (tl (mvwinch win 0 0))
				   (tr (mvwinch win 0 maxx))
				   (bl (mvwinch win maxy 0))
				   (br (mvwinch win maxy maxx))
				   )
			       (and
				(equal? l (ACS_VLINE))
				(equal? r (ACS_VLINE))
				(equal? t (ACS_HLINE))
				(equal? b (ACS_HLINE))
				(equal? tl (ACS_ULCORNER))
				(equal? tr (ACS_URCORNER))
				(equal? bl (ACS_LLCORNER))
				(equal? br (ACS_LRCORNER))))))
		  

		  (pass-if "whline"
			   (begin
			     (wclear win)
			     (wmove win 1 1)
			     (whline win 65 2) ; A
			     (wrefresh win)
			     (let ((x1  (mvwinch win 1 1))
				   (x2  (mvwinch win 1 2))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  (pass-if "wvline"
			   (begin
			     (wclear win)
			     (wmove win 1 1)
			     (wvline win 65 2) ; A
			     (wrefresh win)
			     (let ((x1  (mvwinch win 1 1))
				   (x2  (mvwinch win 2 1))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  (pass-if "mvhline"
			   (begin
			     (wclear win)
			     (mvwhline win 1 1 65 2) ; A
			     (wrefresh win)
			     (let ((x1  (mvwinch win 1 1))
				   (x2  (mvwinch win 1 2))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  (pass-if "mvvline"
			   (begin
			     (wclear win)
			     (mvwvline win 1 1 65 2) ; A
			     (wrefresh win)
			     (let ((x1  (mvwinch win 1 1))
				   (x2  (mvwinch win 2 1))
				   )
			       (and
				(equal? x1 65)
				(equal? x2 65)))))

		  )



(delwin win)
(refresh)



