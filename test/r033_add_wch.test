;;;; -*- Mode: scheme; -*-
;;;; r033_add_wch.test --- test suite for curses's wide character functions

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(setlocale LC_ALL "")

(define test (curses-test-start))

(define win (initscr))

;; U+041B CYRILLIC CAPITAL LETTER EL
(define el_normal `(,A_NORMAL 0 #x041B))
(define el_bold `(,A_BOLD 0 #x041B))

;; U+5FE1 CJK UNIFIED IDEOGRAPH-5FE1
(define chuu_normal `(,A_NORMAL 0 #x4F7E))
(define chuu_bold `(,A_BOLD 0 #x4F7E))

;; 'o' with combining macron and grave accent below
(define o_macron `(,A_NORMAL 0 ,(char->integer #\o) #x0304 #x0316))

;; Should be able to print a non-8859 character.  A lot of these test
;; are unspecified, because they depend on the capabilities of the
;; current terminal
(with-test-prefix "add-wch"
		  
		  (pass-if "add-wch"
			   (begin
			     (clear win)
			     (move win 0 0)
			     (add-wch win el_normal)
			     (refresh win)
			     ;; (sleep 1)
			     (let ((x (in-wch win #:y 0 #:x 0)))
			       (equal? x el_normal))
			     ;; *unspecified*
			     ))
		  
		  ;; (sleep 1)

		  (pass-if "add-wch #:y #:x"
			   (begin
			     (add-wch win el_bold #:y 1 #:x 0)
			     (refresh win)
			     ;; (sleep 1)
			     (let ((x (in-wch win #:y 1 #:x 0)))
			       (equal? x el_bold))
			     ;;*unspecified*
			     ))

		  ;; (sleep 1)

		  (pass-if "echo-wchar"
			   (begin
			     (move win 2 0)
			     (echo-wchar win chuu_normal)
			     ;; (sleep 1)
			     (let ((x (in-wch win #:y 2 #:x 0)))
			       (equal? x chuu_normal))
			     ;; *unspecified*
			     ))

		  (pass-if "echo-wchar combining chars"
			   (begin
			     (clear win)
			     (move win 3 0)
			     (echo-wchar win o_macron)
			     ;; (sleep 1)
			     (addstr win (format #f "~a" o_macron))
			     (let ((x (in-wch win #:y 3 #:x 0)))
			       (addstr win (format #f "~a" x))
			       (refresh win)
			       ;; (sleep 1)
			       (equal? x o_macron))
			     ;; *unspecified*
			     )))
(refresh win)

(endwin)

(curses-test-end test "r033_add_wch.out")		  
