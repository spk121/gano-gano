;;;; -*- Mode: scheme; -*-
;;;; r003_add_wch.test --- test suite for curses's wide character functions

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(initscr)

;; U+041B CYRILLIC CAPITAL LETTER EL
(define el_normal `(,A_NORMAL 0 #x041B))
(define el_bold `(,A_BOLD 0 #x041B))

;; U+5FE1 CJK UNIFIED IDEOGRAPH-5FE1
(define chuu_normal `(,A_NORMAL 0 #x4F7E))
(define chuu_bold `(,A_BOLD 0 #x4F7E))

;; 'o' with combining macron and grave accent below
(define o_macron `(,A_NORMAL 0 ,(char->integer #\o) #x0304 #x0316))

;; Should be able to print a non-8859 character.  A lot of these test
;; are unspecified, because they depend on the capabilities of the
;; current terminal
(with-test-prefix "add-wch"
		  
		  (pass-if "add-wch"
			   (begin
			     (clear)
			     (move 0 0)
			     (add-wch el_normal)
			     (refresh)
			     (let ((x (mvin-wch 0 0)))
			       (equal? x el_normal))
			     *unspecified*))
		  ;; (sleep 1)

		  (pass-if "add-wch #:y #:x"
			   (begin
			     (add-wch el_bold #:y 1 #:x 0)
			     (refresh)
			     (let ((x (mvin-wch 1 0)))
			       (equal? x el_bold))
			     *unspecified*))

		  ;; (sleep 1)

		  (pass-if "echo-wchar"
			   (begin
			     (move 2 0)
			     (echo-wchar chuu_normal)
			     (let ((x (mvin-wch 2 0)))
			       (equal? x chuu_normal))
			     *unspecified*)))

(sleep 1)

(define win2 (newwin 5 5 5 5))

(with-test-prefix "add-wch #:win"
		  
 		  (pass-if "add-wch #:win"
 			   (begin
 			     (clear)
 			     (move 0 0)
 			     (add-wch el_normal #:win win2)
 			     (wrefresh win2)
 			     (let ((x (mvwin-wch win2 0 0)))
 			       (equal? x el_normal))
 			     *unspecified*))


		  (pass-if "add-wch #:win #:y #:x"
			   (begin
			     (clear)
			     (add-wch el_bold #:win win2 #:y 1 #:x 0)
			     (wrefresh win2)
			     (let ((x (mvwin-wch win2 1 0)))
			       (equal? x el_bold))
			     *unspecified*))

		  (pass-if "echo-wchar #:win"
			   (begin
			     (clear)
			     (wmove win2 2 0)
			     (echo-wchar chuu_bold #:win win2)
			     (let ((x (mvwin-wch win2 2 0)))
			       (equal? x chuu_bold))
			     *unspecified*))

		  (pass-if "echo-wchar #:win combining chars"
			   (begin
			     (clear)
			     (wmove win2 3 0)
			     (echo-wchar o_macron #:win win2)
			     ;(addstr (format #f "~a" o_macron))
			     (let ((x (mvwin-wch win2 3 0)))
			       ;(addstr (format #f "~a" x))
			       ;(refresh)
			       (equal? x o_macron))
			     *unspecified*)))

(sleep 1)
(delwin win2)
(refresh)

(endwin)

(curses-test-end test "r033_add_wch.out")		  
