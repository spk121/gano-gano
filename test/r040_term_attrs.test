;;;; -*- Mode: scheme; -*-
;;;; r040-term-attrs.test --- test suite for curses's term attrs

(use-modules (test lib)
	     (test lib2)
	     (gucu curses-wide)
	     (gucu curses)
	     (ice-9 format)
	     (srfi srfi-1))

(define test (curses-test-start))

(define (mvaddstr y x s)
  (addstr s #:y y #:x x))
(define (mvwaddstr w y x s)
  (addstr s #:win w #:y y #:x x))

(initscr)

;; Should be able to get term attributes
(with-test-prefix 
 "term-attrs"
 
 ;; Not sure what the correct answer for
 ;; erasewchar should be.  Gnu/Linux xterm gives
 ;; #\del.  Cygwin gives ERR.
 (pass-if "erasewchar"
	  (begin
	    (clear)
	    (refresh)
	    (let ((c (erasewchar)))
	      (addstr (format #f "erasewchar: ~a" c))
	      (refresh)
	      ;;(sleep 2)
	      (eqv? c (char->integer #\del)))
	    *unspecified*))
		  
 ;; Not sure what the correct answer for killwchar
 ;; should be.  Gnu/Linux xterm give #\del. Cygwin
 ;; gives ERR
 (pass-if "killwchar"
	  (begin
	    (clear)
	    (refresh)
	    (let ((c (killwchar)))
	      (addstr (format #f "killwchar: ~a" c))
	      (refresh)
	      ;;(sleep 2)
	      (eqv? c (char->integer #\del)))
	    *unspecified*))

 (pass-if "term-attrs"
	  (begin
	    (clear)
	    (refresh)
	    (let ((ta (term-attrs))
		  (ta2 (logior 
			A_ALTCHARSET
			A_BLINK
			A_BOLD
			;; A_DIM
			A_INVIS
			;; A_PROTECT
			A_REVERSE
			A_STANDOUT
			A_UNDERLINE))) 
	      
	      (mvaddstr 0 0 (format #f "      ~32,'0b~%" ta))
	      (addstr (format #f " LEFT ~32,'0b~%" WA_LEFT))
	      (addstr (format #f "  LOW ~32,'0b~%" WA_LOW))
	      (addstr (format #f "RIGHT ~32,'0b~%" WA_RIGHT))
	      (addstr (format #f "  TOP ~32,'0b~%" WA_TOP))
	      (addstr (format #f " VERT ~32,'0b~%" WA_VERTICAL))
	      (addstr (format #f "PRTCT ~32,'0b~%" A_PROTECT))
	      (addstr (format #f "INVIS ~32,'0b~%" A_INVIS))
	      (addstr (format #f "  ALT ~32,'0b~%" A_ALTCHARSET))
	      (addstr (format #f " BOLD ~32,'0b~%" A_BOLD))
	      (addstr (format #f "  DIM ~32,'0b~%" A_DIM))
	      (addstr (format #f "BLINK ~32,'0b~%" A_BLINK))
	      (addstr (format #f "RVRSE ~32,'0b~%" A_REVERSE))
	      (addstr (format #f "UNDRL ~32,'0b~%" A_UNDERLINE))
	      (addstr (format #f "STNDT ~32,'0b~%" A_STANDOUT))
	      (addstr (format #f "HORIZ ~32,'0b~%" WA_HORIZONTAL))
	      (addstr (format #f "COLOR ~32,'0b~%" A_COLOR))
	      (addstr (format #f "      ~32,'0b~%" ta2))
	      (refresh)
	      (sleep 1)
	      (eqv? ta ta2))
	    *unspecified*))

 )


(endwin)

(curses-test-end test "r040_term_attrs.out")
