#!/bin/sh
# This copies over the libraries and runs the test suite

# make a path to the guile modules
ln -s ../src/raw ${PACKAGE}

# This should be exported from the Makefile.am
echo "major->" ${LIBGUILE_GUCU_CURSES_WIDE_MAJOR}

echo "testlist->" ${TESTLIST_CURSES_WIDE}

# Run the library
libtool -dlopen ../src/raw/libguile-gucu-curses-wide-v-${LIBGUILE_GUCU_CURSES_WIDE_MAJOR}.la \
    --mode=execute guile -e main -s ${srcdir}/guile-test --log-file=curses-wide.log ${TESTLIST_CURSES_WIDE}
