;;;; -*- Mode: scheme; -*-
;;;; r031_touch.test --- test suite for curses's touch functions

(use-modules (test lib)
	     (test lib2)
	     ;; (gucu curses-wide)
	     (gucu curses)
	     (srfi srfi-1))

(define test (curses-test-start))

(initscr)

;; Should be able to get term attributes
(with-test-prefix "touch"

		  (pass-if "is-linetouched #f"
			   (begin
			     (clear)
			     (refresh)
			     (not (is-linetouched (stdscr) 0))))

		  (pass-if "touchline / is-linetouched"
			   (begin
			     (clear)
			     (refresh)
			     (touchline (stdscr) 0 1)
			     (is-linetouched (stdscr) 0)))


		  (pass-if "wtouchln / is-linetouched"
			   (begin
			     (clear)
			     (refresh)
			     (wtouchln (stdscr) 0 1 1)
			     (is-linetouched (stdscr) 0)))


		  (pass-if "is-wintouched #f"
			   (begin
			     (clear)
			     (refresh)
			     (not (is-wintouched (stdscr)))))

		  (pass-if "touchline / is-linetouched"
			   (begin
			     (clear)
			     (refresh)
			     (touchwin (stdscr))
			     (is-wintouched (stdscr))))


		  (pass-if "untouchwin / is-linetouched"
			   (begin
			     (clear)
			     (refresh)
			     (touchwin (stdscr))
			     (untouchwin (stdscr))
			     (not (is-wintouched (stdscr)))))



		  )

(endwin)

(curses-test-end test "r031_touch.out")		  
