# -*- mode: Makefile; -*-
# Makefile for gano

# $id$

SHELL = /bin/sh

.SUFFIXES: 			# Delete the default suffixes
.SUFFIXES: .c .o .h		# The suffixes used in this case

VPATH=src
vpath %.scm.in src

### System configuration ###

srcdir = .
prefix = /usr/local
exec_prefix = $(prefix)
datarootdir = $(prefix)/share

bindir = $(exec_prefix)/bin
libdir = $(exec_prefix)/lib

datadir = $(datarootdir)
schemedir = $(datarootdir)/guile/site

docdir = $(datarootdir)/doc/$(package_name)
htmldir = $(docdir)
dvidir = $(docdir)

GUILE_CFLAGS = `guile-config compile`
GUILE_LDFLAGS = `guile-config link`
GUILE_SITE = `guile-config info pkgdatadir`/site


### Flags ###

CDEBUG = -g
CTEST = -fprofile-arcs -ftest-coverage
CFLAGS = $(CDEBUG) -I$(srcdir) `guile-config compile` \
	-Wall -Wextra -DDLL_EXPORT
LIB_LIBS = `guile-config link` -lncurses -ltdl

LIB_SRCS = \
	addch.c \
	addchstr.c \
	addstr.c \
	attr.c \
	beep.c \
	color.c \
	core.c \
	default_colors.c \
	getch.c \
	initscr.c \
	inopts.c \
	kernel.c \
	move.c \
	refresh.c \
	termattrs.c \
	type_window.c \
	type_screen.c

LIB_OBJS = \
	addch.o \
	addchstr.o \
	addstr.o \
	attr.o \
	beep.o \
	color.o \
	core.o \
	default_colors.o \
	getch.o \
	initscr.o \
	inopts.o \
	kernel.o \
	move.o \
	refresh.o \
	termattrs.o \
	type_window.o \
	type_screen.o

## Targets ##

all : libguile-ncurses.a cygguile-ncurses-0-0.dll config.scm

libguile-ncurses.a : $(LIB_OBJS)
	$(AR) cru $@ $(LIB_OBJS)
	ranlib $@

cygguile-ncurses-0-0.dll: libguile-ncurses.a
	gcc $(CFLAGS) -fPIC -shared -o $@ \
	-Wl,-rpath /usr/local/lib \
	-Wl,--out-implib=libguile-ncurses.dll.a \
	-Wl,--whole-archive $< \
	-Wl,--no-whole-archive $(GUILE_LDFLAGS) -lncurses


%.o : %.c
	gcc -c $(CFLAGS) $(CTEST) $< -o $@

# Generated sources
$(OBJS): config.scm

config.scm : $(srcdir)/src/config.scm.in
	sed 's|XXlibdirXX|$(libdir)|' < $< > $@.tmp
	sed 's|XXcorelibXX|cygguile-ncurses-0-0.dll|' < $@.tmp > $@
	rm $@.tmp

install: all
	mkdir -p $(schemedir)/ncurses
	mkdir -p $(schemedir)/ncurses/core
	install $(srcdir)/src/core.scm $(schemedir)/ncurses/core.scm
	install $(srcdir)/src/termattrs.scm $(schemedir)/ncurses/core/termattrs.scm
	install $(srcdir)/src/beep.scm $(schemedir)/ncurses/core/beep.scm
	install config.scm $(schemedir)/ncurses/config.scm
	install cygguile-ncurses-0-0.dll $(libdir)

install-html:
install-dvi:
install-pdf:
install-ps:

uninstall:

install-strip:

clean:
	rm -f *.o libguile-ncurses.a libguile-ncurses.so config.scm

distclean: clean
	rm -f TAGS

TAGS: $(SRCS) config.scm.in
	etags -R
	etags --append --language-force=scheme config.scm.in

info: guile-ncurses.info

guile-ncurses.info: curs_initscr.texi guile-ncurses.texi
	makeinfo guile-ncurses.texi

dvi:
html:
pdf:
ps:


curs_initscr.texi: curs_initscr.c
	./strip.awk $< > $@


dist:

check:

installcheck:
installdirs:
